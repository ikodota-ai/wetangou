<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.StoreMapper">
    
    <resultMap type="Store" id="StoreResult">
        <result property="storeId"    column="store_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="storeName"    column="store_name"    />
        <result property="logo"    column="logo"    />
        <result property="province"    column="province"    />
        <result property="city"    column="city"    />
        <result property="district"    column="district"    />
        <result property="address"    column="address"    />
        <result property="longitude"    column="longitude"    />
        <result property="latitude"    column="latitude"    />
        <result property="phone"    column="phone"    />
        <result property="servicePhone"    column="service_phone"    />
        <result property="serviceQrcode"    column="service_qrcode"    />
        <result property="businessHours"    column="business_hours"    />
        <result property="serviceHours"    column="service_hours"    />
        <result property="intro"    column="intro"    />
        <result property="services"    column="services"    />
        <result property="billAutoConfirm"    column="bill_auto_confirm"    />
        <result property="rating"             column="rating"               />
        <result property="bookingAheadDays"   column="booking_ahead_days"   />
        <result property="bookingSlotMinutes" column="booking_slot_minutes" />
        <result property="bookingClosedDays"  column="booking_closed_days"  />
        <result property="sort"    column="sort"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="distance"    column="distance"    />
    </resultMap>

    <sql id="selectStoreVo">
        select store_id, store_name, logo, province, city, district, address, longitude, latitude, phone, service_phone, service_qrcode, business_hours, service_hours, intro, services, bill_auto_confirm, rating, booking_ahead_days, booking_slot_minutes, booking_closed_days, sort, status, del_flag, create_by, create_time, update_by, update_time, remark, merchant_id from biz_store
    </sql>

    <select id="selectStoreList" parameterType="Store" resultMap="StoreResult">
        <include refid="selectStoreVo"/>
        <where>
            <if test="merchantId != null ">
            <if test="params != null and params.merchantIdsIn != null">
                <choose>
                    <when test="params.merchantIdsIn instanceof java.util.List">
                        <if test="params.merchantIdsIn.size() > 0"> and merchant_id in
                            <foreach collection="params.merchantIdsIn" item="mid" open="(" close=")" separator=",">#{mid}</foreach>
                        </if>
                        <if test="params.merchantIdsIn.size() == 0"> and 1=0 </if>
                    </when>
                    <otherwise> and merchant_id = #{params.merchantIdsIn}</otherwise>
                </choose>
            </if>
 and merchant_id = #{merchantId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="delFlag != null  and delFlag != ''"> and del_flag = #{delFlag}</if>
            <if test="storeName != null  and storeName != ''"> and store_name like concat('%', #{storeName}, '%')</if>
            <if test="logo != null  and logo != ''"> and logo = #{logo}</if>
            <if test="province != null  and province != ''"> and province = #{province}</if>
            <if test="city != null  and city != ''"> and city = #{city}</if>
            <if test="district != null  and district != ''"> and district = #{district}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="longitude != null "> and longitude = #{longitude}</if>
            <if test="latitude != null "> and latitude = #{latitude}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="servicePhone != null  and servicePhone != ''"> and service_phone = #{servicePhone}</if>
            <if test="serviceQrcode != null  and serviceQrcode != ''"> and service_qrcode = #{serviceQrcode}</if>
            <if test="businessHours != null  and businessHours != ''"> and business_hours = #{businessHours}</if>
            <if test="intro != null  and intro != ''"> and intro = #{intro}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by sort asc, store_id desc
    </select>
    
    <select id="selectStoreByStoreId" parameterType="Long" resultMap="StoreResult">
        <include refid="selectStoreVo"/>
        where store_id = #{storeId}
    </select>

    <insert id="insertStore" parameterType="Store" useGeneratedKeys="true" keyProperty="storeId">
        insert into biz_store
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="storeName != null and storeName != ''">store_name,</if>
            <if test="logo != null">logo,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="district != null">district,</if>
            <if test="address != null">address,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="phone != null">phone,</if>
            <if test="servicePhone != null">service_phone,</if>
            <if test="serviceQrcode != null">service_qrcode,</if>
            <if test="businessHours != null">business_hours,</if>
            <if test="serviceHours != null">service_hours,</if>
            <if test="intro != null">intro,</if>
            <if test="services != null">services,</if>
            <if test="billAutoConfirm != null">bill_auto_confirm,</if>
            <if test="rating != null">rating,</if>
            <if test="bookingAheadDays != null">booking_ahead_days,</if>
            <if test="bookingSlotMinutes != null">booking_slot_minutes,</if>
            <if test="bookingClosedDays != null">booking_closed_days,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="storeName != null and storeName != ''">#{storeName},</if>
            <if test="logo != null">#{logo},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="district != null">#{district},</if>
            <if test="address != null">#{address},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="phone != null">#{phone},</if>
            <if test="servicePhone != null">#{servicePhone},</if>
            <if test="serviceQrcode != null">#{serviceQrcode},</if>
            <if test="businessHours != null">#{businessHours},</if>
            <if test="serviceHours != null">#{serviceHours},</if>
            <if test="intro != null">#{intro},</if>
            <if test="services != null">#{services},</if>
            <if test="billAutoConfirm != null">#{billAutoConfirm},</if>
            <if test="rating != null">#{rating},</if>
            <if test="bookingAheadDays != null">#{bookingAheadDays},</if>
            <if test="bookingSlotMinutes != null">#{bookingSlotMinutes},</if>
            <if test="bookingClosedDays != null">#{bookingClosedDays},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateStore" parameterType="Store">
        update biz_store
        <trim prefix="SET" suffixOverrides=",">
            <if test="storeName != null and storeName != ''">store_name = #{storeName},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
            <if test="address != null">address = #{address},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="servicePhone != null">service_phone = #{servicePhone},</if>
            <if test="serviceQrcode != null">service_qrcode = #{serviceQrcode},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="serviceHours != null">service_hours = #{serviceHours},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="services != null">services = #{services},</if>
            <if test="billAutoConfirm != null">bill_auto_confirm = #{billAutoConfirm},</if>
            <if test="rating != null">rating = #{rating},</if>
            <if test="bookingAheadDays != null">booking_ahead_days = #{bookingAheadDays},</if>
            <if test="bookingSlotMinutes != null">booking_slot_minutes = #{bookingSlotMinutes},</if>
            <!-- 歇业日允许清空成「每天可约」，所以判 != null 而不是 isNotEmpty，
                 空串要能存进去覆盖旧值 -->
            <if test="bookingClosedDays != null">booking_closed_days = #{bookingClosedDays},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where store_id = #{storeId}
    </update>

    <delete id="deleteStoreByStoreId" parameterType="Long">
        delete from biz_store where store_id = #{storeId}
    </delete>

    <delete id="deleteStoreByStoreIds" parameterType="String">
        delete from biz_store where store_id in 
        <foreach item="storeId" collection="array" open="(" separator="," close=")">
            #{storeId}
        </foreach>
    </delete>
    <!--
        按经纬度查询最近的 N 个门店
        使用 Haversine 公式（球面距离，单位：米），结果按距离升序
        tenant 过滤由 TenantSqlInterceptor 自动追加 merchant_id = ?，无需写死
    -->
    <select id="selectNearestStoreList" resultMap="StoreResult">
        SELECT
            s.store_id, s.store_name, s.logo, s.province, s.city, s.district, s.address,
            s.longitude, s.latitude, s.phone, s.service_phone, s.service_qrcode,
            s.business_hours, s.service_hours, s.intro, s.services, s.bill_auto_confirm, s.rating,
            s.booking_ahead_days, s.booking_slot_minutes, s.booking_closed_days, s.sort, s.status, s.del_flag,
            s.create_by, s.create_time, s.update_by, s.update_time, s.remark, s.merchant_id,
            (
                6371000 * ACOS(
                    COS(RADIANS(#{latitude})) * COS(RADIANS(s.latitude)) *
                    COS(RADIANS(s.longitude) - RADIANS(#{longitude})) +
                    SIN(RADIANS(#{latitude})) * SIN(RADIANS(s.latitude))
                )
            ) AS distance
        FROM biz_store s
        WHERE s.status = '0' AND s.del_flag = '0'
          AND s.longitude IS NOT NULL AND s.latitude IS NOT NULL
        ORDER BY distance ASC
        LIMIT #{limit}
    </select>
</mapper>
