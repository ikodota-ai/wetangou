<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.ProductStoreMapper">
    
    <resultMap type="ProductStore" id="ProductStoreResult">
        <result property="id"    column="id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="productId"    column="product_id"    />
        <result property="storeId"    column="store_id"    />
        <result property="price"    column="price"    />
        <result property="stock"    column="stock"    />
        <result property="onSale"    column="on_sale"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectProductStoreVo">
        select id, product_id, store_id, price, stock, on_sale, create_time, merchant_id from biz_product_store
    </sql>

    <select id="selectProductStoreList" parameterType="ProductStore" resultMap="ProductStoreResult">
        <include refid="selectProductStoreVo"/>
        <where>  
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="storeId != null "> and store_id = #{storeId}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="stock != null "> and stock = #{stock}</if>
            <if test="onSale != null  and onSale != ''"> and on_sale = #{onSale}</if>
        </where>
    </select>
    
    <select id="selectProductStoreById" parameterType="Long" resultMap="ProductStoreResult">
        <include refid="selectProductStoreVo"/>
        where id = #{id}
    </select>

    <insert id="insertProductStore" parameterType="ProductStore" useGeneratedKeys="true" keyProperty="id">
        insert into biz_product_store
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="price != null">price,</if>
            <if test="stock != null">stock,</if>
            <if test="onSale != null">on_sale,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="price != null">#{price},</if>
            <if test="stock != null">#{stock},</if>
            <if test="onSale != null">#{onSale},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateProductStore" parameterType="ProductStore">
        update biz_product_store
        <trim prefix="SET" suffixOverrides=",">
            <if test="productId != null">product_id = #{productId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="onSale != null">on_sale = #{onSale},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProductStoreById" parameterType="Long">
        delete from biz_product_store where id = #{id}
    </delete>

    <delete id="deleteProductStoreByIds" parameterType="String">
        delete from biz_product_store where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>