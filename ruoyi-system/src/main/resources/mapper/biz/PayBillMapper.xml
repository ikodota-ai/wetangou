<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.PayBillMapper">
    
    <resultMap type="PayBill" id="PayBillResult">
        <result property="billId"    column="bill_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="billNo"    column="bill_no"    />
        <result property="orderId"    column="order_id"    />
        <result property="storeId"    column="store_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="storeName"    column="store_name"    />
        <result property="memberName"    column="member_name"    />
        <result property="amount"    column="amount"    />
        <result property="memberVoucherId"    column="member_voucher_id"    />
        <result property="discountAmount"    column="discount_amount"    />
        <result property="payAmount"    column="pay_amount"    />
        <result property="confirmUser"    column="confirm_user"    />
        <result property="confirmTime"    column="confirm_time"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectPayBillVo">
        select b.bill_id, b.bill_no, b.order_id, b.store_id, s.store_name, b.member_id, m.nickname as member_name,
               b.amount, b.member_voucher_id, b.discount_amount, b.pay_amount, b.confirm_user, b.confirm_time,
               b.status, b.create_time, b.update_time, b.merchant_id
        from biz_pay_bill b
        left join biz_store s on s.store_id = b.store_id
        left join biz_member m on m.member_id = b.member_id
    </sql>

    <!-- 券占用统计：只算未失效状态（0 待确认 / 1 待支付 / 2 已完成）。
         已取消(3)不占券，否则用户取消买单后手里的券就废了。 -->
    <select id="countVoucherHeldBills" resultType="int">
        select count(1) from biz_pay_bill
        where member_voucher_id = #{memberVoucherId}
          and status in ('0', '1', '2')
        <if test="excludeBillId != null"> and bill_id != #{excludeBillId}</if>
    </select>

    <select id="selectPayBillByBillNo" parameterType="String" resultMap="PayBillResult">
        <include refid="selectPayBillVo"/>
        where b.bill_no = #{billNo}
    </select>

    <select id="selectPayBillList" parameterType="PayBill" resultMap="PayBillResult">
        <include refid="selectPayBillVo"/>
        <where>
            <if test="params != null and params.merchantIdsIn != null">
                <choose>
                    <when test="params.merchantIdsIn instanceof java.util.List">
                        <if test="params.merchantIdsIn.size() > 0"> and b.merchant_id in
                            <foreach collection="params.merchantIdsIn" item="mid" open="(" close=")" separator=",">#{mid}</foreach>
                        </if>
                        <if test="params.merchantIdsIn.size() == 0"> and 1=0 </if>
                    </when>
                    <otherwise> and b.merchant_id = #{params.merchantIdsIn}</otherwise>
                </choose>
            </if>
            <if test="merchantId != null "> and b.merchant_id = #{merchantId}</if>
            <if test="billNo != null  and billNo != ''"> and b.bill_no like concat('%', #{billNo}, '%')</if>
            <if test="orderId != null "> and b.order_id = #{orderId}</if>
            <if test="storeId != null "> and b.store_id = #{storeId}</if>
            <if test="memberId != null "> and b.member_id = #{memberId}</if>
            <if test="status != null  and status != ''"> and b.status = #{status}</if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''"> and find_in_set(b.store_id, #{params.storeIds})</if>
            <if test="params != null and params.memberIds != null and params.memberIds != ''"> and find_in_set(b.member_id, #{params.memberIds})</if>
        </where>
        order by b.bill_id desc
    </select>
    
    <select id="selectPayBillByBillId" parameterType="Long" resultMap="PayBillResult">
        <include refid="selectPayBillVo"/>
        where b.bill_id = #{billId}
    </select>

    <insert id="insertPayBill" parameterType="PayBill" useGeneratedKeys="true" keyProperty="billId">
        insert into biz_pay_bill
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="billNo != null and billNo != ''">bill_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="amount != null">amount,</if>
            <if test="memberVoucherId != null">member_voucher_id,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="confirmUser != null">confirm_user,</if>
            <if test="confirmTime != null">confirm_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="billNo != null and billNo != ''">#{billNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="memberVoucherId != null">#{memberVoucherId},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="confirmUser != null">#{confirmUser},</if>
            <if test="confirmTime != null">#{confirmTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updatePayBill" parameterType="PayBill">
        update biz_pay_bill
        <trim prefix="SET" suffixOverrides=",">
            <if test="billNo != null and billNo != ''">bill_no = #{billNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="memberVoucherId != null">member_voucher_id = #{memberVoucherId},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="confirmUser != null">confirm_user = #{confirmUser},</if>
            <if test="confirmTime != null">confirm_time = #{confirmTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where bill_id = #{billId}
    </update>

    <!-- 取消买单时把券引用清掉：updatePayBill 的 <if test="memberVoucherId != null">
         会跳过 null，置空必须走这条显式 update（与 OrderMapper.clearVoucher 同理）。 -->
    <update id="clearVoucher">
        update biz_pay_bill set member_voucher_id = null, update_time = sysdate()
        where bill_id = #{billId}
    </update>

    <delete id="deletePayBillByBillId" parameterType="Long">
        delete from biz_pay_bill where bill_id = #{billId}
    </delete>

    <delete id="deletePayBillByBillIds" parameterType="String">
        delete from biz_pay_bill where bill_id in 
        <foreach item="billId" collection="array" open="(" separator="," close=")">
            #{billId}
        </foreach>
    </delete>
</mapper>