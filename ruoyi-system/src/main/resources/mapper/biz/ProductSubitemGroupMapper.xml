<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.ProductSubitemGroupMapper">

    <resultMap type="ProductSubitemGroup" id="GroupResult">
        <result property="groupId"    column="group_id"    />
        <result property="productId"  column="product_id"  />
        <result property="groupName"  column="group_name"  />
        <result property="pickRule"   column="pick_rule"   />
        <result property="sort"       column="sort"        />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectVo">
        select group_id, product_id, group_name, pick_rule, sort, create_time
        from biz_product_subitem_group
    </sql>

    <select id="selectById" resultMap="GroupResult">
        <include refid="selectVo"/>
        where group_id = #{groupId}
    </select>

    <select id="selectByProductId" resultMap="GroupResult">
        <include refid="selectVo"/>
        where product_id = #{productId}
        order by sort asc, group_id asc
    </select>

    <insert id="insert" parameterType="ProductSubitemGroup" useGeneratedKeys="true" keyProperty="groupId">
        insert into biz_product_subitem_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productId != null">product_id,</if>
            <if test="groupName != null">group_name,</if>
            <if test="pickRule != null">pick_rule,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productId != null">#{productId},</if>
            <if test="groupName != null">#{groupName},</if>
            <if test="pickRule != null">#{pickRule},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="update" parameterType="ProductSubitemGroup">
        update biz_product_subitem_group
        <set>
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="pickRule != null">pick_rule = #{pickRule},</if>
            <if test="sort != null">sort = #{sort},</if>
        </set>
        where group_id = #{groupId}
    </update>

    <delete id="deleteById">
        delete from biz_product_subitem_group where group_id = #{groupId}
    </delete>

    <delete id="deleteByProductId">
        delete from biz_product_subitem_group where product_id = #{productId}
    </delete>
</mapper>
