<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.DistributorMapper">
    
    <resultMap type="Distributor" id="DistributorResult">
        <result property="distributorId"    column="distributor_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="memberName"    column="member_name"    />
        <result property="level"    column="level"    />
        <result property="totalCommission"    column="total_commission"    />
        <result property="availableAmount"    column="available_amount"    />
        <result property="frozenAmount"    column="frozen_amount"    />
        <result property="withdrawAmount"    column="withdraw_amount"    />
        <result property="status"    column="status"    />
        <result property="joinTime"    column="join_time"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDistributorVo">
        select d.distributor_id, d.member_id, m.nickname as member_name, d.level, d.total_commission,
               d.available_amount, d.frozen_amount, d.withdraw_amount, d.status, d.join_time, d.create_time, d.update_time, d.merchant_id
        from biz_distributor d
        left join biz_member m on m.member_id = d.member_id
    </sql>

    <select id="selectDistributorList" parameterType="Distributor" resultMap="DistributorResult">
        <include refid="selectDistributorVo"/>
        <where>
            <if test="memberId != null "> and d.member_id = #{memberId}</if>
            <if test="level != null "> and d.level = #{level}</if>
            <if test="status != null  and status != ''"> and d.status = #{status}</if>
            <if test="params != null and params.memberIds != null and params.memberIds != ''"> and find_in_set(d.member_id, #{params.memberIds})</if>
        </where>
        order by d.distributor_id desc
    </select>
    
    <select id="selectDistributorByDistributorId" parameterType="Long" resultMap="DistributorResult">
        <include refid="selectDistributorVo"/>
        where d.distributor_id = #{distributorId}
    </select>

    <insert id="insertDistributor" parameterType="Distributor" useGeneratedKeys="true" keyProperty="distributorId">
        insert into biz_distributor
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="level != null">level,</if>
            <if test="totalCommission != null">total_commission,</if>
            <if test="availableAmount != null">available_amount,</if>
            <if test="frozenAmount != null">frozen_amount,</if>
            <if test="withdrawAmount != null">withdraw_amount,</if>
            <if test="status != null">status,</if>
            <if test="joinTime != null">join_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="level != null">#{level},</if>
            <if test="totalCommission != null">#{totalCommission},</if>
            <if test="availableAmount != null">#{availableAmount},</if>
            <if test="frozenAmount != null">#{frozenAmount},</if>
            <if test="withdrawAmount != null">#{withdrawAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="joinTime != null">#{joinTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDistributor" parameterType="Distributor">
        update biz_distributor
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="level != null">level = #{level},</if>
            <if test="totalCommission != null">total_commission = #{totalCommission},</if>
            <if test="availableAmount != null">available_amount = #{availableAmount},</if>
            <if test="frozenAmount != null">frozen_amount = #{frozenAmount},</if>
            <if test="withdrawAmount != null">withdraw_amount = #{withdrawAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="joinTime != null">join_time = #{joinTime},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where distributor_id = #{distributorId}
    </update>

    <delete id="deleteDistributorByDistributorId" parameterType="Long">
        delete from biz_distributor where distributor_id = #{distributorId}
    </delete>

    <delete id="deleteDistributorByDistributorIds" parameterType="String">
        delete from biz_distributor where distributor_id in 
        <foreach item="distributorId" collection="array" open="(" separator="," close=")">
            #{distributorId}
        </foreach>
    </delete>
</mapper>