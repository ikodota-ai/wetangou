<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.CategoryMapper">

    <resultMap type="Category" id="CategoryResult">
        <result property="categoryId"    column="category_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="parentId"      column="parent_id"      />
        <result property="fullPath"      column="full_path"      />
        <result property="level"         column="level"          />
        <result property="industryCode"  column="industry_code"  />
        <result property="depositAmount" column="deposit_amount" />
        <result property="allowedTypes"  column="allowed_types"  />
        <result property="licenseRequired" column="license_required" />
        <result property="complianceNotice" column="compliance_notice" />
        <result property="storeId"       column="store_id"       />
        <result property="storeName"     column="store_name"     />
        <result property="categoryName"  column="category_name"  />
        <result property="icon"          column="icon"           />
        <result property="sort"          column="sort"           />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCategoryVo">
        select c.category_id, c.merchant_id, c.parent_id, c.full_path, c.level,
               c.industry_code, c.deposit_amount, c.allowed_types,
               c.license_required, c.compliance_notice,
               c.store_id, c.category_name, c.icon, c.sort, c.status,
               c.create_by, c.create_time, c.update_by, c.update_time
        from biz_product_category c
        left join biz_store s on s.store_id = c.store_id
    </sql>

    <select id="selectCategoryList" parameterType="Category" resultMap="CategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            <if test="merchantId != null "> and c.merchant_id = #{merchantId}</if>
            <if test="storeId != null "> and c.store_id = #{storeId}</if>
            <if test="parentId != null "> and c.parent_id = #{parentId}</if>
            <if test="industryCode != null  and industryCode != ''"> and c.industry_code = #{industryCode}</if>
            <if test="categoryName != null  and categoryName != ''"> and c.category_name like concat('%', #{categoryName}, '%')</if>
            <if test="status != null  and status != ''"> and c.status = #{status}</if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''"> and find_in_set(c.store_id, #{params.storeIds})</if>
        </where>
        order by c.level asc, c.sort asc, c.category_id asc
    </select>

    <select id="selectCategoryByCategoryId" parameterType="Long" resultMap="CategoryResult">
        <include refid="selectCategoryVo"/>
        where c.category_id = #{categoryId}
    </select>

    <insert id="insertCategory" parameterType="Category" useGeneratedKeys="true" keyProperty="categoryId">
        insert into biz_product_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="fullPath != null">full_path,</if>
            <if test="level != null">level,</if>
            <if test="industryCode != null">industry_code,</if>
            <if test="depositAmount != null">deposit_amount,</if>
            <if test="allowedTypes != null">allowed_types,</if>
            <if test="licenseRequired != null">license_required,</if>
            <if test="complianceNotice != null">compliance_notice,</if>
            <if test="storeId != null">store_id,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="icon != null">icon,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="fullPath != null">#{fullPath},</if>
            <if test="level != null">#{level},</if>
            <if test="industryCode != null">#{industryCode},</if>
            <if test="depositAmount != null">#{depositAmount},</if>
            <if test="allowedTypes != null">#{allowedTypes},</if>
            <if test="licenseRequired != null">#{licenseRequired},</if>
            <if test="complianceNotice != null">#{complianceNotice},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="icon != null">#{icon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCategory" parameterType="Category">
        update biz_product_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="fullPath != null">full_path = #{fullPath},</if>
            <if test="level != null">level = #{level},</if>
            <if test="industryCode != null">industry_code = #{industryCode},</if>
            <if test="depositAmount != null">deposit_amount = #{depositAmount},</if>
            <if test="allowedTypes != null">allowed_types = #{allowedTypes},</if>
            <if test="licenseRequired != null">license_required = #{licenseRequired},</if>
            <if test="complianceNotice != null">compliance_notice = #{complianceNotice},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteCategoryByCategoryId" parameterType="Long">
        delete from biz_product_category where category_id = #{categoryId}
    </delete>

    <delete id="deleteCategoryByCategoryIds" parameterType="String">
        delete from biz_product_category where category_id in
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
</mapper>
