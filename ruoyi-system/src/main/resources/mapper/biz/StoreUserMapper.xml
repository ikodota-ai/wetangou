<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.StoreUserMapper">
    
    <resultMap type="StoreUser" id="StoreUserResult">
        <result property="id"    column="id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="storeId"    column="store_id"    />
        <result property="userId"    column="user_id"    />
        <result property="storeName"    column="store_name"    />
        <result property="userName"    column="user_name"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectStoreUserVo">
        select su.id, su.store_id, s.store_name, su.user_id, u.user_name, su.create_time, su.merchant_id
        from biz_store_user su
        left join biz_store s on s.store_id = su.store_id
        left join sys_user u on u.user_id = su.user_id
    </sql>

    <select id="selectStoreUserList" parameterType="StoreUser" resultMap="StoreUserResult">
        <include refid="selectStoreUserVo"/>
        <where>
            <if test="storeId != null "> and su.store_id = #{storeId}</if>
            <if test="userId != null "> and su.user_id = #{userId}</if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''"> and find_in_set(su.store_id, #{params.storeIds})</if>
        </where>
        order by su.id desc
    </select>
    
    <select id="selectStoreUserById" parameterType="Long" resultMap="StoreUserResult">
        <include refid="selectStoreUserVo"/>
        where su.id = #{id}
    </select>

    <insert id="insertStoreUser" parameterType="StoreUser" useGeneratedKeys="true" keyProperty="id">
        insert into biz_store_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateStoreUser" parameterType="StoreUser">
        update biz_store_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStoreUserById" parameterType="Long">
        delete from biz_store_user where id = #{id}
    </delete>

    <delete id="deleteStoreUserByIds" parameterType="String">
        delete from biz_store_user where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>