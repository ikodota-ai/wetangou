<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.MpReleaseMapper">

    <resultMap type="MpRelease" id="MpReleaseResult">
        <result property="releaseId"    column="release_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="merchantName"    column="merchant_name"    />
        <result property="appid"    column="appid"    />
        <result property="templateId"    column="template_id"    />
        <result property="userVersion"    column="user_version"    />
        <result property="userDesc"    column="user_desc"    />
        <result property="extJson"    column="ext_json"    />
        <result property="auditId"    column="audit_id"    />
        <result property="auditStatus"    column="audit_status"    />
        <result property="auditReason"    column="audit_reason"    />
        <result property="releaseStatus"    column="release_status"    />
        <result property="releaseTime"    column="release_time"    />
        <result property="qrcodeUrl"    column="qrcode_url"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMpReleaseVo">
        select r.release_id, r.merchant_id, m.merchant_name, r.appid, r.template_id, r.user_version,
               r.user_desc, r.ext_json, r.audit_id, r.audit_status, r.audit_reason, r.release_status,
               r.release_time, r.qrcode_url, r.create_by, r.create_time, r.update_by, r.update_time, r.remark
        from biz_mp_release r
        left join biz_merchant m on m.merchant_id = r.merchant_id
    </sql>

    <select id="selectMpReleaseList" parameterType="MpRelease" resultMap="MpReleaseResult">
        <include refid="selectMpReleaseVo"/>
        <where>
            <if test="merchantId != null "> and r.merchant_id = #{merchantId}</if>
            <if test="merchantName != null  and merchantName != ''"> and m.merchant_name like concat('%', #{merchantName}, '%')</if>
            <if test="appid != null  and appid != ''"> and r.appid like concat('%', #{appid}, '%')</if>
            <if test="userVersion != null  and userVersion != ''"> and r.user_version like concat('%', #{userVersion}, '%')</if>
            <if test="auditStatus != null  and auditStatus != ''"> and r.audit_status = #{auditStatus}</if>
            <if test="releaseStatus != null  and releaseStatus != ''"> and r.release_status = #{releaseStatus}</if>
            <if test="params.merchantIds != null and params.merchantIds != ''"> and find_in_set(r.merchant_id, #{params.merchantIds})</if>
        </where>
        order by r.release_id desc
    </select>

    <select id="selectMpReleaseByReleaseId" parameterType="Long" resultMap="MpReleaseResult">
        <include refid="selectMpReleaseVo"/>
        where r.release_id = #{releaseId}
    </select>

    <insert id="insertMpRelease" parameterType="MpRelease" useGeneratedKeys="true" keyProperty="releaseId">
        insert into biz_mp_release
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="appid != null and appid != ''">appid,</if>
            <if test="templateId != null">template_id,</if>
            <if test="userVersion != null">user_version,</if>
            <if test="userDesc != null">user_desc,</if>
            <if test="extJson != null">ext_json,</if>
            <if test="auditId != null">audit_id,</if>
            <if test="auditStatus != null">audit_status,</if>
            <if test="auditReason != null">audit_reason,</if>
            <if test="releaseStatus != null">release_status,</if>
            <if test="releaseTime != null">release_time,</if>
            <if test="qrcodeUrl != null">qrcode_url,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="appid != null and appid != ''">#{appid},</if>
            <if test="templateId != null">#{templateId},</if>
            <if test="userVersion != null">#{userVersion},</if>
            <if test="userDesc != null">#{userDesc},</if>
            <if test="extJson != null">#{extJson},</if>
            <if test="auditId != null">#{auditId},</if>
            <if test="auditStatus != null">#{auditStatus},</if>
            <if test="auditReason != null">#{auditReason},</if>
            <if test="releaseStatus != null">#{releaseStatus},</if>
            <if test="releaseTime != null">#{releaseTime},</if>
            <if test="qrcodeUrl != null">#{qrcodeUrl},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateMpRelease" parameterType="MpRelease">
        update biz_mp_release
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="userVersion != null">user_version = #{userVersion},</if>
            <if test="userDesc != null">user_desc = #{userDesc},</if>
            <if test="extJson != null">ext_json = #{extJson},</if>
            <if test="auditId != null">audit_id = #{auditId},</if>
            <if test="auditStatus != null">audit_status = #{auditStatus},</if>
            <if test="auditReason != null">audit_reason = #{auditReason},</if>
            <if test="releaseStatus != null">release_status = #{releaseStatus},</if>
            <if test="releaseTime != null">release_time = #{releaseTime},</if>
            <if test="qrcodeUrl != null">qrcode_url = #{qrcodeUrl},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate(),
        </trim>
        where release_id = #{releaseId}
    </update>

    <delete id="deleteMpReleaseByReleaseIds" parameterType="String">
        delete from biz_mp_release where release_id in
        <foreach item="releaseId" collection="array" open="(" separator="," close=")">
            #{releaseId}
        </foreach>
    </delete>

</mapper>
