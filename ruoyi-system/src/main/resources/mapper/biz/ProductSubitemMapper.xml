<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.ProductSubitemMapper">

    <resultMap type="ProductSubitem" id="SubitemResult">
        <result property="subitemId"   column="subitem_id"   />
        <result property="groupId"     column="group_id"     />
        <result property="subitemType" column="subitem_type" />
        <result property="productId"   column="product_id"   />
        <result property="subitemName" column="subitem_name" />
        <result property="quantity"    column="quantity"     />
        <result property="pickQuantity" column="pick_quantity" />
        <result property="totalValue"  column="total_value"  />
        <result property="price"       column="price"        />
        <result property="sort"        column="sort"         />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectVo">
        select subitem_id, group_id, subitem_type, product_id, subitem_name, quantity, pick_quantity, total_value, price, sort, create_time
        from biz_product_subitem
    </sql>

    <select id="selectById" resultMap="SubitemResult">
        <include refid="selectVo"/>
        where subitem_id = #{subitemId}
    </select>

    <select id="selectByGroupId" resultMap="SubitemResult">
        <include refid="selectVo"/>
        where group_id = #{groupId}
        order by sort asc, subitem_id asc
    </select>

    <select id="selectByProductId" resultMap="SubitemResult">
        <include refid="selectVo"/>
        where product_id = #{productId}
        order by sort asc, subitem_id asc
    </select>

    <!-- 列表专用 resultMap：继承基础映射并补 join 出来的冗余展示列 -->
    <resultMap type="ProductSubitem" id="SubitemListResult" extends="SubitemResult">
        <result property="productName" column="product_name" />
        <result property="groupName"   column="group_name"   />
        <result property="pickRule"    column="pick_rule"    />
    </resultMap>

    <!-- 分页列表：join 商品名 / 组名，支持按商品名、子品名、商户过滤 -->
    <select id="selectSubitemList" parameterType="ProductSubitem" resultMap="SubitemListResult">
        select s.subitem_id, s.group_id, s.subitem_type, s.product_id, s.subitem_name,
               s.quantity, s.pick_quantity, s.total_value, s.price, s.sort, s.create_time,
               p.product_name as product_name, g.group_name as group_name, g.pick_rule as pick_rule
        from biz_product_subitem s
        left join biz_product p on p.product_id = s.product_id
        left join biz_product_subitem_group g on g.group_id = s.group_id
        <where>
            <if test="productId != null"> and s.product_id = #{productId}</if>
            <if test="groupId != null"> and s.group_id = #{groupId}</if>
            <if test="subitemName != null and subitemName != ''">
                and s.subitem_name like concat('%', #{subitemName}, '%')
            </if>
            <if test="productName != null and productName != ''">
                and p.product_name like concat('%', #{productName}, '%')
            </if>
            <if test="params != null and params.merchantIdsIn != null">
                <choose>
                    <when test="params.merchantIdsIn instanceof java.util.List">
                        <if test="params.merchantIdsIn.size() &gt; 0"> and p.merchant_id in
                            <foreach collection="params.merchantIdsIn" item="mid" open="(" close=")" separator=",">#{mid}</foreach>
                        </if>
                        <if test="params.merchantIdsIn.size() == 0"> and 1=0 </if>
                    </when>
                    <otherwise> and p.merchant_id = #{params.merchantIdsIn}</otherwise>
                </choose>
            </if>
        </where>
        order by s.product_id desc, s.group_id asc, s.sort asc, s.subitem_id asc
    </select>

    <!-- 历史子品名称候选（去重），join biz_product 以便按商户隔离 -->
    <select id="selectNameCandidates" resultType="java.lang.String">
        select distinct s.subitem_name
        from biz_product_subitem s
        left join biz_product p on p.product_id = s.product_id
        <where>
            s.subitem_name is not null and s.subitem_name != ''
            <if test="merchantId != null"> and p.merchant_id = #{merchantId}</if>
            <if test="keyword != null and keyword != ''">
                and s.subitem_name like concat('%', #{keyword}, '%')
            </if>
        </where>
        order by s.subitem_name asc
        limit 200
    </select>

    <insert id="insert" parameterType="ProductSubitem" useGeneratedKeys="true" keyProperty="subitemId">
        insert into biz_product_subitem
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupId != null">group_id,</if>
            <if test="subitemType != null">subitem_type,</if>
            <if test="productId != null">product_id,</if>
            <if test="subitemName != null">subitem_name,</if>
            <if test="quantity != null">quantity,</if>
            <if test="pickQuantity != null">pick_quantity,</if>
            <if test="totalValue != null">total_value,</if>
            <if test="price != null">price,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="groupId != null">#{groupId},</if>
            <if test="subitemType != null">#{subitemType},</if>
            <if test="productId != null">#{productId},</if>
            <if test="subitemName != null">#{subitemName},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="pickQuantity != null">#{pickQuantity},</if>
            <if test="totalValue != null">#{totalValue},</if>
            <if test="price != null">#{price},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="update" parameterType="ProductSubitem">
        update biz_product_subitem
        <set>
            <if test="subitemName != null">subitem_name = #{subitemName},</if>
            <if test="subitemType != null">subitem_type = #{subitemType},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="pickQuantity != null">pick_quantity = #{pickQuantity},</if>
            <if test="totalValue != null">total_value = #{totalValue},</if>
            <if test="price != null">price = #{price},</if>
            <if test="sort != null">sort = #{sort},</if>
        </set>
        where subitem_id = #{subitemId}
    </update>

    <delete id="deleteById">
        delete from biz_product_subitem where subitem_id = #{subitemId}
    </delete>

    <delete id="deleteByGroupId">
        delete from biz_product_subitem where group_id = #{groupId}
    </delete>

    <delete id="deleteByProductId">
        delete from biz_product_subitem where product_id = #{productId}
    </delete>
</mapper>
