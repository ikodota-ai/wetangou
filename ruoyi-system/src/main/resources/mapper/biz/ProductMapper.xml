    <sql id="selectProductVo">
        select p.product_id, p.merchant_id, p.store_id, p.store_ids, s.store_name, p.category_id, c.category_name,
               (select group_concat(s2.store_name separator '、') from biz_store s2 where find_in_set(s2.store_id, p.store_ids)) as store_names,
               p.product_name, p.subtitle,
               p.cover, p.images, p.product_type, p.price, p.market_price, p.stock, p.sales, p.validity_days,
               p.type_code, p.industry_code, p.face_value, p.min_consume, p.total_times, p.period_type, p.period_count,
               p.sale_start_date, p.sale_end_date, p.consume_start_days, p.consume_valid_days, p.consume_start_today,
               p.limit_per_user, p.max_per_order, p.max_persons, p.refund_policy,
               p.booking_required, p.booking_workday_only, p.collect_method,
               p.mutex_with_store_promotion, p.extra_fee_desc, p.other_notice,
               p.commission_rate, p.total_value, p.subitem_pick_rule, p.require_xiaoxin,
               p.detail, p.notice, p.sort, p.status, p.del_flag, p.create_by, p.create_time, p.update_by,
               p.update_time, p.remark,
               e.product_id           as ext_product_id,
               e.voucher_auto_name    as ext_voucher_auto_name,
               e.voucher_min_consume  as ext_voucher_min_consume,
               e.voucher_scope_type   as ext_voucher_scope_type,
               e.voucher_scope_ids    as ext_voucher_scope_ids,
               e.combo_total_value    as ext_combo_total_value,
               e.combo_sale_type      as ext_combo_sale_type,
               e.combo_auto_extend_days as ext_combo_auto_extend_days,
               e.outer_subitem_id     as ext_outer_subitem_id,
               e.combo_items_json     as ext_combo_items_json,
               e.groupon_pick_rule    as ext_groupon_pick_rule,
               e.groupon_actual_count as ext_groupon_actual_count,
               e.daily_use_limit      as ext_daily_use_limit,
               e.refund_rule_type     as ext_refund_rule_type
        from biz_product p
        left join biz_store s on s.store_id = p.store_id
        left join biz_product_category c on c.category_id = p.category_id
        left join biz_product_ext e on e.product_id = p.product_id
    </sql>

    <select id="selectProductList" parameterType="Product" resultMap="ProductResult">
        <include refid="selectProductVo"/>
        <where>
            <if test="merchantId != null ">
            <if test="params != null and params.merchantIdsIn != null">
                <choose>
                    <when test="params.merchantIdsIn instanceof java.util.List">
                        <if test="params.merchantIdsIn.size() > 0"> and p.merchant_id in
                            <foreach collection="params.merchantIdsIn" item="mid" open="(" close=")" separator=",">#{mid}</foreach>
                        </if>
                        <if test="params.merchantIdsIn.size() == 0"> and 1=0 </if>
                    </when>
                    <otherwise> and p.merchant_id = #{params.merchantIdsIn}</otherwise>
                </choose>
            </if>
 and p.merchant_id = #{merchantId}</if>
            <if test="storeId != null "> and (p.store_id = #{storeId} or find_in_set(#{storeId}, p.store_ids))</if>
            <if test="categoryId != null "> and p.category_id = #{categoryId}</if>
            <if test="productName != null  and productName != ''"> and p.product_name like concat('%', #{productName}, '%')</if>
            <if test="productType != null  and productType != ''"> and p.product_type = #{productType}</if>
            <if test="status != null  and status != ''"> and p.status = #{status}</if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''"> and find_in_set(p.store_id, #{params.storeIds})</if>
        </where>
        order by p.sort asc, p.product_id desc
    </select>
    
    <select id="selectProductByProductId" parameterType="Long" resultMap="ProductResult">
        <include refid="selectProductVo"/>
        where p.product_id = #{productId}
    </select>

