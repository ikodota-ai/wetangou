<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.OrderMapper">
    
    <resultMap type="Order" id="OrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="merchantId"    column="merchant_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="storeId"    column="store_id"    />
        <result property="memberId"    column="member_id"    />
        <result property="productId"    column="product_id"    />
        <result property="storeName"    column="store_name"    />
        <result property="memberName"    column="member_name"    />
        <result property="productName"    column="product_name"    />
        <result property="productCover"    column="product_cover"    />
        <result property="orderType"    column="order_type"    />
        <result property="price"    column="price"    />
        <result property="num"    column="num"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="discountAmount"    column="discount_amount"    />
        <result property="payAmount"    column="pay_amount"    />
        <result property="memberVoucherId"    column="member_voucher_id"    />
        <result property="distributorId"    column="distributor_id"    />
        <result property="status"    column="status"    />
        <result property="verifyCode"    column="verify_code"    />
        <result property="verifyTime"    column="verify_time"    />
        <result property="verifyUser"    column="verify_user"    />
        <result property="payTime"    column="pay_time"    />
        <result property="payNo"    column="pay_no"    />
        <result property="expireTime"    column="expire_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectOrderVo">
        select o.order_id, o.order_no, o.store_id, s.store_name, o.member_id, m.nickname as member_name,
               o.product_id, o.product_name, o.product_cover, o.order_type, o.price, o.num, o.total_amount,
               o.discount_amount, o.pay_amount, o.member_voucher_id, o.distributor_id, o.status, o.verify_code,
               o.verify_time, o.verify_user, o.pay_time, o.pay_no, o.expire_time, o.create_by, o.create_time,
               o.update_by, o.update_time, o.remark, o.merchant_id, mch.merchant_name as merchant_name
        from biz_order o
        left join biz_store s on s.store_id = o.store_id
        left join biz_member m on m.member_id = o.member_id
        left join biz_merchant mch on mch.merchant_id = o.merchant_id
    </sql>

    <!-- 券占用统计：只算未失效状态（0 待支付 / 1 待使用 / 2 已核销）。
         已取消(3)/已退款(4)的订单不该继续占着券，否则用户取消订单后券就废了。 -->
    <select id="countVoucherHeldOrders" resultType="int">
        select count(1) from biz_order
        where member_voucher_id = #{memberVoucherId}
          and status in ('0', '1', '2')
        <if test="excludeOrderId != null"> and order_id != #{excludeOrderId}</if>
    </select>

    <select id="selectOrderByOrderNo" parameterType="String" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        where o.order_no = #{orderNo}
    </select>

    <select id="selectOrderList" parameterType="Order" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="merchantId != null "> and o.merchant_id = #{merchantId}</if>
            <if test="orderNo != null  and orderNo != ''"> and o.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="storeId != null "> and o.store_id = #{storeId}</if>
            <if test="memberId != null "> and o.member_id = #{memberId}</if>
            <if test="productId != null "> and o.product_id = #{productId}</if>
            <if test="productName != null  and productName != ''"> and o.product_name like concat('%', #{productName}, '%')</if>
            <if test="orderType != null  and orderType != ''"> and o.order_type = #{orderType}</if>
            <if test="distributorId != null "> and o.distributor_id = #{distributorId}</if>
            <if test="status != null  and status != ''"> and o.status = #{status}</if>
            <if test="verifyCode != null  and verifyCode != ''"> and o.verify_code = #{verifyCode}</if>
            <if test="payNo != null  and payNo != ''"> and o.pay_no = #{payNo}</if>
            <if test="params != null and params.merchantIdsIn != null">
                <choose>
                    <when test="params.merchantIdsIn instanceof java.util.List">
                        <if test="params.merchantIdsIn.size() > 0"> and o.merchant_id in
                            <foreach collection="params.merchantIdsIn" item="mid" open="(" close=")" separator=",">#{mid}</foreach>
                        </if>
                        <if test="params.merchantIdsIn.size() == 0"> and 1=0 </if>
                    </when>
                    <otherwise> and o.merchant_id = #{params.merchantIdsIn}</otherwise>
                </choose>
            </if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''"> and find_in_set(o.store_id, #{params.storeIds})</if>
            <if test="params != null and params.memberIds != null and params.memberIds != ''"> and find_in_set(o.member_id, #{params.memberIds})</if>
            <if test="params != null and params.productIds != null and params.productIds != ''"> and find_in_set(o.product_id, #{params.productIds})</if>
            <if test="params != null and params.beginTime != null and params.beginTime != ''">
                and o.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''">
                and o.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by o.order_id desc
    </select>
    
    <!-- 核销记录：只取真核销过的单，按核销时间倒序。
         时间区间必须打在 verify_time 上而不是 create_time —— 团购最常见的场景
         就是「昨天买、今天来核」，按下单时间筛会漏掉这些单，同时把今天下单
         但还没核的单混进来，店长对不上账。 -->
    <select id="selectVerifiedOrderList" parameterType="Order" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        <where>
            and o.verify_time is not null
            <if test="merchantId != null "> and o.merchant_id = #{merchantId}</if>
            <if test="storeId != null "> and o.store_id = #{storeId}</if>
            <if test="verifyUser != null and verifyUser != ''"> and o.verify_user = #{verifyUser}</if>
            <if test="params != null and params.storeIds != null and params.storeIds != ''">
                and find_in_set(o.store_id, #{params.storeIds})
            </if>
            <if test="params != null and params.verifyBegin != null and params.verifyBegin != ''">
                and o.verify_time &gt;= #{params.verifyBegin}
            </if>
            <if test="params != null and params.verifyEnd != null and params.verifyEnd != ''">
                and o.verify_time &lt;= #{params.verifyEnd}
            </if>
        </where>
        order by o.verify_time desc, o.order_id desc
    </select>

    <select id="selectOrderByOrderId" parameterType="Long" resultMap="OrderResult">
        <include refid="selectOrderVo"/>
        where o.order_id = #{orderId}
    </select>

    <insert id="insertOrder" parameterType="Order" useGeneratedKeys="true" keyProperty="orderId">
        insert into biz_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="storeId != null">store_id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="productCover != null">product_cover,</if>
            <if test="orderType != null">order_type,</if>
            <if test="price != null">price,</if>
            <if test="num != null">num,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="discountAmount != null">discount_amount,</if>
            <if test="payAmount != null">pay_amount,</if>
            <if test="memberVoucherId != null">member_voucher_id,</if>
            <if test="distributorId != null">distributor_id,</if>
            <if test="status != null">status,</if>
            <if test="verifyCode != null">verify_code,</if>
            <if test="verifyTime != null">verify_time,</if>
            <if test="verifyUser != null">verify_user,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="payNo != null">pay_no,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="productCover != null">#{productCover},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="price != null">#{price},</if>
            <if test="num != null">#{num},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="discountAmount != null">#{discountAmount},</if>
            <if test="payAmount != null">#{payAmount},</if>
            <if test="memberVoucherId != null">#{memberVoucherId},</if>
            <if test="distributorId != null">#{distributorId},</if>
            <if test="status != null">#{status},</if>
            <if test="verifyCode != null">#{verifyCode},</if>
            <if test="verifyTime != null">#{verifyTime},</if>
            <if test="verifyUser != null">#{verifyUser},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="payNo != null">#{payNo},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateOrder" parameterType="Order">
        update biz_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="productCover != null">product_cover = #{productCover},</if>
            <if test="orderType != null">order_type = #{orderType},</if>
            <if test="price != null">price = #{price},</if>
            <if test="num != null">num = #{num},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="discountAmount != null">discount_amount = #{discountAmount},</if>
            <if test="payAmount != null">pay_amount = #{payAmount},</if>
            <if test="memberVoucherId != null">member_voucher_id = #{memberVoucherId},</if>
            <if test="distributorId != null">distributor_id = #{distributorId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="verifyCode != null">verify_code = #{verifyCode},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="verifyUser != null">verify_user = #{verifyUser},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="payNo != null">pay_no = #{payNo},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <update id="clearVoucher">
        update biz_order set member_voucher_id = null, update_time = sysdate()
        where order_id = #{orderId}
    </update>

    <!-- 超时未支付订单。用 create_time 而不是 expire_time：expire_time 是
         核销有效期（paySuccess 时才写入），待支付单那一列是 NULL。 -->
    <select id="selectTimeoutUnpaidIds" resultType="java.lang.Long">
        select order_id from biz_order
        where status = '0'
          and create_time is not null
          and create_time &lt; date_sub(now(), interval #{minutes} minute)
        order by order_id
    </select>

    <delete id="deleteOrderByOrderId" parameterType="Long">
        delete from biz_order where order_id = #{orderId}
    </delete>

    <delete id="deleteOrderByOrderIds" parameterType="String">
        delete from biz_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>
</mapper>