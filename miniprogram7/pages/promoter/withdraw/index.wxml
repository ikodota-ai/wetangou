<view class="page">
  <view class="head">
    <text class="h-t">申请提现</text>
    <text class="h-sub">可提现余额 ¥{{available}}</text>
  </view>

  <view class="form card">
    <view class="f-row">
      <text class="f-lab required">提现方式</text>
      <view class="type-row">
        <view class="type {{typeIdx===idx?'on':''}}" wx:for="{{types}}" wx:key="value" data-idx="{{idx}}" bindtap="pickType">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="f-row">
      <text class="f-lab required">提现金额</text>
      <input class="f-in" type="digit" value="{{amount}}" bindinput="onAmount" placeholder="{{amountPlaceholder}}" />
      <text class="all-btn" bindtap="fillAll">全部提现</text>
    </view>
    <view class="f-row" wx:if="{{feeText}}">
      <text class="f-lab">手续费</text>
      <text class="f-in">{{feeText}}</text>
    </view>
    <view class="f-row">
      <text class="f-lab required">{{type.accountLabel}}</text>
      <input class="f-in" value="{{account}}" bindinput="onAccount" placeholder="{{type.placeholder}}" />
    </view>
    <view class="f-row">
      <text class="f-lab required">收款人姓名</text>
      <input class="f-in" value="{{accountName}}" bindinput="onAccountName" placeholder="请输入收款人真实姓名" />
    </view>
  </view>

  <!-- 提现规则：微信审核要求在提现页面清晰展示，故常驻在页面上而非折叠/弹窗 -->
  <view class="rule-card card">
    <view class="rule-head">
      <text class="rule-title">提现规则</text>
      <text class="rule-state {{rule.withinServiceHours ? 'on' : 'off'}}">{{rule.withinServiceHours ? '当前可申请' : '当前非受理时段'}}</text>
    </view>

    <view class="rule-grid">
      <view class="rg-item">
        <text class="rg-num">¥{{available}}</text>
        <text class="rg-lab">可提现额度</text>
      </view>
      <view class="rg-item">
        <text class="rg-num">{{minAmountText}}</text>
        <text class="rg-lab">单笔最低</text>
      </view>
      <view class="rg-item">
        <text class="rg-num">{{maxAmountText}}</text>
        <text class="rg-lab">单笔最高</text>
      </view>
      <view class="rg-item">
        <text class="rg-num">{{dailyTimesText}}</text>
        <text class="rg-lab">每日次数</text>
      </view>
      <view class="rg-item">
        <text class="rg-num">{{rule.serviceHours}}</text>
        <text class="rg-lab">提现时间</text>
      </view>
      <view class="rg-item">
        <text class="rg-num">{{rule.arrivalDesc}}</text>
        <text class="rg-lab">到账时间</text>
      </view>
    </view>

    <view class="rule-list">
      <view class="rule-li" wx:for="{{rule.rules}}" wx:key="*this">
        <text class="rule-dot"></text>
        <text class="rule-txt">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="next-btn {{submitting?'disabled':''}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交申请'}}</view>
  </view>
</view>
