.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 200rpx; position: relative; }
.head { background: linear-gradient(180deg, #DCE9D3 0%, #F2F2F7 100%); padding: 32rpx; }
.h-row { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #FFFFFF; overflow: hidden; flex-shrink: 0; }
.avatar image { width: 100%; height: 100%; }
.h-meta { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.h-name { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.h-tag { display: inline-block; padding: 4rpx 12rpx; background: rgba(58,107,53,0.12); border-radius: 6rpx; align-self: flex-start; }
.h-tag text { font-size: 22rpx; color: var(--color-primary); }
.bag { position: relative; width: 96rpx; height: 96rpx; }
.bag::before, .bag::after { content: ''; position: absolute; border-radius: 8rpx; }
.bag-1 { position: absolute; left: 0; top: 0; width: 60rpx; height: 80rpx; background: var(--color-primary); border-radius: 24rpx 24rpx 8rpx 8rpx; }
.bag-2 { position: absolute; right: 0; bottom: 0; width: 60rpx; height: 80rpx; background: var(--color-primary-light); border-radius: 24rpx 24rpx 8rpx 8rpx; }
.bag-y { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 36rpx; color: #FFFFFF; font-weight: 700; z-index: 1; }

.content { margin-top: -24rpx; padding: 0 32rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 24rpx 32rpx; margin-bottom: 24rpx; }
.data-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.data-t { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.data-pills { display: flex; gap: 12rpx; }
.pill { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; background: #F2F2F7; border-radius: 8rpx; }
.pill text { font-size: 22rpx; color: #1A1A1A; }
.p-ic { width: 28rpx; height: 28rpx; }
.p-rec { border: 3rpx solid #1A1A1A; border-radius: 4rpx; }
.p-doc { border: 3rpx solid #1A1A1A; border-radius: 4rpx; position: relative; }
.p-doc::before { content: ''; position: absolute; left: 4rpx; right: 4rpx; top: 4rpx; bottom: 4rpx; border-top: 3rpx solid #1A1A1A; border-bottom: 3rpx solid #1A1A1A; }

.data-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24rpx 16rpx; padding: 16rpx 0; }
.d-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.d-num { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.d-lab { font-size: 24rpx; color: #1A1A1A; }
.go-withdraw { margin-top: 24rpx; }

.tabs { display: flex; }
.tab { flex: 1; position: relative; padding: 24rpx 0; display: flex; justify-content: center; }
.tab text { font-size: 28rpx; color: #1A1A1A; }
.tab.on text { font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 4rpx; transform: translateX(-50%); width: 56rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }
.empty { padding: 80rpx 0; text-align: center; }
.empty-text { color: var(--color-text-4); font-size: 28rpx; }

.coin-bubble { position: fixed; right: 24rpx; bottom: 180rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg, #FF6B35 0%, #FF9559 100%); box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4); display: flex; align-items: center; justify-content: center; z-index: 50; }
.cb-t { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }

/* 抽屉 */
.drawer-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: flex-end; }
.withdraw-box { width: 100%; background: #F2F2F7; border-radius: 24rpx 24rpx 0 0; padding-bottom: env(safe-area-inset-bottom); }
.wb-head { background: #F2F2F7; padding: 32rpx 32rpx 24rpx; position: relative; }
.wb-t { display: block; font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.wb-sub { display: block; font-size: 24rpx; color: #999; margin-top: 8rpx; }
.wb-close { position: absolute; right: 24rpx; top: 24rpx; width: 40rpx; height: 40rpx; }
.wb-close::before, .wb-close::after { content: ''; position: absolute; left: 50%; top: 50%; width: 32rpx; height: 4rpx; background: #999; border-radius: 2rpx; }
.wb-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.wb-close::after { transform: translate(-50%, -50%) rotate(-45deg); }

.wb-form { background: #FFFFFF; margin: 0 24rpx 24rpx; border-radius: 20rpx; padding: 0 32rpx; }
.f-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.f-row:last-child { border-bottom: none; }
.f-lab { width: 200rpx; font-size: 28rpx; color: #1A1A1A; flex-shrink: 0; }
.f-lab.required::before { content: '*'; color: var(--color-danger); margin-right: 4rpx; }
.f-in { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.f-val { flex: 1; display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; color: #1A1A1A; }
.ph { color: #999; }
.arr { width: 16rpx; height: 16rpx; border-right: 3rpx solid #BBB; border-top: 3rpx solid #BBB; transform: rotate(45deg); margin-left: auto; }
.check-ic { width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--color-primary); display: flex; align-items: center; justify-content: center; position: relative; }
.check-ic::after { content: ''; width: 16rpx; height: 8rpx; border-left: 4rpx solid #FFFFFF; border-bottom: 4rpx solid #FFFFFF; transform: rotate(-45deg) translate(2rpx, -2rpx); }
.wb-btn { margin: 0 24rpx 24rpx; height: 96rpx; line-height: 96rpx; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; background: var(--color-primary); color: #FFFFFF; text-align: center; }

.agree-box { width: 100%; background: #FFFFFF; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.ab-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.ab-t { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.ab-close { width: 40rpx; height: 40rpx; position: relative; }
.ab-close::before, .ab-close::after { content: ''; position: absolute; left: 50%; top: 50%; width: 32rpx; height: 4rpx; background: #999; border-radius: 2rpx; }
.ab-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.ab-close::after { transform: translate(-50%, -50%) rotate(-45deg); }
.ab-body { font-size: 28rpx; color: #1A1A1A; line-height: 1.7; }

/* 带货订单卡片与协议滚动区 */
.cm-item { margin: 0 32rpx 24rpx; }
.cm-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.cm-store { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.cm-amount { font-size: 32rpx; font-weight: 700; color: var(--color-danger); }
.cm-row { display: flex; justify-content: space-between; padding: 6rpx 0; }
.cm-lab { font-size: 24rpx; color: #999; }
.cm-val { font-size: 24rpx; color: #1A1A1A; max-width: 60%; text-align: right; }
.ab-body { max-height: 60vh; padding: 24rpx 32rpx; font-size: 26rpx; color: #1A1A1A; line-height: 1.7; }

/* 推客粉丝 tab 样式 */
.fan-poster { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: linear-gradient(135deg, #3A6B35 0%, #4E8446 100%); color: #FFFFFF; }
.fan-poster .fp-l { display: flex; flex-direction: column; gap: 8rpx; }
.fan-poster .fp-t { font-size: 30rpx; font-weight: 700; }
.fan-poster .fp-s { font-size: 22rpx; color: rgba(255,255,255,.85); }
.fan-poster .fp-r .fp-badge { padding: 8rpx 24rpx; background: rgba(255,255,255,.18); border-radius: 28rpx; font-size: 24rpx; }
.fan-info { display: flex; align-items: center; gap: 16rpx; }
.fan-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #F4F4F4; }
