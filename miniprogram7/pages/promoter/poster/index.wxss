/* pages/promoter/poster/index.wxss */
.page { min-height: 100vh; background: var(--color-bg); padding: 32rpx 32rpx 240rpx; }
.poster { padding: 48rpx 32rpx; background: #FFFFFF; border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,.05); }
.poster-top { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.brand { font-size: 40rpx; font-weight: 700; color: var(--color-primary); }
.tagline { font-size: 26rpx; color: #999; }
.qrbox { display: flex; justify-content: center; padding: 48rpx 0; }
.qr { width: 380rpx; height: 380rpx; }
.qr-placeholder { width: 380rpx; height: 380rpx; display: flex; align-items: center; justify-content: center; background: #F4F4F4; color: #999; font-size: 26rpx; border-radius: 12rpx; }
.hint { display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #999; font-size: 24rpx; }
.hint .scene { font-size: 20rpx; color: #BBB; word-break: break-all; }
.actions { margin-top: 48rpx; display: flex; flex-direction: column; gap: 24rpx; }
.btn-primary { height: 88rpx; line-height: 88rpx; background: var(--color-primary); color: #FFFFFF; border-radius: 44rpx; font-size: 30rpx; }
.btn-primary::after { border: none; }
.btn-secondary { height: 88rpx; line-height: 88rpx; background: #FFFFFF; color: var(--color-primary); border: 2rpx solid var(--color-primary); border-radius: 44rpx; font-size: 30rpx; }
.btn-secondary::after { border: none; }
