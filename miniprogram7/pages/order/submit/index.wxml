<view class="page" wx:if="{{product}}">
  <view class="store-line card">
    <view class="sl-ic"><view class="ic-shop"></view></view>
    <text class="sl-name">{{store.name}}</text>
    <text class="sl-link">1家店通用 ></text>
  </view>

  <view class="goods-line card">
    <image class="gl-img" src="{{product.cover}}" mode="aspectFill"></image>
    <view class="gl-info">
      <text class="gl-name">{{product.name}}</text>
      <view class="gl-price">
        <text class="now">¥{{product.price}}</text>
        <text class="old">¥{{product.price}}</text>
      </view>
    </view>
  </view>

  <view class="qty card">
    <text class="qty-lab">购买份数</text>
    <view class="qty-ctrl">
      <view class="qc-btn {{qty<=1?'off':''}}" bindtap="decQty">−</view>
      <text class="qc-num">{{qty}}</text>
      <view class="qc-btn" bindtap="incQty">+</view>
    </view>
  </view>

  <view class="pickup card">
    <view class="pickup-box {{pickup ? 'on' : ''}}" bindtap="togglePickup">
      <text class="pk-t">到店自取</text>
      <view class="pk-check"><view class="pk-check-in"></view></view>
    </view>
  </view>

  <view class="form card">
    <view class="f-row">
      <view class="f-lab">姓名<text class="required">（必填）</text></view>
      <input class="f-in" type="text" value="{{name}}" bindinput="onName" placeholder="请输入姓名" />
    </view>
    <view class="f-row">
      <view class="f-lab">手机号<text class="required">（必填）</text></view>
      <input class="f-in" type="number" value="{{phone}}" bindinput="onPhone" placeholder="请输入手机号" maxlength="11" />
    </view>
  </view>

  <view class="sum card">
    <view class="sum-row">
      <text class="sr-lab">商品总价</text>
      <text class="sr-val">¥{{total}}</text>
    </view>
    <view class="sum-row voucher-row" bindtap="openVoucher">
      <text class="sr-lab">优惠券</text>
      <view class="sr-right">
        <text class="sr-disc" wx:if="{{voucher}}">-¥{{discount}}</text>
        <text class="sr-tip" wx:elif="{{voucherCount}}">{{voucherCount}}张可用</text>
        <text class="sr-none" wx:else>暂无可用</text>
        <text class="sr-arrow">></text>
      </view>
    </view>
    <view class="sum-row">
      <text class="sr-lab"></text>
      <text class="sr-pay">需付款¥{{payAmount}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bb-total">合计：<text class="bb-num">¥{{payAmount}}</text></view>
    <view class="bb-btn" bindtap="onSubmit">提交订单</view>
  </view>

  <!-- 代金券选择：与买单页 pages/pay 的交互保持一致 -->
  <view class="mask" wx:if="{{showVoucher}}" bindtap="closeVoucher"></view>
  <view class="sheet" wx:if="{{showVoucher}}">
    <view class="sheet-head">
      <text class="sh-t">选择代金券</text>
      <text class="sh-c" bindtap="closeVoucher">关闭</text>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="v-item none" bindtap="clearVoucher">
        <text class="vi-name">不使用代金券</text>
      </view>
      <view class="v-item {{item.usable ? '' : 'dis'}}" wx:for="{{voucherList}}" wx:key="id"
            data-id="{{item.id}}" bindtap="pickVoucher">
        <view class="vi-left">
          <text class="vi-face">¥{{item.faceValue}}</text>
          <text class="vi-cond">满{{item.threshold}}可用</text>
        </view>
        <view class="vi-right">
          <text class="vi-exp" wx:if="{{item.expireText}}">{{item.expireText}} 到期</text>
          <!-- 不可用的原因要说清楚：只写"不可用"用户不知道是差门槛还是限门店 -->
          <text class="vi-tag" wx:if="{{!item.usable}}">{{item.limitText || '不可用'}}</text>
        </view>
      </view>
      <view class="v-empty" wx:if="{{!voucherList.length}}">
        <text>暂无代金券，可到首页「领券中心」领取</text>
      </view>
    </scroll-view>
  </view>
</view>
<view class="empty" wx:else>
  <text class="empty-text">商品信息加载中...</text>
</view>
