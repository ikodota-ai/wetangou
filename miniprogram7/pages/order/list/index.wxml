<view class="page">
  <view class="tabs">
    <view class="tab {{tab==='all'?'on':''}}" data-t="all" bindtap="switchTab">
      <text>全部</text>
      <view class="tab-bar"></view>
    </view>
    <view class="tab {{tab==='pending'?'on':''}}" data-t="pending" bindtap="switchTab">
      <text>待支付</text>
      <view class="tab-bar"></view>
    </view>
    <view class="tab {{tab==='unused'?'on':''}}" data-t="unused" bindtap="switchTab">
      <text>待使用</text>
      <view class="tab-bar"></view>
    </view>
    <view class="tab {{tab==='done'?'on':''}}" data-t="done" bindtap="switchTab">
      <text>已完成</text>
      <view class="tab-bar"></view>
    </view>
    <view class="tab {{tab==='refund'?'on':''}}" data-t="refund" bindtap="switchTab">
      <text>退款/售后</text>
      <view class="tab-bar"></view>
    </view>
  </view>
  <view class="empty" wx:if="{{!list.length}}">
    <text class="empty-text">暂无订单</text>
  </view>
  <view class="list" wx:else>
    <view class="card item" wx:for="{{list}}" wx:key="orderId" data-id="{{item.orderId}}" bindtap="goDetail">
      <view class="row1">
        <text class="shop">{{item.shop || merchantName}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="goods">
        <image class="g-img" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="g-info">
          <text class="g-name">{{item.name}}</text>
          <text class="g-time">{{item.time}}</text>
        </view>
        <view class="g-right">
          <text class="g-price">¥{{item.price}}</text>
          <text class="g-qty">x{{item.qty}}</text>
        </view>
      </view>
      <view class="row2"><text class="total">共{{item.qty}}件商品，实付</text><text class="total-num">¥{{item.total}}</text></view>
      <!-- 待支付才出操作栏。catchtap 而非 bindtap：要拦住冒泡，
           否则点「去支付」会连带触发外层卡片的 goDetail -->
      <view class="ops" wx:if="{{item.status === '0'}}">
        <view class="op-btn" data-id="{{item.orderId}}" catchtap="onCancel">取消订单</view>
        <view class="op-btn primary" data-id="{{item.orderId}}" catchtap="onPay">去支付</view>
      </view>
    </view>
  </view>
</view>
