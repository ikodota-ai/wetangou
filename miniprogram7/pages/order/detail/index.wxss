.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.status-bar { display: flex; flex-direction: column; }
.st-text { font-size: 36rpx; font-weight: 600; color: #333; }
.st-tip { font-size: 24rpx; color: #909399; margin-top: 8rpx; }
.code { display: flex; flex-direction: column; align-items: center; }
.code-lab { font-size: 24rpx; color: #909399; }
.code-val { font-size: 52rpx; font-weight: 700; color: #3A6B35; letter-spacing: 4rpx; margin: 16rpx 0; }
.code-btn { padding: 8rpx 32rpx; border: 1rpx solid #3A6B35; color: #3A6B35; border-radius: 32rpx; font-size: 24rpx; }
.code-exp { font-size: 22rpx; color: #909399; margin-top: 16rpx; }
.goods { display: flex; align-items: center; }
.g-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; }
.g-info { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; }
.g-name { font-size: 28rpx; color: #333; }
.g-shop { font-size: 22rpx; color: #909399; margin-top: 8rpx; }
.g-right { display: flex; flex-direction: column; align-items: flex-end; }
.g-price { font-size: 28rpx; color: #333; }
.g-qty { font-size: 22rpx; color: #909399; margin-top: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.lab { font-size: 26rpx; color: #909399; }
.val { font-size: 26rpx; color: #333; }
.val.pay { color: #E64340; font-weight: 600; }
.empty { display: flex; align-items: center; justify-content: center; height: 60vh; }
.empty-text { font-size: 28rpx; color: #909399; }
.qr-area { display: flex; flex-direction: column; align-items: center; margin-top: 28rpx; padding-top: 28rpx; border-top: 1rpx dashed #E5E5E5; width: 100%; box-sizing: border-box; }
.qr-img { width: 360rpx; height: 360rpx; background: #fff; }
.qr-tip { font-size: 22rpx; color: #909399; margin-top: 16rpx; }
.qr-loading { font-size: 22rpx; color: #909399; margin-top: 16rpx; }

/* 待支付底部操作栏。fixed 常驻底部，占位块防止盖住最后一行信息。
   安全区留白给全面屏机型的手势条 */
.pay-holder { height: 140rpx; }
.pay-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFF; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.pb-sum { display: flex; align-items: baseline; gap: 8rpx; }
.pb-lab { font-size: 26rpx; color: #999; }
.pb-num { font-size: 36rpx; font-weight: 700; color: var(--color-primary); }
.pb-btn {
  padding: 18rpx 64rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 600;
  background: var(--color-primary); color: #FFF;
}
