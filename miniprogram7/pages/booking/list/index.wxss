.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 200rpx; }
.tabs { display: flex; background: #FFFFFF; padding: 0 24rpx; position: sticky; top: 0; z-index: 5; }
.tab { position: relative; padding: 24rpx 32rpx; margin-right: 16rpx; }
.tab text { font-size: 28rpx; color: #1A1A1A; }
.tab.on text { font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 4rpx; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }

/* 两列网格（flex 实现，兼容性最好） */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 32rpx;
  margin: 0 -10rpx;
}
.grid > .bl-card.span-half { width: calc(50% - 20rpx); margin: 0 10rpx 20rpx; }
.grid > .bl-card.span-full { width: 100%; margin: 0 0 20rpx; }
.bl-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 100%;
}
.c-img {
  width: 100%;
  height: 220rpx;
  background: #F2F2F7;
}
.c-info {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.c-ttl {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-time {
  font-size: 22rpx;
  color: #555;
}
.c-store {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.c-status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  background: #F2F2F7;
  color: #999;
  text-align: center;
  border-top: 1rpx solid #F0F0F0;
}
.c-status.wait { background: #FFF5E6; color: #E8852A; }
.c-status.done { background: #E8F5E9; color: #2E7D32; }
.c-status.cancel { background: #FFEBEE; color: #C62828; }

.empty { padding: 200rpx 0 0; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.empty-tip { font-size: 28rpx; color: #999; }
.go-create { padding: 20rpx 80rpx; border: 2rpx solid var(--color-primary); border-radius: 999rpx; color: var(--color-primary); font-size: 30rpx; }
