<view class="page">
  <view class="card">
    <text class="s-name">{{info.storeName || '加载中'}}</text>
    <view class="s-addr">
      <view class="addr-txt">
        <text class="a1">{{info.storeAddress || '-'}}</text>
      </view>
      <view class="ops">
        <view class="op" bindtap="goLocation">
          <view class="op-ic ic-nav"></view>
          <text>导航</text>
        </view>
        <view class="op" bindtap="callService">
          <view class="op-ic ic-tel"></view>
          <text>联系商家</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row"><text class="lab">预约状态</text><text class="val status">{{info.statusText}}</text></view>
    <view class="row"><text class="lab">预约项目</text><text class="val">{{info.serviceName}}</text></view>
    <view class="row"><text class="lab">到店时间</text><text class="val">{{info.bookingTime || '-'}}</text></view>
    <view class="row"><text class="lab">提交时间</text><text class="val">{{info.createTime}}</text></view>
    <view class="row"><text class="lab">联系人</text><text class="val">{{info.contact}}</text></view>
    <view class="row"><text class="lab">预约手机号</text><text class="val">{{info.phone}}</text></view>
    <view class="row"><text class="lab">用餐人数</text><text class="val">{{info.people}} 人</text></view>
    <view class="row"><text class="lab">备注</text><text class="val">{{info.remark}}</text></view>
    <view class="row"><text class="lab">预约编号</text><text class="val">{{info.bookingNo}}</text></view>
  </view>

  <view class="card">
    <text class="block-title">预约说明</text>
    <text class="explain">座位保留 15 分钟，超时自动作废；用餐前 2 小时可免费取消；到店出示本页预约编号核验入座。</text>
  </view>

  <view class="bottom-bar" wx:if="{{canCancel}}">
    <view class="cancel-btn" bindtap="onCancel">取消预约</view>
  </view>
</view>
