<view class="page">
  <view class="topbar" style="height: {{statusBarHeight + 44}}px; padding-top: {{statusBarHeight}}px;">
    <view class="tb-inner">
      <view class="tb-home" bindtap="goHome"></view>
      <text class="tb-title">预约</text>
      <view class="tb-right">
        <view class="tb-loc"></view>
        <view class="tb-dot"></view>
      </view>
    </view>
  </view>
  <view class="topbar-pad" style="height: {{statusBarHeight + 44}}px;"></view>

  <view class="content">
    <view class="store-card card">
      <view class="s-name-row">
        <text class="s-name">{{store.name || (_storeLoadTimedOut ? '门店加载失败' : '门店加载中…')}}</text>
        <text class="s-retry" wx:if="{{_storeLoadTimedOut}}" bindtap="retryStore">↻ 重新加载</text>
      </view>
      <view class="s-hours" wx:if="{{store.hours}}">营业时间：{{store.hours}}</view>
      <view class="s-addr">
        <view class="addr-txt">
          <text class="a1">{{store.address || '-'}}</text>
          <text class="a2" wx:if="{{store.hasDistance}}">距您{{store.distanceText}}</text>
        </view>
        <view class="ops">
          <view class="op" bindtap="goLocation">
            <view class="op-ic ic-nav"></view>
            <text>导航</text>
          </view>
          <view class="op" bindtap="goService">
            <view class="op-ic ic-tel"></view>
            <text>联系商家</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 预约类型来自后台「字典管理 → 预约类型」，配几条就显示几张卡。
         原先这里写死一张「堂食预约」，后台加了「到店消费」也不显示。 -->
    <view class="book-card" wx:for="{{bookingTypes}}" wx:key="code"
          data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goCreateType">
      <image class="bc-img" src="{{store.logo || '/assets/img/RestaurantImg.png'}}" mode="aspectFill"></image>
      <view class="bc-mask"></view>
      <text class="bc-ttl">{{item.name}}</text>
    </view>
    <!-- 后台一条都没配时给个入口，别让顾客约不了；typesLoaded 之前不显示，
         避免首屏闪一下这段文案 -->
    <view class="book-card" wx:if="{{typesLoaded && !bookingTypes.length}}" bindtap="goCreate">
      <image class="bc-img" src="{{store.logo || '/assets/img/RestaurantImg.png'}}" mode="aspectFill"></image>
      <view class="bc-mask"></view>
      <text class="bc-ttl">在线预约</text>
    </view>

    <view class="my-booking" bindtap="goList">
      <text>我的预约</text>
      <text class="mb-arrow">></text>
    </view>
  </view>
</view>
