.page { min-height: 100vh; background: var(--color-bg); }
.topbar { position: fixed; top: 0; left: 0; right: 0; background: #FFFFFF; z-index: 10; border-bottom: 1rpx solid #EEE; }
.tb-inner { display: flex; align-items: center; justify-content: space-between; height: 44px; padding: 0 24rpx; }
.tb-title { font-size: 34rpx; font-weight: 600; color: #1A1A1A; }
.tb-home { width: 40rpx; height: 40rpx; position: relative; }
.tb-home::before { content: ''; position: absolute; left: 8rpx; top: 16rpx; width: 20rpx; height: 16rpx; border: 4rpx solid #1A1A1A; border-top: none; border-radius: 0 0 4rpx 4rpx; }
.tb-home::after { content: ''; position: absolute; left: 4rpx; top: 12rpx; border: 12rpx solid transparent; border-bottom: 12rpx solid #1A1A1A; }
.tb-right { display: flex; align-items: center; gap: 16rpx; }
.tb-loc { width: 36rpx; height: 36rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; position: relative; }
.tb-loc::after { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 12rpx; height: 12rpx; background: #1A1A1A; border-radius: 50%; }
.tb-dot { width: 36rpx; height: 36rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; }
.content { padding: 24rpx 32rpx 40rpx; }

.store-card { padding: 32rpx; display: flex; flex-direction: column; gap: 12rpx; }
.s-name { font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.s-hours { font-size: 24rpx; color: var(--color-text-2); }
.s-addr { background: linear-gradient(90deg, #E2EFDC, #F2F2F7); border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.addr-txt { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.a1 { font-size: 26rpx; font-weight: 600; color: #1A1A1A; line-height: 1.4; }
.a2 { font-size: 22rpx; color: var(--color-text-4); }
.ops { display: flex; gap: 24rpx; }
.op { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.op-ic { width: 64rpx; height: 64rpx; border-radius: 50%; background: #ECECEC; display: flex; align-items: center; justify-content: center; }
.op text { font-size: 22rpx; color: var(--color-text-2); }
.ic-nav { width: 32rpx; height: 32rpx; background: var(--color-primary); clip-path: polygon(50% 0%, 100% 100%, 70% 100%, 70% 75%, 30% 75%, 30% 100%, 0 100%); }
.ic-tel { width: 30rpx; height: 30rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.ic-tel::after { content: ''; position: absolute; left: 6rpx; bottom: 4rpx; width: 8rpx; height: 8rpx; background: var(--color-primary); border-radius: 50%; }

.book-card { position: relative; margin-top: 24rpx; border-radius: 20rpx; overflow: hidden; }
.bc-img { width: 100%; height: 580rpx; }
.bc-mask { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.6) 100%); }
.bc-ttl { position: absolute; left: 32rpx; bottom: 32rpx; font-size: 32rpx; font-weight: 600; color: #FFFFFF; }

/* 我的预约入口 */
.my-booking { margin-top: 24rpx; background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; display: flex; align-items: center; justify-content: space-between; }
.my-booking text { font-size: 30rpx; color: #1A1A1A; }
.mb-arrow { color: #999; }

/* 预约项目现在是真实商品，价格要露出来 —— 顾客得先知道多少钱才决定约不约 */
.bc-price {
  position: absolute; right: 24rpx; bottom: 24rpx;
  font-size: 32rpx; font-weight: 700; color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
