.page { padding: 24rpx; }
.header { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0; }
.badge { background: #f59e0b; color: #fff; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-top: 16rpx; }
.sub { color: #64748b; font-size: 26rpx; margin-top: 8rpx; }
.placeholder { background: #fff; border-radius: 16rpx; padding: 48rpx 24rpx; text-align: center; }
.ph-title { font-size: 32rpx; font-weight: 600; }
.ph-sub { color: #94a3b8; font-size: 26rpx; margin-top: 16rpx; line-height: 1.6; }
