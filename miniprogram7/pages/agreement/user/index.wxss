.page { min-height: 100vh; background: #F2F2F7; padding: 32rpx; }
.title-area { padding: 16rpx 0 32rpx; }
.title { display: block; font-size: 48rpx; font-weight: 700; color: #1A1A1A; }
.sub { display: block; font-size: 26rpx; color: #999; margin-top: 12rpx; }
.card { background: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.content { display: block; font-size: 28rpx; color: #1A1A1A; line-height: 1.9; }
.tip { display: block; font-size: 26rpx; color: #999; text-align: center; padding: 24rpx 0; }
