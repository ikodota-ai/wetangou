.page { min-height: 100vh; background: #F2F2F7; padding: 60rpx 32rpx; box-sizing: border-box; }
.big-btn {
  background: linear-gradient(135deg, #3A6B35, #5A8A4A);
  color: #fff; border-radius: 24rpx; padding: 80rpx 32rpx;
  text-align: center; font-size: 34rpx; font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(58,107,53,0.25);
  display: flex; flex-direction: column; align-items: center; gap: 24rpx;
}
.big-btn:active { opacity: 0.9; }
.ic {
  width: 120rpx; height: 120rpx; background: #fff; border-radius: 24rpx;
  position: relative;
}
.ic::before, .ic::after { content: ''; position: absolute; background: #3A6B35; }
.ic::before { width: 56rpx; height: 10rpx; top: 40rpx; left: 32rpx; box-shadow: 0 -16rpx 0 #3A6B35, 0 16rpx 0 #3A6B35; }
.ic::after { width: 10rpx; height: 56rpx; top: 32rpx; left: 55rpx; box-shadow: 16rpx 0 0 #3A6B35, -16rpx 0 0 #3A6B35; }
.hint { margin-top: 40rpx; text-align: center; color: #999; font-size: 24rpx; line-height: 1.6; }
