<view class="page">
  <view class="profile card">
    <view class="avatar"></view>
    <view class="info">
      <text class="name">{{realName || '员工'}}</text>
      <text class="meta">{{storeName || '尚未绑定门店'}} · {{role || '员工'}}</text>
    </view>
  </view>

  <view class="list card">
    <view class="li" bindtap="goTeam" wx:if="{{showTeam}}">
      <text>店员管理</text>
      <view class="arr"></view>
    </view>
    <view class="li" bindtap="goProfile">
      <text>补录姓名 / 手机号</text>
      <view class="arr"></view>
    </view>
    <view class="li" bindtap="goBindWx" wx:if="{{!openidBound}}">
      <text>绑定微信</text>
      <view class="arr"></view>
    </view>
    <view class="li">
      <text>openid</text>
      <text class="muted">{{openid || '未绑定'}}</text>
    </view>
    <view class="li">
      <text>userId</text>
      <text class="muted">{{userId || '-'}}</text>
    </view>
  </view>

  <view class="logout" bindtap="onLogout">
    <text>退出登录</text>
  </view>
</view>
