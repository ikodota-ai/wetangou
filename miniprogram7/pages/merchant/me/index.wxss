.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx 32rpx 60rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); margin-bottom: 24rpx; }
.profile { display: flex; align-items: center; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: linear-gradient(135deg, #3A6B35, #5A8A4A);
  margin-right: 24rpx;
}
.info { flex: 1; }
.name { display: block; font-size: 34rpx; font-weight: 700; color: #1A1A1A; }
.meta { display: block; font-size: 24rpx; color: #888; margin-top: 6rpx; }
.li {
  display: flex; align-items: center; justify-content: space-between;
  height: 96rpx; border-bottom: 1rpx solid #F0F0F0; font-size: 30rpx; color: #1A1A1A;
}
.li:last-child { border-bottom: none; }
.muted { color: #999; font-size: 26rpx; }
.arr { width: 14rpx; height: 14rpx; border-top: 4rpx solid #C0C0C0; border-right: 4rpx solid #C0C0C0; transform: rotate(45deg); }
.logout {
  margin-top: 40rpx; text-align: center;
  background: #fff; border-radius: 16rpx; padding: 28rpx 0;
  color: #D9342B; font-size: 30rpx; font-weight: 600;
}
.logout:active { opacity: 0.7; }
