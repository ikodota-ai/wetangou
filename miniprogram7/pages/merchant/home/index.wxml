<view class="page">
  <view class="head card">
    <view class="identity-row">
      <view class="identity-badge">商家工作台</view>
      <text class="identity-name">{{realName || '员工'}}</text>
    </view>
    <view class="store-row">
      <text class="store-label">当前门店</text>
      <text class="store-name">{{storeName || '尚未登录'}}</text>
    </view>
  </view>

  <view class="notice card" wx:if="{{needBindWx}}">
    <view class="notice-t">未绑定微信</view>
    <view class="notice-d">登录后请在「我的」中扫码绑定微信，下次可直接微信登录。</view>
  </view>

  <view class="stat-grid">
    <view class="stat-card">
      <text class="stat-num">{{todayVerifyCount}}</text>
      <text class="stat-lab">今日核销</text>
      <text class="stat-amount">¥{{todayVerifyAmount}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{todayOrderCount}}</text>
      <text class="stat-lab">今日新订单</text>
      <text class="stat-amount">待使用</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{pendingBillCount}}</text>
      <text class="stat-lab">待确认买单</text>
      <text class="stat-amount">需处理</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{todayBookingCount}}</text>
      <text class="stat-lab">今日预约</text>
      <text class="stat-amount">到店核销</text>
    </view>
  </view>

  <view class="modules card">
    <view class="module-item" bindtap="goVerify">
      <view class="m-text"><text class="m-t">团购核销</text><text class="m-d">扫描或输入核销码</text></view>
      <view class="arr"></view>
    </view>
    <view class="module-item" bindtap="goBooking">
      <view class="m-text"><text class="m-t">预约审核</text><text class="m-d">确认顾客到店 / 拒绝预约</text></view>
      <view class="arr"></view>
    </view>
    <view class="module-item" bindtap="goBill">
      <view class="m-text"><text class="m-t">买单记录</text><text class="m-d">查看今日流水 / 状态</text></view>
      <view class="arr"></view>
    </view>
    <view class="module-item" bindtap="goOrders">
      <view class="m-text"><text class="m-t">今日订单</text><text class="m-d">查看今日订单流水</text></view>
      <view class="arr"></view>
    </view>
  </view>

  <view class="recent card" wx:if="{{recentOrders.length}}">
    <view class="section-title">最近订单</view>
    <view class="ro-item" wx:for="{{recentOrders}}" wx:key="orderId">
      <view class="ro-left">
        <text class="ro-no">{{item.orderNo}}</text>
        <text class="ro-name">{{item.productName || ('订单' + item.orderId)}}</text>
      </view>
      <view class="ro-right">
        <text class="ro-amt">¥{{item.payAmount || 0}}</text>
        <text class="ro-status">{{orderStatusText(item.status)}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <view class="act" bindtap="goHistory"><text>核销记录</text></view>
    <view class="act" bindtap="goMe"><text>我的</text></view>
    <view class="act" bindtap="goSwitchAccount"><text>切换回会员</text></view>
  </view>
</view>
