<view class="page">

  <!-- ============ 第 1 页: 选类型 ============ -->
  <block wx:if="{{step === 1}}">
    <view class="card">
      <view class="card-title">基础信息</view>

      <view class="row" bindtap="onTapCategory">
        <view class="row-label"><text class="required">*</text> <text>商品品类</text></view>
        <view class="row-value">
          <text class="{{pickedCategory  ? 'value' : 'placeholder'}}">{{pickedCategory || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row" bindtap="onTapType">
        <view class="row-label"><text class="required">*</text> <text>商品类型</text></view>
        <view class="row-value">
          <text class="{{pickedTypeName  ? 'value' : 'placeholder'}}">{{pickedTypeName || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <view class="next-bar">
      <view class="next-btn {{(pickedCategory && pickedType) ? 'enabled' : 'disabled'}}" bindtap="onNext">下一步</view>
    </view>
  </block>

  <!-- ============ 第 2 页: 连续表单（锚点导航 + 滚动联动） ============ -->
  <block wx:if="{{step === 2}}">
    <!-- 锚点导航：点击只做定位，页面本身是连续的一整篇；
         滚动时由 onFormScroll 反算当前区块并高亮，两个方向都要同步 -->
    <view class="tab-bar">
      <view wx:for="{{tabLabels}}" wx:key="*this"
            class="tab-item {{activeTab === index ? 'active' : ''}}"
            data-idx="{{index}}"
            bindtap="onTabChange">
        <text>{{item}}</text>
        <view wx:if="{{activeTab === index}}" class="tab-line"></view>
      </view>
    </view>

    <scroll-view class="form-scroll"
                 scroll-y
                 scroll-with-animation
                 enable-flex
                 scroll-into-view="{{scrollIntoView}}"
                 scroll-into-view-alignment="start"
                 bindscroll="onFormScroll">

    <!-- ===== 区块 0: 基础信息（只读） ===== -->
    <view class="form-section" id="sec-0">
      <view class="card">
        <view class="card-title">基础信息</view>
        <view class="readonly-row">
          <text class="row-label">商品品类 <text class="readonly-tag">不可编辑</text></text>
          <text class="readonly-value">{{pickedCategory}}</text>
        </view>
        <view class="readonly-row">
          <text class="row-label">商品类型 <text class="readonly-tag">不可编辑</text></text>
          <text class="readonly-value">{{pickedTypeName}}</text>
        </view>
        <view class="rule-row" bindtap="onBack">
          <text>商品发布细则</text>
          <text class="link">查看详情 ›</text>
        </view>
      </view>
    </view>

    <!-- ===== 区块 1: 商家信息 ===== -->
    <view class="form-section" id="sec-1">
      <view class="card">
        <view class="card-title">商家信息</view>
        <view class="readonly-row">
          <text class="row-label">商家名称 <text class="readonly-tag">不可编辑</text></text>
          <text class="readonly-value">{{storeName}}</text>
        </view>
        <view class="readonly-row">
          <text class="row-label">收款方式 <text class="readonly-tag">不可编辑</text></text>
          <!-- 原先这里硬编码「总部统一收款」，而 js 往库里写的是 PLATFORM ——
               显示与落库不一致。现在绑定真实值。 -->
          <text class="readonly-value">{{collectMethodLabel}}</text>
        </view>
        <!-- 适用门店：多选。原先是单选（storeIds 只塞一个 storeId），
             连锁商户的同一个套餐在第 2 家门店就没法卖。 -->
        <view class="row" bindtap="onOpenStoreSheet">
          <view class="row-label"><text class="required">*</text> <text>适用门店</text></view>
          <view class="row-value">
            <text class="{{form.storeIdList.length ? 'value' : 'placeholder'}}">
              {{form.storeIdList.length ? ('已选 ' + form.storeIdList.length + ' 家') : '请选择'}}
            </text>
            <text class="arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 区块 2: 商品信息 ===== -->
    <view class="form-section" id="sec-2">
      <view class="card">
        <view class="card-title">商品信息</view>
        <view wx:for="{{sectionProduct}}" wx:key="key">
          <!-- text input -->
          <view wx:if="{{item.type === 'text'}}" class="row column">
            <view class="row-head">
              <view class="row-label"><block wx:if="{{item.required}}"><text class="required">*</text> </block><text>{{item.label}}</text></view>
              <text class="row-counter">{{form[item.key + '__len'] || 0}}/{{item.max || 40}}</text>
            </view>
            <textarea wx:if="{{item.isTextarea}}"
                      class="row-textarea"
                      maxlength="{{item.max || 500}}"
                      placeholder="{{item.placeholder || '请输入'}}"
                      value="{{form[item.key]}}"
                      data-key="{{item.key}}"
                      bindinput="onField" />
            <input wx:else
                   class="row-input"
                   maxlength="{{item.max || 40}}"
                   placeholder="{{item.placeholder || '请输入'}}"
                   value="{{form[item.key]}}"
                   data-key="{{item.key}}"
                   bindinput="onField" />
            <text wx:if="{{item.placeholder && item.label === '商品名称'}}" class="row-tip">{{item.placeholder}}</text>
          </view>

          <!-- digit/number input -->
          <view wx:elif="{{item.type === 'digit' || item.type === 'number'}}" class="row">
            <view class="row-label"><block wx:if="{{item.required}}"><text class="required">*</text> </block><text>{{item.label}}</text></view>
            <view class="row-value with-input">
              <text wx:if="{{item.prefix}}" class="ipt-prefix">{{item.prefix}}</text>
              <input class="ipt-inline"
                     type="digit"
                     placeholder="{{item.placeholder || '请输入'}}"
                     value="{{form[item.key]}}"
                     data-key="{{item.key}}"
                     bindinput="onField" />
              <text wx:if="{{item.suffix}}" class="ipt-suffix">{{item.suffix}}</text>
            </view>
          </view>

          <!-- period picker -->
          <view wx:elif="{{item.type === 'period-picker'}}" class="row">
            <view class="row-label"><block wx:if="{{item.required}}"><text class="required">*</text> </block><text>{{item.label}}</text></view>
            <view class="row-value">
              <text class="placeholder">请选择</text>
              <text class="arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 区块 3: 售卖信息 ===== -->
    <view class="form-section" id="sec-3">
      <view class="card">
        <view class="card-title">售卖信息</view>
        <view wx:for="{{sectionSale}}" wx:key="key">
          <view wx:if="{{item.type === 'number'}}" class="row">
            <view class="row-label"><block wx:if="{{item.required}}"><text class="required">*</text> </block><text>{{item.label}}</text></view>
            <view class="row-value with-input">
              <input class="ipt-inline"
                     type="digit"
                     placeholder="{{item.placeholder || '请输入'}}"
                     value="{{form[item.key]}}"
                     data-key="{{item.key}}"
                     bindinput="onField" />
              <text wx:if="{{item.suffix}}" class="ipt-suffix">{{item.suffix}}</text>
            </view>
          </view>
        </view>
        <!-- 投放渠道：从 biz_sale_channel 字典拉，按分组展示 + 每条带投放规则说明 -->
        <view class="rule-row" bindtap="onOpenChannelSheet">
          <view class="row-label"><text>投放渠道</text></view>
          <view class="row-value">
            <text class="{{form.saleChannels.length ? 'value' : 'placeholder'}}">{{channelSummary || '未选择'}}</text>
            <text class="arrow">›</text>
          </view>
        </view>
        <view class="row">
          <text class="row-label">职人带货</text>
          <switch checked="{{form.staffPromote === 1}}" data-key="staffPromote"
                  bindchange="onSwitch" color="#1677FF" />
        </view>
        <view class="row-tip">开启后，允许门店职人在自己的橱窗里带货本商品</view>
        <!-- 售后政策：原先绑的 onTapRuleField 在 js 里根本不存在，点了没反应 -->
        <view class="row column">
          <text class="row-label">售后政策</text>
          <view class="opt-group">
            <view class="opt {{form.refundPolicy === 'ANYTIME' ? 'on' : ''}}" data-code="ANYTIME" bindtap="onPickRefundPolicy">支持随时退</view>
            <view class="opt {{form.refundPolicy === 'BEFORE_EXPIRE' ? 'on' : ''}}" data-code="BEFORE_EXPIRE" bindtap="onPickRefundPolicy">仅过期前可退</view>
            <view class="opt {{form.refundPolicy === 'NONE' ? 'on' : ''}}" data-code="NONE" bindtap="onPickRefundPolicy">不可退</view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 区块 4: 交易规则 ===== -->
    <view class="form-section" id="sec-4">
      <view class="card">
        <view class="card-title">交易规则</view>
        <view class="rule-row">
          <view class="row-label"><text class="required">*</text> <text>顾客可消费日期</text></view>
          <view class="row-value">
            <text>自购买次日起 {{form.validityDays || 360}} 天，购买当天默认可用</text>
          </view>
        </view>
        <!-- 券码类型：与后台一致的 MERCHANT/PLATFORM（后台原先写的 DOUYIN 是照抄抖音来客的） -->
        <view class="row column">
          <text class="row-label">券码类型</text>
          <view class="opt-group">
            <view class="opt {{form.codeType === 'MERCHANT' ? 'on' : ''}}" data-code="MERCHANT" bindtap="onPickCodeType">商家券</view>
            <view class="opt {{form.codeType === 'PLATFORM' ? 'on' : ''}}" data-code="PLATFORM" bindtap="onPickCodeType">平台券</view>
          </view>
          <text class="row-tip">商家券由本商户自行核销；平台券由平台统一发码</text>
        </view>
        <view class="row">
          <text class="row-label">可与店内优惠同享</text>
          <switch checked="{{form.mutexWithStorePromotion === 0}}" bindchange="onToggleMutex" color="#1677FF" />
        </view>
        <view class="row column">
          <text class="row-label">额外费用说明</text>
          <input class="row-input" maxlength="200" placeholder="如需另付服务费/餐位费，请在此说明"
                 value="{{form.extraFeeDesc}}" data-key="extraFeeDesc" bindinput="onField" />
        </view>
        <view wx:for="{{sectionTrade}}" wx:key="key">
          <view wx:if="{{item.type === 'number'}}" class="row">
            <view class="row-label"><block wx:if="{{item.required}}"><text class="required">*</text> </block><text>{{item.label}}</text></view>
            <view class="row-value with-input">
              <input class="ipt-inline"
                     type="digit"
                     placeholder="{{item.placeholder || '请输入'}}"
                     value="{{form[item.key]}}"
                     data-key="{{item.key}}"
                     bindinput="onField" />
              <text wx:if="{{item.suffix}}" class="ipt-suffix">{{item.suffix}}</text>
            </view>
          </view>
          <view wx:elif="{{item.type === 'switch'}}" class="row">
            <text class="row-label">{{item.label}}</text>
            <switch checked="{{form[item.key] === 1}}"
                    disabled="{{item.disabled}}"
                    data-key="{{item.key}}"
                    data-disabled="{{item.disabled ? 'true' : 'false'}}"
                    bindchange="onSwitch"
                    color="#1677FF" />
          </view>
          <view wx:elif="{{item.type === 'textarea'}}" class="row column">
            <view class="row-head">
              <text class="row-label">{{item.label}}</text>
              <text class="row-counter">{{form[item.key + '__len'] || 0}}/{{item.max || 500}}</text>
            </view>
            <textarea class="row-textarea"
                      maxlength="{{item.max || 500}}"
                      placeholder="{{item.placeholder || '请输入'}}"
                      value="{{form[item.key]}}"
                      data-key="{{item.key}}"
                      bindinput="onField" />
          </view>
        </view>
      </view>
    </view>
    </scroll-view>

    <!-- 底部固定双按钮 -->
    <view class="footer">
      <view class="btn-preview" bindtap="onPreview">预览</view>
      <view class="btn-submit {{!canSubmit || submitting ? 'disabled' : ''}}"
            bindtap="onSubmit">
        {{submitting ? '保存中…' : (isEdit ? '保存修改' : '保存为草稿')}}
      </view>
    </view>
  </block>

  <!-- ============ 弹窗: 商品品类 ============ -->
  <view wx:if="{{categorySheet}}" class="sheet-mask" bindtap="onCloseCategorySheet">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">商品品类</text>
        <text class="sheet-close" bindtap="onCloseCategorySheet">×</text>
      </view>
      <view class="sheet-body">
        <view class="sheet-tip" wx:if="{{categoryList.length}}">请选择商品所属品类</view>
        <view wx:for="{{categoryList}}" wx:key="id"
              class="sheet-item {{form.categoryId === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              data-name="{{item.label}}"
              bindtap="onPickCategoryItem">
          <text>{{item.label}}</text>
        </view>
        <view class="sheet-tip" wx:if="{{categoryLoaded && !categoryList.length}}">暂无可用品类，请联系平台在后台【门店商品 → 商品分类】配置</view>
        <view class="sheet-tip" wx:if="{{!categoryLoaded}}">加载中…</view>
      </view>
      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="onCloseCategorySheet">确认</view>
      </view>
    </view>
  </view>

  <!-- ============ 弹窗: 商品类型 ============ -->
  <view wx:if="{{typeSheet}}" class="sheet-mask" bindtap="onCloseTypeSheet">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">商品类型</text>
        <text class="sheet-close" bindtap="onCloseTypeSheet">×</text>
      </view>
      <view class="sheet-body">
        <view wx:for="{{typeList}}" wx:key="typeCode" class="type-card {{item.disabled ? 'disabled' : ''}}"
              data-code="{{item.typeCode}}"
              bindtap="onPickTypeItem">
          <view class="type-card-name">{{item.typeName}}</view>
          <view class="type-card-desc">{{pickedType === item.typeCode ? '已选' : '请选择'}}</view>
          <view wx:if="{{item.disabled}}" class="type-card-tip">{{item.disabledTip}}</view>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="onCloseTypeSheet">确认</view>
      </view>
    </view>
  </view>

  <!-- ============ 弹窗: 适用门店（多选） ============ -->
  <view wx:if="{{storeSheet}}" class="sheet-mask" bindtap="onCloseStoreSheet">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">适用门店</text>
        <text class="sheet-close" bindtap="onCloseStoreSheet">×</text>
      </view>
      <view class="sheet-body">
        <view class="sheet-tip">可多选。只有勾选的门店能核销本商品</view>
        <view wx:for="{{storePickList}}" wx:key="id"
              class="sheet-item pick"
              data-id="{{item.id}}"
              bindtap="onToggleStore">
          <text>{{item.label}}</text>
          <text class="pick-mark {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</text>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="onCloseStoreSheet">确认（已选 {{form.storeIdList.length}} 家）</view>
      </view>
    </view>
  </view>

  <!-- ============ 弹窗: 投放渠道（分组多选） ============ -->
  <view wx:if="{{channelSheet}}" class="sheet-mask" bindtap="onCloseChannelSheet">
    <view class="sheet" catchtap="">
      <view class="sheet-head">
        <text class="sheet-title">投放渠道</text>
        <text class="sheet-close" bindtap="onCloseChannelSheet">×</text>
      </view>
      <view class="sheet-body">
        <view wx:if="{{!channelGroups.length}}" class="sheet-tip">渠道字典暂不可用，保存后按平台默认渠道投放</view>
        <view wx:for="{{channelGroups}}" wx:key="name" class="ch-group">
          <view class="ch-group-title">{{item.label}}</view>
          <view wx:for="{{item.items}}" wx:for-item="ch" wx:key="channelCode"
                class="sheet-item pick"
                data-code="{{ch.channelCode}}"
                bindtap="onToggleChannel">
            <view class="ch-text">
              <text>{{ch.channelName}}</text>
              <text wx:if="{{ch.channelDesc}}" class="ch-desc">{{ch.channelDesc}}</text>
            </view>
            <text class="pick-mark {{ch.checked ? 'on' : ''}}">{{ch.checked ? '✓' : ''}}</text>
          </view>
        </view>
      </view>
      <view class="sheet-foot">
        <view class="sheet-btn" bindtap="onCloseChannelSheet">确认</view>
      </view>
    </view>
  </view>
</view>
