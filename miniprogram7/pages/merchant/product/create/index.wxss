.page { min-height: 100vh; background: #F2F2F7; padding: 0; box-sizing: border-box; display: flex; flex-direction: column; }

/* 连续表单滚动容器：高度 = 视口 - 顶部锚点栏 - 底部按钮条。
   不给固定高度的话 scroll-into-view 没有可滚区域，点标题不会动。 */
.form-scroll { flex: 1; height: calc(100vh - 88rpx - 140rpx - env(safe-area-inset-bottom)); box-sizing: border-box; padding-bottom: 40rpx; }
.form-section { display: block; }

/* ===== 卡片 ===== */
/* .page 改成 flex 容器后，第 1 步（选品类/类型）的卡片是直接 flex 子项，
   不加 flex-shrink:0 会被按剩余空间拉伸变形 */
.card { background: #fff; border-radius: 0; padding: 28rpx 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02); flex-shrink: 0; }
.card-title { font-size: 32rpx; font-weight: 600; color: #1F1F1F; margin-bottom: 24rpx; }

/* ===== 行（标签 + 值） ===== */
.row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; gap: 16rpx; }
.row:last-child { border-bottom: none; }
.row.column { flex-direction: column; align-items: stretch; gap: 12rpx; }
.row-head { display: flex; justify-content: space-between; align-items: center; }
.row-label { display: inline-flex; align-items: center; font-size: 30rpx; color: #1F1F1F; flex-shrink: 0; }
.row-counter { font-size: 24rpx; color: #BBB; }
.row-value { display: flex; align-items: center; gap: 8rpx; font-size: 30rpx; color: #1F1F1F; }
/* 行内输入框（价格/库存这类）：原来 max-width 只有 360rpx，
   叠上左侧标签后可视区不到半屏，输入「1288.00」这种就看不全了。
   放宽到 440rpx 并给 min-width 兜底，短标签行也能有像样的输入区。 */
.row-value.with-input { background: #F7F8FA; border-radius: 12rpx; padding: 16rpx 20rpx; flex: 1; min-width: 300rpx; max-width: 440rpx; }
/* 整行输入框（商品名称 / 副标题）：商家反馈「输入框太窄看不清文字」——
   原先 padding 20rpx、无最小高度，输入长商品名时文字挤在一条细缝里。
   现在给足高度和行高，与后台的输入体验对齐。 */
.row-input { width: 100%; min-height: 88rpx; line-height: 48rpx; background: #F7F8FA; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx; color: #1F1F1F; box-sizing: border-box; }
.row-textarea { width: 100%; min-height: 200rpx; background: #F7F8FA; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx; color: #1F1F1F; box-sizing: border-box; }
.row-tip { font-size: 24rpx; color: #999; line-height: 1.5; margin-top: 4rpx; }

.placeholder { color: #BBB; }
.value { color: #1F1F1F; }
.arrow { color: #C8C8C8; font-size: 32rpx; margin-left: 4rpx; }
.required { color: #FF4D4F; margin-right: 4rpx; }
.ipt-prefix { color: #999; font-size: 30rpx; margin-right: 8rpx; }
.ipt-suffix { color: #999; font-size: 26rpx; margin-left: 8rpx; }
.ipt-inline { flex: 1; background: transparent; font-size: 30rpx; text-align: right; padding: 0; }

/* ===== 只读行 ===== */
.readonly-row { display: flex; flex-direction: column; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; gap: 12rpx; }
.readonly-row .row-label { display: flex; align-items: center; gap: 12rpx; }
.readonly-tag { font-size: 22rpx; color: #999; background: #F0F0F0; padding: 4rpx 12rpx; border-radius: 6rpx; }
.readonly-value { font-size: 30rpx; color: #595959; }

/* ===== 规则行（点跳转的） ===== */
.rule-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; gap: 16rpx; }
.link { color: #1677FF; font-size: 28rpx; }

/* ===== tab 栏 ===== */
/* 锚点导航栏：放在 scroll-view 外面，所以用 flex-shrink 固定住而不是 sticky
   （sticky 在 scroll-view 兄弟节点上不生效，会跟着页面一起滚走） */
.tab-bar { display: flex; background: #fff; padding: 0 16rpx; border-bottom: 1rpx solid #F0F0F0; flex-shrink: 0; z-index: 10; }
.tab-item { flex: 1; padding: 28rpx 0; text-align: center; font-size: 28rpx; color: #595959; position: relative; }
.tab-item.active { color: #1F1F1F; font-weight: 600; }
.tab-line { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 6rpx; background: #1677FF; border-radius: 4rpx; }

/* ===== 底部按钮 ===== */
.next-bar { padding: 32rpx 24rpx; flex-shrink: 0; }
.next-btn { background: linear-gradient(90deg, #4A90E2 0%, #1677FF 100%); color: #fff; border-radius: 16rpx; font-size: 32rpx; padding: 28rpx 0; text-align: center; }
.next-btn.disabled { background: #B5C9FF; color: #fff; }

.footer { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); display: flex; gap: 16rpx; box-sizing: border-box; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); z-index: 10; }
.btn-preview { width: 200rpx; background: #fff; color: #1677FF; border: 2rpx solid #1677FF; border-radius: 16rpx; font-size: 30rpx; padding: 24rpx 0; text-align: center; }
.btn-submit { flex: 1; background: linear-gradient(90deg, #4A90E2 0%, #1677FF 100%); color: #fff; border-radius: 16rpx; font-size: 32rpx; padding: 24rpx 0; text-align: center; }
.btn-submit.disabled { background: #B5C9FF; color: #fff; }

/* ===== 弹窗 ===== */
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 80vh; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; border-bottom: 1rpx solid #F0F0F0; }
.sheet-title { font-size: 32rpx; font-weight: 600; color: #1F1F1F; flex: 1; text-align: center; }
.sheet-close { font-size: 44rpx; color: #999; width: 44rpx; height: 44rpx; line-height: 36rpx; text-align: center; }
.sheet-body { flex: 1; overflow-y: auto; padding: 20rpx 32rpx; }
.sheet-tip { font-size: 26rpx; color: #999; padding: 20rpx 0; }
.sheet-item { padding: 28rpx 0; font-size: 30rpx; color: #1F1F1F; border-bottom: 1rpx solid #F5F5F5; }
.sheet-item:last-child { border-bottom: none; }
.sheet-foot { padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #F0F0F0; }
.sheet-btn { background: linear-gradient(90deg, #4A90E2 0%, #1677FF 100%); color: #fff; border-radius: 16rpx; font-size: 32rpx; padding: 28rpx 0; text-align: center; }

/* 类型卡片 */
.type-card { position: relative; padding: 28rpx 24rpx; border: 2rpx solid #F0F0F0; border-radius: 16rpx; margin-bottom: 16rpx; }
.type-card.disabled { opacity: 0.6; }
.type-card-name { font-size: 30rpx; font-weight: 600; color: #1F1F1F; margin-bottom: 8rpx; }
.type-card-desc { font-size: 24rpx; color: #999; }
.type-card-tip { margin-top: 12rpx; padding: 12rpx 16rpx; background: #FFF7E6; border-radius: 8rpx; font-size: 24rpx; color: #FF7A45; }

/* ===== 选项组（售后政策 / 券码类型 这类 2-3 选一） ===== */
.opt-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.opt { padding: 16rpx 28rpx; background: #F7F8FA; border: 2rpx solid #F7F8FA; border-radius: 12rpx; font-size: 28rpx; color: #595959; }
.opt.on { background: #EAF2FF; border-color: #1677FF; color: #1677FF; font-weight: 600; }

/* ===== 多选弹窗条目（门店 / 渠道） ===== */
.sheet-item.pick { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.sheet-item.on { color: #FF4D3A; font-weight: 600; }
.pick-mark { width: 40rpx; text-align: center; font-size: 32rpx; color: transparent; }
.pick-mark.on { color: #1677FF; }
.ch-group { margin-bottom: 12rpx; }
.ch-group-title { font-size: 24rpx; color: #999; padding: 20rpx 0 4rpx; }
.ch-text { display: flex; flex-direction: column; gap: 6rpx; flex: 1; }
.ch-desc { font-size: 22rpx; color: #999; line-height: 1.4; }
