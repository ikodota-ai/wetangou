.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx 24rpx 80rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.head { display: flex; align-items: center; justify-content: space-between; }
.identity-badge { background: #3A6B35; color: #fff; font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 20rpx; }
.ipt-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.ipt-label { width: 180rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.ipt { flex: 1; background: #F2F2F7; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #333; }
.ipt-area { width: 100%; min-height: 140rpx; background: #F2F2F7; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #333; box-sizing: border-box; }
.type-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.type-cell { background: #F2F2F7; border-radius: 12rpx; padding: 20rpx 12rpx; text-align: center; font-size: 26rpx; color: #555; }
.type-cell.active { background: #3A6B35; color: #fff; font-weight: 600; }
.type-cell.disabled { background: #EEE; color: #AAA; }
.type-desc { font-size: 22rpx; color: #999; margin-top: 6rpx; line-height: 1.3; }
.type-cell.active .type-desc { color: rgba(255,255,255,0.8); }
.toggle-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.toggle-label { flex: 1; font-size: 28rpx; color: #555; }
.btn-primary { width: 100%; background: #3A6B35; color: #fff; border-radius: 16rpx; font-size: 32rpx; padding: 24rpx 0; margin-top: 20rpx; border: none; }
.btn-primary[disabled] { background: #B5C9AF; color: #fff; }
.tip { font-size: 24rpx; color: #999; line-height: 1.5; }
