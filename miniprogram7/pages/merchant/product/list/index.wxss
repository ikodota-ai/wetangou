.page { padding: 0; background: #f5f5f7; min-height: 100vh; padding-bottom: 80px; }

/* 顶部导航 */
.nav { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #fff; position: sticky; top: 0; z-index: 10; }
.nav-back { font-size: 24px; color: #161823; width: 24px; }
.nav-title { font-size: 17px; font-weight: 600; color: #161823; }
.nav-more { font-size: 14px; color: #161823; }

/* Tab: 团购/品牌 + 全部门店 */
.tab-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #fff; border-bottom: 1px solid #f0f0f0; }
.tab-bar .tab { font-size: 16px; color: #555; margin-right: 24px; padding: 4px 0; position: relative; }
.tab-bar .tab.active { color: #1677FF; font-weight: 600; }
.tab-bar .tab.active::after { content: ''; position: absolute; left: 50%; bottom: -4px; transform: translateX(-50%); width: 24px; height: 2px; background: #1677FF; border-radius: 1px; }
.store-pick { display: flex; align-items: center; gap: 4px; font-size: 13px; color: #161823; padding: 6px 10px; background: #f5f5f7; border-radius: 16px; }
.store-icon { font-size: 14px; }
.arrow { font-size: 10px; color: #999; }

/* 状态 Tab */
.status-bar { display: flex; white-space: nowrap; background: #fff; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
.status-tab { display: inline-block; padding: 8px 16px; font-size: 14px; color: #555; position: relative; flex-shrink: 0; }
.status-tab.active { color: #1677FF; font-weight: 600; }
.status-tab.active::after { content: ''; position: absolute; left: 16px; right: 16px; bottom: 0; height: 2px; background: #1677FF; border-radius: 1px; }
.status-tab .cnt { font-size: 12px; color: #999; margin-left: 2px; }
.status-tab.active .cnt { color: #1677FF; }

/* 工具栏 */
.toolbar { display: flex; align-items: center; padding: 10px 16px; background: #fff; }
.sort { display: flex; align-items: center; gap: 4px; font-size: 13px; color: #161823; }
.spacer { flex: 1; }
.tool { display: flex; align-items: center; gap: 3px; font-size: 12px; color: #555; margin-left: 14px; }
.tool .ico { font-size: 14px; }

/* 列表 */
.loading, .empty { text-align: center; padding: 60px 0; color: #999; }
.empty-btn { display: inline-block; margin-top: 16px; padding: 8px 20px; background: #1677FF; color: #fff; border-radius: 20px; font-size: 13px; }
.list { padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
.item { background: #fff; border-radius: 8px; padding: 12px; }
.item-top { display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 10px; }
.dot { width: 8px; height: 8px; border-radius: 50%; }
.dot.on { background: #00C853; }
.dot.off { background: #ccc; }
.state { color: #161823; font-weight: 500; }
.sep { color: #ddd; }
.muted { color: #999; }

.item-body { display: flex; gap: 12px; }
.cover { width: 96px; height: 96px; border-radius: 4px; background: #f0f0f0; flex-shrink: 0; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.name { font-size: 15px; font-weight: 600; color: #161823; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.sub { font-size: 12px; color: #1677FF; }
.meta-line { font-size: 12px; }
.meta-line .val { color: #161823; font-weight: 500; }
.tag { display: inline-block; padding: 1px 8px; font-size: 11px; border-radius: 3px; align-self: flex-start; }
.tag.GROUPON, .tag.COMBO { background: #e8f4ff; color: #1677FF; }
.tag.VOUCHER { background: #fff7e8; color: #fa8c16; }
.tag.TIMECARD, .tag.STORED_CARD, .tag.PERIOD_CARD, .tag.HUIXIANG_CARD { background: #fff0f0; color: #f5222d; }
.price-line { display: flex; align-items: center; gap: 6px; margin-top: 2px; }
.price { font-size: 18px; color: #f5222d; font-weight: 600; }
.origin { font-size: 12px; color: #999; text-decoration: line-through; }
.promote { font-size: 12px; color: #555; background: #f5f5f7; padding: 2px 6px; border-radius: 3px; }
.qmark { width: 14px; height: 14px; border-radius: 50%; background: #ddd; color: #fff; font-size: 10px; text-align: center; line-height: 14px; }

.item-bot { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 1px dashed #eee; }
.more { font-size: 13px; color: #555; }
.ops { display: flex; gap: 8px; }
.op { padding: 4px 12px; border: 1px solid #e8e8e8; border-radius: 4px; font-size: 12px; color: #555; }
.op.primary { color: #1677FF; border-color: #1677FF; }

/* 底部 */
.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 10px 16px; display: flex; align-items: center; gap: 12px; box-shadow: 0 -2px 8px rgba(0,0,0,.05); }
.hot-deal { position: relative; display: flex; flex-direction: column; align-items: center; padding: 4px 12px; flex-shrink: 0; }
.hot-deal .badge { position: absolute; top: -4px; right: 0; background: #ff4d4f; color: #fff; font-size: 10px; padding: 1px 4px; border-radius: 6px 6px 0 0; }
.hot-deal text { font-size: 13px; color: #161823; }
.create-btn { flex: 1; background: linear-gradient(135deg, #1677FF 0%, #4096FF 100%); color: #fff; text-align: center; padding: 12px; border-radius: 24px; font-size: 15px; font-weight: 500; }
