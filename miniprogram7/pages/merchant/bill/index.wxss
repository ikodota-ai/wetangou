.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.head { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.sub { font-size: 24rpx; color: #888; }
.empty { text-align: center; padding: 200rpx 0; color: #999; font-size: 28rpx; }
.item .row1 { display: flex; justify-content: space-between; align-items: center; }
.no { font-size: 24rpx; color: #888; }
.amount { font-size: 36rpx; color: #F56C6C; font-weight: 600; }
.item .row2 { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.meta { font-size: 24rpx; color: #888; }
.status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.s-0 { background: #FDF6EC; color: #E6A23C; }
.s-1 { background: #ECF5FF; color: #409EFF; }
.s-2 { background: #F0F9EB; color: #67C23A; }
.s-3 { background: #FEF0F0; color: #F56C6C; }
.item .row3 { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.time { font-size: 22rpx; color: #AAA; }
.btn { background: #5A8A4A; color: #fff; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.btn:active { opacity: 0.7; }
