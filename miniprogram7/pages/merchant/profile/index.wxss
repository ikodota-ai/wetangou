.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx 32rpx 60rpx; box-sizing: border-box; }
.hint { font-size: 24rpx; color: #888; line-height: 1.6; margin-bottom: 24rpx; padding: 0 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 8rpx 32rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.form-item { display: flex; align-items: center; height: 110rpx; border-bottom: 1rpx solid #F0F0F0; }
.form-item:last-child { border-bottom: none; }
.lab { width: 160rpx; font-size: 30rpx; color: #333; flex-shrink: 0; }
.ipt { flex: 1; font-size: 30rpx; color: #1A1A1A; height: 60rpx; }
.btns { margin-top: 40rpx; }
.btn-primary {
  width: 100%; height: 88rpx; background: #3A6B35; color: #fff; border-radius: 44rpx;
  font-size: 32rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; border: none;
}
.btn-primary[disabled] { opacity: 0.5; }
