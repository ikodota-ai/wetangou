<view class="page">
  <view class="head card">
    <text class="title">今日买单流水</text>
    <text class="sub">共 {{list.length}} 条</text>
  </view>
  <view class="empty" wx:if="{{!list.length && loaded}}">
    <text>今日还没有买单记录</text>
  </view>
  <view class="list" wx:else>
    <view class="item card" wx:for="{{list}}" wx:key="billId">
      <view class="row1">
        <text class="no">{{item.billNo}}</text>
        <text class="amount">¥{{item.payAmount}}</text>
      </view>
      <view class="row2">
        <text class="meta">金额 ¥{{item.amount}}  优惠 ¥{{item.discountAmount}}</text>
        <text class="status s-{{item.status}}">{{statusText(item.status)}}</text>
      </view>
      <view class="row3">
        <text class="time">{{item.createTimeStr}}</text>
        <view class="btn" wx:if="{{item.status === '0'}}" data-id="{{item.billId}}" bindtap="onConfirm">确认买单</view>
      </view>
    </view>
  </view>
</view>
