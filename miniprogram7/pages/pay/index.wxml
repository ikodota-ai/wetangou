<view class="page">
  <view class="head">
    <text class="h-name">{{store.name || (_storeLoadTimedOut ? '门店加载失败' : '门店加载中…')}}</text>
    <text class="h-addr">{{store.address}}</text>
  </view>

  <view class="card">
    <text class="block-title">消费总金额</text>
    <view class="amount-box">
      <text class="yen">¥</text>
      <input class="amount-in" type="digit" value="{{total}}" bindinput="onTotal" placeholder="请输入消费金额" disabled="{{!!billId}}" />
    </view>
  </view>

  <view class="card">
    <text class="no-disc">不参与优惠金额</text>
    <view class="amount-box">
      <text class="yen">¥</text>
      <input class="amount-in" type="digit" value="{{noDiscount}}" bindinput="onNoDiscount" placeholder="没有则不填" disabled="{{!!billId}}" />
    </view>
  </view>

  <view class="card voucher" bindtap="openVoucher">
    <text class="v-t">代金券{{voucherCount}}张可用</text>
    <text class="v-s">{{voucherText}} ></text>
  </view>

  <view class="card pay-row">
    <text class="p-lab">实付金额</text>
    <view class="p-right">
      <text class="p-disc" wx:if="{{discount !== '0.00'}}">已优惠 ¥{{discount}}</text>
      <text class="p-val">¥{{realPay}}</text>
    </view>
  </view>

  <view class="card tip-row" wx:if="{{billId}}">
    <text class="t-no">买单号 {{billNo}}</text>
    <text class="t-st" wx:if="{{status === '0'}}">等待门店确认金额...</text>
    <text class="t-st" wx:elif="{{status === '1'}}">请完成支付</text>
    <text class="t-st" wx:elif="{{status === '2'}}">已支付</text>
  </view>

  <view class="bottom-bar">
    <!-- waiting 只在门店关掉了「买单自动确认」时才为 true；
         默认门店建单即待支付，按钮不会出现「等待门店确认」这个态。 -->
    <view class="pay-btn {{waiting ? 'off' : ''}}" bindtap="onPay">
      {{waiting ? '等待门店确认...' : (billId ? '继续支付' : '立即支付')}}
    </view>
  </view>

  <!-- 代金券选择 -->
  <view class="mask" wx:if="{{showVoucher}}" bindtap="closeVoucher"></view>
  <view class="sheet" wx:if="{{showVoucher}}">
    <view class="sheet-head">
      <text class="sh-t">选择代金券</text>
      <text class="sh-c" bindtap="closeVoucher">关闭</text>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="v-item none" bindtap="clearVoucher">
        <text class="vi-name">不使用代金券</text>
      </view>
      <view class="v-item {{item.usable ? '' : 'dis'}}" wx:for="{{voucherList}}" wx:key="id"
            data-id="{{item.id}}" bindtap="pickVoucher">
        <view class="vi-left">
          <text class="vi-face">¥{{item.faceValue}}</text>
          <text class="vi-cond">满{{item.threshold}}可用</text>
        </view>
        <view class="vi-right">
          <text class="vi-exp" wx:if="{{item.expireText}}">{{item.expireText}} 到期</text>
          <!-- 不可用的原因要说清楚：只写"不可用"用户不知道是差门槛还是限门店 -->
          <text class="vi-tag" wx:if="{{!item.usable}}">{{item.limitText || '不可用'}}</text>
        </view>
      </view>
      <view class="v-empty" wx:if="{{!voucherList.length}}">
        <text>暂无可用代金券</text>
      </view>
    </scroll-view>
  </view>
</view>
