.page { min-height: 100vh; background: var(--color-bg); padding: 0 0 200rpx; }
.head { padding: 32rpx; display: flex; flex-direction: column; gap: 8rpx; }
.h-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.h-addr { font-size: 24rpx; color: #999; }
.card { background: #FFFFFF; border-radius: 0; padding: 32rpx; margin-bottom: 24rpx; }
.block-title { font-size: 28rpx; color: #1A1A1A; display: block; margin-bottom: 24rpx; }
.amount-box { display: flex; align-items: center; gap: 12rpx; background: #F7F7F7; border-radius: 12rpx; padding: 24rpx; }
.yen { font-size: 32rpx; color: #1A1A1A; font-weight: 600; }
.amount-in { flex: 1; font-size: 30rpx; color: #1A1A1A; }
.no-disc { font-size: 28rpx; color: #1A1A1A; display: block; margin-bottom: 24rpx; }
.voucher { display: flex; align-items: center; justify-content: space-between; }
.v-t { font-size: 28rpx; color: #1A1A1A; }
.v-s { font-size: 28rpx; color: #1A1A1A; }
.pay-row { display: flex; justify-content: space-between; align-items: center; }
.p-lab { font-size: 28rpx; color: #1A1A1A; }
.p-val { font-size: 36rpx; font-weight: 700; color: var(--color-primary); }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx; background: #FFFFFF; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.pay-btn { width: 100%; height: 96rpx; line-height: 96rpx; text-align: center; background: var(--color-primary); color: #FFFFFF; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; }
.p-right { display: flex; flex-direction: column; align-items: flex-end; }
.p-disc { font-size: 24rpx; color: #E64340; margin-bottom: 6rpx; }
.tip-row { display: flex; flex-direction: column; gap: 8rpx; }
.t-no { font-size: 26rpx; color: #666; }
.t-st { font-size: 26rpx; color: var(--color-primary); }
.pay-btn.off { opacity: 0.6; }
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 10; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #FFFFFF; border-radius: 24rpx 24rpx 0 0; z-index: 11; max-height: 70vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; border-bottom: 1rpx solid #F0F0F0; }
.sh-t { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.sh-c { font-size: 28rpx; color: #999; }
.sheet-body { flex: 1; padding: 16rpx 32rpx 32rpx; }
.v-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.v-item.dis { opacity: 0.45; }
.v-item.none { justify-content: center; }
.vi-left { display: flex; flex-direction: column; }
.vi-face { font-size: 34rpx; font-weight: 700; color: #E64340; }
.vi-cond { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.vi-right { display: flex; flex-direction: column; align-items: flex-end; }
.vi-exp { font-size: 24rpx; color: #999; }
.vi-tag { font-size: 22rpx; color: #E6A23C; margin-top: 6rpx; }
.vi-name { font-size: 28rpx; color: #666; }
.v-empty { padding: 60rpx 0; text-align: center; font-size: 28rpx; color: #999; }
