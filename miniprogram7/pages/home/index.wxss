.banner { width: 100%; height: 360rpx; padding: 24rpx 32rpx 0; box-sizing: border-box; background: linear-gradient(180deg, #3A6B35 0%, #7AAA5A 60%, #F2F2F7 100%); }
.banner-img { width: 100%; height: 312rpx; border-radius: 24rpx 24rpx 0 0; }

.store-card { margin: -40rpx 32rpx 0; padding: 32rpx; display: flex; flex-direction: column; gap: 16rpx; position: relative; z-index: 5; }
.sc-head { display: flex; align-items: center; justify-content: space-between; }
.s-name { font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.pay-btn { width: 128rpx; height: 72rpx; line-height: 72rpx; text-align: center; background: var(--color-primary); color: #FFFFFF; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.s-rating { display: flex; align-items: center; gap: 6rpx; }
.star { width: 28rpx; height: 28rpx; background: #E8E8E8; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.s-score { font-size: 24rpx; color: var(--color-text-4); margin-left: 8rpx; }
.s-hours { font-size: 24rpx; color: var(--color-text-2); }
.tags { display: flex; align-items: center; gap: 16rpx; }
.tag { font-size: 22rpx; color: var(--color-primary); background: var(--color-tag-green-bg); padding: 4rpx 16rpx; border-radius: 8rpx; }
.detail { margin-left: auto; font-size: 24rpx; color: var(--color-text-4); }

.s-addr { background: #F7F7F7; border-radius: 16rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.addr-txt { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.a1 { font-size: 26rpx; font-weight: 600; color: #1A1A1A; }
.a2 { font-size: 22rpx; color: var(--color-text-4); }
.addr-ops { display: flex; gap: 24rpx; }
.op { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.op-ic { width: 64rpx; height: 64rpx; border-radius: 50%; background: #ECECEC; display: flex; align-items: center; justify-content: center; }
.op text { font-size: 22rpx; color: var(--color-text-2); }
.ic-nav { width: 32rpx; height: 32rpx; background: var(--color-primary); clip-path: polygon(50% 0%, 100% 100%, 70% 100%, 70% 75%, 30% 75%, 30% 100%, 0 100%); }
.ic-tel { width: 30rpx; height: 30rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.ic-tel::after { content: ''; position: absolute; left: 6rpx; bottom: 4rpx; width: 8rpx; height: 8rpx; background: var(--color-primary); border-radius: 50%; }

.entries { display: flex; align-items: center; padding: 24rpx 0; margin-top: 24rpx; }
.entry { flex: 1; display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 0 16rpx; }
.e-txt { display: flex; flex-direction: column; gap: 6rpx; }
.e-ttl { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.e-sub { font-size: 22rpx; color: var(--color-text-4); }
.e-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: var(--color-tag-green-bg); display: flex; align-items: center; justify-content: center; }
.ic-clock { width: 32rpx; height: 32rpx; border: 4rpx solid var(--color-primary); border-radius: 50%; position: relative; }
.ic-clock::before, .ic-clock::after { content: ''; position: absolute; left: 50%; top: 50%; background: var(--color-primary); }
.ic-clock::before { width: 4rpx; height: 14rpx; transform: translate(-50%, -100%); }
.ic-clock::after { width: 12rpx; height: 4rpx; transform: translate(-100%, -2rpx) rotate(45deg); }
.ic-chat { width: 36rpx; height: 30rpx; border: 4rpx solid var(--color-primary); border-radius: 12rpx 12rpx 12rpx 0; position: relative; }
.ic-chat::before { content: ''; position: absolute; left: 6rpx; top: 10rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: var(--color-primary); box-shadow: 8rpx 0 0 var(--color-primary), 16rpx 0 0 var(--color-primary); }
.vline { width: 1rpx; height: 56rpx; background: #EEE; }

.tabs { display: flex; background: #FFFFFF; margin: 24rpx 32rpx 0; border-radius: 20rpx 20rpx 0 0; padding: 0 32rpx; }
.tab { position: relative; height: 80rpx; margin-right: 48rpx; display: flex; align-items: center; }
.tab text { font-size: 30rpx; color: #999; }
.tab.on text { color: #1A1A1A; font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 8rpx; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }

.goods-list { background: #FFFFFF; margin: 0 32rpx 24rpx; border-radius: 0 0 20rpx 20rpx; padding: 0 32rpx; }
.goods { display: flex; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.goods:last-child { border-bottom: none; }
.g-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; flex-shrink: 0; }
.g-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.g-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; line-height: 1.4; }
.g-desc { font-size: 22rpx; color: #999; }
.g-sold { font-size: 22rpx; color: #999; }
.g-bottom { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; }
.g-price { display: flex; align-items: baseline; gap: 12rpx; }
.g-price .now { font-size: 36rpx; font-weight: 700; color: #E8734A; }
.g-price .old { font-size: 22rpx; color: #999; text-decoration: line-through; }
.g-buy { width: 108rpx; height: 56rpx; line-height: 56rpx; text-align: center; background: var(--color-primary); color: #FFFFFF; border-radius: 28rpx; font-size: 26rpx; font-weight: 500; }

.book-panel { background: #FFFFFF; margin: 0 32rpx 24rpx; border-radius: 0 0 20rpx 20rpx; padding: 24rpx 32rpx; }
.bp-card { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.bp-img { width: 128rpx; height: 128rpx; border-radius: 16rpx; }
.bp-txt { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.bp-ttl { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.bp-sub { font-size: 24rpx; color: #999; }
.bp-arr { width: 24rpx; height: 24rpx; border-right: 4rpx solid #CCC; border-top: 4rpx solid #CCC; transform: rotate(45deg); margin-right: 16rpx; }

/* 设施抽屉 */
.drawer-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: flex-end; }
.drawer { width: 100%; background: #FFFFFF; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 0 400rpx; }
.drawer-head { display: flex; align-items: center; justify-content: space-between; padding: 0 32rpx 24rpx; }
.d-title { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.d-close { width: 40rpx; height: 40rpx; position: relative; }
.d-close::before, .d-close::after { content: ''; position: absolute; left: 50%; top: 50%; width: 32rpx; height: 4rpx; background: #999; border-radius: 2rpx; }
.d-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.d-close::after { transform: translate(-50%, -50%) rotate(-45deg); }
.drawer-body { padding: 0 32rpx 122rpx;height:120rpx; display: flex; flex-direction: column; gap: 24rpx; }
.fac-line { font-size: 28rpx; color: #1A1A1A; line-height: 1.8; }
.dot { display: inline-block; width: 16rpx;}

/* 咨询弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 60rpx; }
.consult-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx 40rpx; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.c-title { font-size: 28rpx; color: var(--color-text-4); }
.c-source { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; margin-bottom: 12rpx; }
.c-phone { display: flex; align-items: center; gap: 16rpx; }
.c-tel { font-size: 56rpx; font-weight: 700; color: var(--color-primary); }
.c-call-ic { width: 48rpx; height: 48rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.c-call-ic::after { content: ''; position: absolute; left: 10rpx; bottom: 6rpx; width: 12rpx; height: 12rpx; background: var(--color-primary); border-radius: 50%; }
.c-qr { width: 100%; height: 320rpx; background: #F7F7F7; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.c-qr-txt { font-size: 28rpx; color: #999; }
.c-hours { font-size: 24rpx; color: #666; }
.consult-close { margin-top: 48rpx; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center; }
.cc-x { width: 36rpx; height: 36rpx; position: relative; }
.cc-x::before, .cc-x::after { content: ''; position: absolute; left: 50%; top: 50%; width: 40rpx; height: 4rpx; background: #FFFFFF; border-radius: 2rpx; }
.cc-x::before { transform: translate(-50%, -50%) rotate(45deg); }
.cc-x::after { transform: translate(-50%, -50%) rotate(-45deg); }

/* 客服二维码预览 */
.c-qr-img { width: 320rpx; height: 320rpx; }

/* 领券中心入口 */
.voucher-entry { margin-top: 24rpx; background: linear-gradient(90deg, #FDEDE9, #FFFFFF); border-radius: 20rpx; padding: 28rpx 32rpx; display: flex; align-items: center; justify-content: space-between; }
.ve-left { display: flex; flex-direction: column; gap: 6rpx; }
.ve-t { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.ve-sub { font-size: 22rpx; color: #999; }
.ve-btn { padding: 14rpx 32rpx; background: var(--color-danger); color: #FFFFFF; border-radius: 999rpx; font-size: 26rpx; }

/* 切换到商家端 浮层 */
.staff-fab {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  padding: 8rpx 20rpx;
  background: rgba(58, 107, 53, 0.92);
  color: #fff;
  font-size: 22rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.staff-fab-t { color: #fff; font-size: 22rpx; }
