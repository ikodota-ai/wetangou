<view class="page">
  <!-- 自定义绿色顶栏 -->
  <!-- <view class="topbar" style="height: {{statusBarHeight + 44}}px; padding-top: {{statusBarHeight}}px;">
    <view class="topbar-inner">
      <view class="placeholder"></view>
      <text class="title">首页</text>
      <view class="placeholder"></view>
    </view>
  </view>
  <view class="topbar-pad" style="height: {{statusBarHeight + 44}}px;"></view> -->

  <view class="content safe-bottom">
    <!-- 轮播 -->
    <swiper class="banner" indicator-dots autoplay circular bindchange="onBannerChange">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-id="{{item.id}}">
        <image class="banner-img" src="{{item.src}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <!-- 门店卡 -->
    <view class="store-card card">
      <view class="sc-head">
        <text class="s-name">{{store.name}}</text>
        <view class="pay-btn" bindtap="goPay">买单</view>
      </view>
      <!-- 评分取门店 rating 字段（后台「门店管理」手工维护，0.0-5.0）。
           没填时整行不渲染 —— 显示「暂无评分」或 5 颗灰星都会被当成差评。 -->
      <view class="s-rating" wx:if="{{store.hasRating}}">
        <view class="star {{index < store.ratingStars ? 'star-on' : ''}}"
              wx:for="{{[0,1,2,3,4]}}" wx:key="*this"></view>
        <text class="s-score">{{store.ratingText}}</text>
      </view>
      <view class="s-hours">营业时间：{{store.hours}}</view>
      <!-- 标签取后端 /api/store/{id}/services（门店 services 字段经字典翻译），
           原先硬编码「可堂食/可预约」，门店实际没配这两项时是在骗用户 -->
      <view class="tags">
        <text class="tag" wx:for="{{facilityTags}}" wx:key="*this">{{item}}</text>
        <text class="tag tag-empty" wx:if="{{!facilityTags.length}}">暂无服务标签</text>
        <text class="detail" wx:if="{{facilities.length}}" bindtap="openFacility">详情 ></text>
      </view>
      <view class="s-addr">
        <view class="addr-txt">
          <text class="a1">{{store.address}}</text>
          <!-- 有距离就显示，没有就给个可点的「查看距离」（点了才取位，
               避免一进首页就弹授权框；原先恒显示「计算中…」且永远不会变） -->
          <text class="a2" wx:if="{{store.hasDistance}}">距您{{store.distanceText}}</text>
          <text class="a2 a2-act" wx:else catchtap="requestDistance">查看距离 ></text>
        </view>
        <view class="addr-ops">
          <view class="op" bindtap="goLocation">
            <view class="op-ic ic-nav"></view>
            <text>导航</text>
          </view>
          <view class="op" bindtap="goService">
            <view class="op-ic ic-tel"></view>
            <text>联系商家</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 双入口 -->
    <view class="entries card">
      <view class="entry" bindtap="goBooking">
        <view class="e-txt">
          <text class="e-ttl">预约到店</text>
          <text class="e-sub">在线选时段</text>
        </view>
        <view class="e-ic ic-clock"></view>
      </view>
      <view class="vline"></view>
      <view class="entry" bindtap="openConsult">
        <view class="e-txt">
          <text class="e-ttl">在线咨询</text>
          <text class="e-sub">快速询问商家</text>
        </view>
        <view class="e-ic ic-chat"></view>
      </view>
    </view>

    <!-- Tab + 列表 -->
    <view class="tabs">
      <view class="tab {{tab==='pickup'?'on':''}}" data-t="pickup" bindtap="switchTab">
        <text>到店自取</text>
        <view class="tab-bar"></view>
      </view>
      <view class="tab {{tab==='book'?'on':''}}" data-t="book" bindtap="switchTab">
        <text>预约服务</text>
        <view class="tab-bar"></view>
      </view>
    </view>
    
    <view class="goods-list" wx:if="{{tab==='pickup'}}">
      <view class="goods" wx:for="{{goods}}" wx:key="productId" data-id="{{item.productId}}" bindtap="goDetail">
        <image class="g-img" src="{{item.cover}}"></image>
        <view class="g-info">
          <text class="g-name">{{item.name}}</text>
          <text class="g-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          <text class="g-sold">已售 {{item.sold}}</text>
          <view class="g-bottom">
            <view class="g-price">
              <text class="now">¥{{item.price}}</text>
              <text class="old" wx:if="{{item.marketPrice && item.marketPrice != item.price}}">¥{{item.marketPrice}}</text>
            </view>
            <view class="g-buy">抢购</view>
          </view>
        </view>
      </view>
    </view>

    <view class="voucher-entry" wx:if="{{tab==='pickup'}}" bindtap="goVoucher">
      <view class="ve-left">
        <text class="ve-t">领券中心</text>
        <text class="ve-sub">领代金券，到店买单更省</text>
      </view>
      <view class="ve-btn">去领券</view>
    </view>

    <view class="book-panel" wx:else>
      <view class="bp-card" wx:for="{{bookingGoods}}" wx:key="productId" data-id="{{item.productId}}" bindtap="goDetail">
        <image class="bp-img" src="{{item.cover}}"></image>
        <view class="bp-txt">
          <text class="bp-ttl">{{item.name}}</text>
          <text class="bp-sub">{{item.desc}}</text>
          <view class="bp-price">
            <text class="now">¥{{item.price}}</text>
            <text class="old" wx:if="{{item.marketPrice && item.marketPrice != item.price}}">¥{{item.marketPrice}}</text>
          </view>
        </view>
        <view class="bp-arr"></view>
      </view>
      <view class="bp-empty" wx:if="{{bookingLoaded && !bookingGoods.length}}">
        <text class="bp-empty-t">该门店暂未上架预约服务</text>
        <text class="bp-empty-a" bindtap="goBooking">直接发起预约 ></text>
      </view>
      <view class="bp-empty" wx:if="{{!bookingLoaded}}">
        <text class="bp-empty-t">加载中…</text>
      </view>
    </view>
  </view>

  <!-- 设施及服务抽屉 -->
  <view class="drawer-mask" wx:if="{{showFacility}}" catchtap="closeFacility">
    <view class="drawer" catchtap="noop">
      <view class="drawer-head">
        <text class="d-title">设施及服务</text>
        <view class="d-close" bindtap="closeFacility"></view>
      </view>
      <!-- 原先是把所有项拼在一行纯文本里，且 .drawer-body 写死 height:120rpx，
           项目一多就被截断看不全 —— 这就是「详情读不到正确的值和排版」。
           改成每项一行的列表，高度自适应 + 超长可滚动。 -->
      <scroll-view class="drawer-body" scroll-y>
        <view class="fac-grid" wx:if="{{facilities.length}}">
          <view class="fac-item" wx:for="{{facilities}}" wx:key="*this">
            <text class="fac-ic">✓</text>
            <text class="fac-txt">{{item}}</text>
          </view>
        </view>
        <view class="fac-empty" wx:else>该门店暂未配置设施及服务</view>
      </scroll-view>
    </view>
  </view>

  <!-- 在线咨询弹窗 -->
  <view class="modal-mask" wx:if="{{showConsult}}" catchtap="closeConsult">
    <view class="consult-box" catchtap="noop">
      <text class="c-title">客服</text>
      <text class="c-source">{{isStoreService ? '门店客服' : '商家统一客服'}}</text>
      <view class="c-phone" catchtap="callService">
        <text class="c-tel">{{phone || '暂未配置客服电话'}}</text>
        <view class="c-call-ic"></view>
      </view>
      <view class="c-qr" catchtap="previewQrcode">
        <image wx:if="{{qrcode}}" class="c-qr-img" src="{{qrcode}}" mode="aspectFit"></image>
        <text wx:else class="c-qr-txt">暂未配置客服二维码</text>
      </view>
      <text class="c-hours">{{serviceHours ? '客服服务时间 ' + serviceHours : '客服服务时间请咨询门店'}}</text>
    </view>
    <view class="consult-close" catchtap="closeConsult">
      <view class="cc-x"></view>
    </view>
  </view>
</view>
