<!-- 支付完成视图。原先这段被错贴到金额卡内部，且在它后面提前闭合了
     pay-page，导致金额提示/订单信息/支付按钮全都落在根节点外面 -->
<view class="paid-view" wx:if="{{paid}}">
  <view class="paid-icon">✓</view>
  <text class="paid-title">支付成功</text>
  <text class="paid-amount">¥{{amount}}</text>
  <text class="paid-tip">{{paidTip || '订单已支付'}}</text>
  <button class="paid-btn" bindtap="onPaidDone">完成</button>
</view>

<view class="pay-page" wx:else>
  <!-- 金额卡 -->
  <view class="amount-card">
    <view class="amount-row">
      <text class="amount-symbol">¥</text>
      <text class="amount-value">{{amount}}</text>
    </view>
    <text class="amount-tip">请确认订单金额，点击支付后将调起微信支付</text>
  </view>

  <!-- 代金券：下单页提交后是 redirectTo 到本页的，退不回去也没法再选券。
       到店自取正是先下单、到店才付，用户就在这一步想起手里有券 -->
  <view class="info-card" wx:if="{{canUseVoucher}}">
    <view class="info-row voucher-row" bindtap="openVoucher">
      <text class="info-label">优惠券</text>
      <view class="v-right">
        <text class="v-disc" wx:if="{{discount > 0}}">-¥{{discount}}</text>
        <text class="v-tip" wx:elif="{{voucherCount}}">{{voucherCount}}张可用</text>
        <text class="v-none" wx:else>暂无可用</text>
        <text class="v-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 订单信息卡 -->
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderNo}}</text>
    </view>
    <view class="info-row" wx:if="{{payNo}}">
      <text class="info-label">支付单号</text>
      <text class="info-value">{{payNo}}</text>
    </view>
    <view class="info-row" wx:if="{{payInfoId}}">
      <text class="info-label">支付信息ID</text>
      <text class="info-value">{{payInfoId}}</text>
    </view>
    <view class="info-row" wx:if="{{expireTimeText}}">
      <text class="info-label">过期时间</text>
      <text class="info-value">{{expireTimeText}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="info-card pay-method">
    <view class="method-title">选择支付方式</view>
    <view class="method-item on" bindtap="onPickWxPay">
      <view class="method-left">
        <image class="method-icon" src="/assets/img/wxpay.png" mode="aspectFit"></image>
        <text class="method-name">微信支付</text>
      </view>
      <view class="method-check">✓</view>
    </view>
  </view>

  <!-- 占位，避免底部按钮挡住内容 -->
  <view style="height: 280rpx;"></view>

  <!-- 底部固定去支付 -->
  <view class="footer">
    <button class="pay-btn" bindtap="onConfirmPay" loading="{{paying}}" disabled="{{paying}}">去支付</button>
    <view class="cancel-link" bindtap="onCancelPay" wx:if="{{!paying}}">不想付了，取消本单</view>
  </view>

  <!-- 选券弹窗：与下单页 pages/order/submit、详情页 pages/order/detail 保持同一交互 -->
  <view class="mask" wx:if="{{showVoucher}}" bindtap="closeVoucher"></view>
  <view class="sheet" wx:if="{{showVoucher}}">
    <view class="sheet-head">
      <text class="sh-t">选择代金券</text>
      <text class="sh-c" bindtap="closeVoucher">关闭</text>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <view class="v-item none" bindtap="clearVoucher">
        <text class="vi-name">不使用代金券</text>
      </view>
      <view class="v-item {{item.usable ? '' : 'dis'}}" wx:for="{{voucherList}}" wx:key="id"
            data-id="{{item.id}}" bindtap="pickVoucher">
        <view class="vi-left">
          <text class="vi-face">¥{{item.faceValue}}</text>
          <text class="vi-cond">满{{item.threshold}}可用</text>
        </view>
        <view class="vi-right">
          <text class="vi-exp" wx:if="{{item.expireText}}">{{item.expireText}} 到期</text>
          <text class="vi-tag" wx:if="{{!item.usable}}">{{item.limitText || '不可用'}}</text>
        </view>
      </view>
      <view class="v-empty" wx:if="{{!voucherList.length}}">
        <text>暂无代金券，可到首页「领券中心」领取</text>
      </view>
    </scroll-view>
  </view>
</view>
