.pay-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx 24rpx 0;
}

/* 金额卡 */
.amount-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 12rpx;
}
.amount-symbol {
  font-size: 36rpx;
  color: #2f8c4a;
  font-weight: 600;
  margin-right: 6rpx;
}
.amount-value {
  font-size: 80rpx;
  color: #2f8c4a;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.amount-tip {
  font-size: 26rpx;
  color: #909399;
}

/* 信息卡 */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 28rpx;
  color: #606266;
  flex-shrink: 0;
}
.info-value {
  font-size: 28rpx;
  color: #303133;
  text-align: right;
  word-break: break-all;
}

/* 支付方式 */
.pay-method {
  padding: 32rpx;
}
.method-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}
.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9f9f4;
  border: 2rpx solid #b7c9a3;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
}
.method-left {
  display: flex;
  align-items: center;
}
.method-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}
.method-name {
  font-size: 30rpx;
  color: #303133;
}
.method-check {
  font-size: 32rpx;
  color: #2f8c4a;
  font-weight: 700;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}
.pay-btn {
  background: #2f8c4a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
}
.pay-btn[disabled] {
  background: #b4d4be;
  color: #fff;
}
/* 取消入口做成弱化文字链：既要让不想付的用户能退出（否则券被永久锁），
   又不能抢「去支付」的视觉主次 */
.cancel-link {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 0;
}


/* 支付完成态 */
.paid-view { display: flex; flex-direction: column; align-items: center; padding: 120rpx 64rpx 0; }
.paid-icon { width: 160rpx; height: 160rpx; line-height: 160rpx; border-radius: 50%; background: #2E7D32; color: #FFFFFF; font-size: 100rpx; text-align: center; margin-bottom: 32rpx; }
.paid-title { font-size: 40rpx; font-weight: 700; color: #1A1A1A; margin-bottom: 16rpx; }
.paid-amount { font-size: 56rpx; font-weight: 700; color: #E8734A; margin-bottom: 12rpx; }
.paid-tip { font-size: 26rpx; color: #999; margin-bottom: 64rpx; }
.paid-btn { width: 100%; height: 88rpx; line-height: 88rpx; background: var(--color-primary); color: #FFFFFF; border-radius: 44rpx; font-size: 30rpx; font-weight: 600; }

/* 选券入口 + 弹窗。样式与下单页 pages/order/submit、详情页 pages/order/detail 对齐，
   三处必须看起来是同一个交互，否则用户以为是三套不同的东西 */
.voucher-row { display: flex; justify-content: space-between; align-items: center; }
.v-right { display: flex; align-items: center; }
.v-disc { font-size: 28rpx; color: #E64340; }
.v-tip { font-size: 28rpx; color: #E64340; }
.v-none { font-size: 28rpx; color: #909399; }
.v-arrow { font-size: 24rpx; color: #C0C4CC; margin-left: 8rpx; }

.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 60; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #FFFFFF; border-radius: 24rpx 24rpx 0 0; z-index: 61; max-height: 70vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); }
.sheet-head { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; border-bottom: 1rpx solid #F0F0F0; }
.sh-t { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.sh-c { font-size: 28rpx; color: #999; }
.sheet-body { flex: 1; padding: 16rpx 32rpx 32rpx; }
.v-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.v-item.dis { opacity: 0.45; }
.v-item.none { justify-content: center; }
.vi-left { display: flex; flex-direction: column; }
.vi-face { font-size: 34rpx; font-weight: 700; color: #E64340; }
.vi-cond { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.vi-right { display: flex; flex-direction: column; align-items: flex-end; }
.vi-exp { font-size: 24rpx; color: #999; }
.vi-tag { font-size: 22rpx; color: #E6A23C; margin-top: 6rpx; }
.vi-name { font-size: 28rpx; color: #666; }
.v-empty { padding: 60rpx 0; text-align: center; font-size: 28rpx; color: #999; }
