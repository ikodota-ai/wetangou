.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F2E8 0%, #F2F2F7 100%);
  padding-bottom: 40rpx;
}
.top {
  height: 60rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 40rpx 56rpx 56rpx;
}
.card {
  margin: 0 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}
.brand-card {
  /* 顶部品牌卡 */
}
.brand {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 32rpx 0;
}
.perm-title {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: block;
}
.perm-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}
.perm-list {
  margin: 24rpx 0 0;
}
.perm-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
}
.perm-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 14rpx;
  background: #C0C0C0;
  flex-shrink: 0;
}
.perm-dot.ok {
  background: #2BA245;
}
.perm-tip,
.perm-tip-foot {
  font-size: 24rpx;
  color: #888;
  margin-top: 16rpx;
  display: block;
  line-height: 1.6;
}

/* Tab 切换 */
.tabs {
  display: flex;
  margin: 0 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 2rpx 0 rgba(0,0,0,0.02);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #888;
  padding: 32rpx 0 24rpx;
  position: relative;
  font-weight: 500;
}
.tab.on {
  color: #2BA245;
  font-weight: 600;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: #2BA245;
  border-radius: 4rpx;
}

/* 表单卡 */
.form-card {
  /* 共用 .card */
}
.form-tip {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
  display: block;
}
.ipt-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #EEE;
  padding: 24rpx 0;
}
.ipt-row .lab {
  font-size: 30rpx;
  color: #1A1A1A;
  width: 120rpx;
  flex-shrink: 0;
}
.ipt {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  height: 48rpx;
}

/* 扫码加入卡 */
.scan-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx 32rpx;
  border: 2rpx dashed #2BA245;
  background: #F4FAF4;
}
.scan-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #2BA245;
  position: relative;
  flex-shrink: 0;
}
.scan-ic::before,
.scan-ic::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
}
.scan-ic::before {
  width: 32rpx;
  height: 8rpx;
  top: 18rpx;
  left: 24rpx;
}
.scan-ic::after {
  width: 8rpx;
  height: 32rpx;
  top: 24rpx;
  left: 24rpx;
  box-shadow: 32rpx 0 0 #FFFFFF;
}
.scan-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.scan-t {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.scan-d {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}
.arr {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #888;
  border-right: 4rpx solid #888;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 按钮 */
.btns {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.btn-primary {
  background: #2BA245;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  border: none;
}
.btn-primary[disabled] {
  background: #A0D8AC;
  color: #FFFFFF;
}
.btn-ghost {
  background: transparent;
  color: #888;
  font-size: 28rpx;
  border-radius: 48rpx;
  padding: 20rpx 0;
  border: 1rpx solid #DDD;
}

/* 协议 */
.agree {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  color: #888;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #C0C0C0;
  border-radius: 50%;
  margin-right: 12rpx;
  position: relative;
  flex-shrink: 0;
}
.checkbox.on {
  background: #2BA245;
  border-color: #2BA245;
}
.checkbox.on::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 8rpx;
  height: 16rpx;
  border: solid #FFF;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}
.agree-text {
  margin-right: 8rpx;
}
.link {
  color: #2BA245;
  margin: 0 4rpx;
}
