<view class="page">
  <view class="top"></view>
  <view class="title">登录</view>

  <view class="card">
    <view class="brand">胡苏老菌庄</view>
    <view class="divider"></view>
    <view class="perm-title">申请获取以下权限</view>
    <view class="perm-main">获得你的公开信息（昵称、头像、手机号等）</view>
  </view>

  <view class="btns">
    <button class="btn-primary btn-full" bindtap="onLogin" hover-class="none">授权登录</button>
    <button class="btn-ghost btn-full" bindtap="onSkip" hover-class="none">暂不登录</button>
  </view>

  <view class="agree">
    <view class="checkbox {{agreed ? 'on' : ''}}" bindtap="toggleAgree"></view>
    <text class="agree-text">我已阅读并同意</text>
    <text class="link" bindtap="goAgreement" data-type="user">《用户注册协议》</text>
    <text class="agree-text">  </text>
    <text class="link" bindtap="goAgreement" data-type="privacy">《用户隐私协议》</text>
  </view>

  <!-- 头像选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAvatar}}" catchtap="closeAvatar">
    <view class="modal-box" catchtap="noop">
      <view class="m-title">授权头像</view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
        <image class="avatar" src="{{avatarUrl || '/assets/avatar/default.png'}}"></image>
        <text class="avatar-tip">点击选择微信头像</text>
      </button>
      <view class="m-input">
        <input class="nick-input" type="nickname" placeholder="请输入昵称" value="{{nickName}}" bindinput="onNickInput" bindblur="onNickBlur" />
      </view>
      <button class="btn-primary btn-full" bindtap="confirmProfile">确认</button>
      <view class="m-cancel" bindtap="closeAvatar">取消</view>
    </view>
  </view>
</view>
