<view class="page">
  <view class="top"></view>
  <view class="title">登录</view>

  <!-- 顶部品牌卡 -->
  <view class="card brand-card">
    <text class="brand">{{merchantName}}</text>
    <view class="divider"></view>
    <text class="perm-title">申请获取以下权限</text>
    <text class="perm-main">获得你的公开信息（昵称、头像、手机号）</text>
  </view>

  <!-- 主登录区：一键微信登录 -->
  <view class="card form-card">
    <view class="form-tip">点下方按钮一键登录；已绑商家账号将直接进入商家端</view>
    <view class="perm-list">
      <view class="perm-item">
        <view class="perm-dot ok"></view>
        <text>头像和昵称（用于显示身份）</text>
      </view>
      <view class="perm-item">
        <view class="perm-dot ok"></view>
        <text>手机号（用于下单/核销，不用于营销推送）</text>
      </view>
      <view class="perm-item">
        <view class="perm-dot ok"></view>
        <text>已绑 openid 的员工/店长/商家 → 直接进入商家端</text>
      </view>
    </view>
  </view>

  <!-- 主登录按钮 -->
  <view class="btns">
    <button class="btn-primary" bindtap="onWxLogin" hover-class="none" disabled="{{submitting}}">
      {{submitting ? '登录中...' : '微信一键登录'}}
    </button>
    <button class="btn-ghost" bindtap="onSkip" hover-class="none">暂不登录</button>
  </view>

  <!-- 协议 -->
  <view class="agree">
    <view class="checkbox {{agreed ? 'on' : ''}}" bindtap="toggleAgree"></view>
    <text class="agree-text">我已阅读并同意</text>
    <text class="link" bindtap="goAgreement" data-type="user">《用户注册协议》</text>
    <text class="link" bindtap="goAgreement" data-type="privacy">《隐私协议》</text>
  </view>

  <!-- 折叠区：更多登录方式（针对商家账号未绑 openid 的情况） -->
  <view class="more" wx:if="{{hasStaffAccount || showMore}}">
    <view class="more-head" bindtap="toggleMore">
      <text class="more-title">更多登录方式</text>
      <text class="more-arrow {{showMore ? 'up' : 'down'}}">▾</text>
    </view>
    <view class="more-body" wx:if="{{showMore}}">
      <!-- 账号密码登录 -->
      <view class="card sub-form" wx:if="{{!showAccountLogin}}">
        <view class="sub-tip">商家账号密码登录（适用于未绑定微信的账号）</view>
        <view class="ipt-row">
          <text class="lab">账号</text>
          <input class="ipt" type="text" placeholder="请输入账号" value="{{username}}" bindinput="onUsername" maxlength="32" />
        </view>
        <view class="ipt-row">
          <text class="lab">密码</text>
          <input class="ipt" password type="text" placeholder="请输入密码" value="{{password}}" bindinput="onPassword" maxlength="64" />
        </view>
        <button class="btn-primary sub" bindtap="onAccountLogin" hover-class="none" disabled="{{submitting}}">账号密码登录</button>
      </view>
      <!--
        入职扫码入口已移除：小程序码应由微信「扫一扫」直接拉起
        pages/merchant/scan/index，不必先进本登录页。
      -->
      <view class="card scan-tip">
        <text class="scan-tip-t">新员工入职</text>
        <text class="scan-tip-d">用微信「扫一扫」扫描店长分享的「员工邀请码」即可提交入职申请，无需在此登录。</text>
      </view>
    </view>
  </view>
</view>
