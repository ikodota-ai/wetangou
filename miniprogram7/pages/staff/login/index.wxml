<view class="page">
  <view class="top"></view>
  <view class="title">门店员工登录</view>
  <view class="sub">用后台分配的账号登录，可核销团购券 / 确认买单</view>

  <view class="card">
    <view class="form-item">
      <text class="lab">账号</text>
      <input class="ipt" type="text" placeholder="请输入账号" value="{{username}}" bindinput="onUsername" maxlength="32" />
    </view>
    <view class="form-item">
      <text class="lab">密码</text>
      <input class="ipt" password type="text" placeholder="请输入密码" value="{{password}}" bindinput="onPassword" maxlength="64" />
    </view>
    <view class="form-item" wx:if="{{storeName}}">
      <text class="lab">所属门店</text>
      <text class="store">{{storeName}}</text>
    </view>
  </view>

  <view class="btns">
    <button class="btn-primary" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}" hover-class="none">登 录</button>
  </view>

  <view class="hint">
    <text>账号由门店店长或平台管理员在后台分配（系统管理 → 用户管理）。</text>
  </view>
  <view class="back-home" bindtap="goBackHome">
    <text>← 返回会员端</text>
  </view>
</view>
