.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.head .identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 16rpx;
}
.identity-badge {
  display: inline-block;
  background: var(--color-primary, #5A8A4A);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.identity-staff {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
}
.head .store-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.store-label {
  font-size: 26rpx;
  color: #888;
}
.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat-card {
  flex: 1 1 calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary, #5A8A4A);
}
.stat-lab {
  font-size: 24rpx;
  color: #888;
}
.stat-amount {
  font-size: 22rpx;
  color: #AAA;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.modules .module-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.modules .module-item:last-child { border-bottom: none; }
.m-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(90, 138, 74, 0.1);
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.m-verify::before { content: '✓'; position: absolute; left: 0; right: 0; top: 14rpx; text-align: center; font-size: 40rpx; color: #5A8A4A; font-weight: 700; }
.m-bill::before { content: '¥'; position: absolute; left: 0; right: 0; top: 6rpx; text-align: center; font-size: 44rpx; color: #5A8A4A; font-weight: 700; }
.m-booking::before { content: '📋'; position: absolute; left: 0; right: 0; top: 12rpx; text-align: center; font-size: 36rpx; }
.m-orders::before { content: '📦'; position: absolute; left: 0; right: 0; top: 12rpx; text-align: center; font-size: 36rpx; }
.m-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.m-t { font-size: 30rpx; color: #1A1A1A; font-weight: 500; }
.m-d { font-size: 22rpx; color: #999; }
.arr {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #CCC;
  border-right: 2rpx solid #CCC;
  transform: rotate(45deg);
  margin-right: 8rpx;
}

.ro-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.ro-item:last-child { border-bottom: none; }
.ro-left { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.ro-no { font-size: 24rpx; color: #888; }
.ro-name { font-size: 28rpx; color: #1A1A1A; }
.ro-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.ro-amt { font-size: 28rpx; color: #F56C6C; font-weight: 600; }
.ro-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.ro-0 { background: #FDF6EC; color: #E6A23C; }
.ro-1 { background: #ECF5FF; color: #409EFF; }
.ro-2 { background: #F0F9EB; color: #67C23A; }
.ro-3 { background: #F4F4F5; color: #909399; }
.ro-4 { background: #FEF0F0; color: #F56C6C; }

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}
.act {
  flex: 1;
  background: #fff;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.act:active { background: #F5F5F5; }
