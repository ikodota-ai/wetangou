<view class="page">
  <view class="head card">
    <text class="title">今日预约报名</text>
    <text class="sub">共 {{list.length}} 条</text>
  </view>
  <view class="empty" wx:if="{{!list.length && loaded}}">
    <text>今日还没有预约</text>
  </view>
  <view class="list" wx:else>
    <view class="item card" wx:for="{{list}}" wx:key="signupId">
      <view class="row1">
        <text class="name">{{item.contact || '匿名顾客'}}</text>
        <text class="time-slot">{{item.timeSlot || '时间待定'}}</text>
      </view>
      <view class="row2">
        <text class="phone" wx:if="{{item.phone}}">{{item.phone}}</text>
        <text class="people">人数 {{item.people || 1}}</text>
        <text class="status s-{{item.status}}">{{item.status === '1' ? '已取消' : '已报名'}}</text>
      </view>
      <view class="row3" wx:if="{{item.serviceName}}">
        <text class="service">项目：{{item.serviceName}}</text>
      </view>
      <view class="row4" wx:if="{{item.remark}}">
        <text class="remark">备注：{{item.remark}}</text>
      </view>
    </view>
  </view>
</view>
