.page { min-height: 100vh; background: #F2F2F7; padding: 24rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.head { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #D9D9D9; }
.info { display: flex; flex-direction: column; gap: 8rpx; }
.name { font-size: 36rpx; color: #1A1A1A; font-weight: 600; }
.badge { display: inline-block; align-self: flex-start; background: var(--color-primary, #5A8A4A); color: #fff; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx; }
.row { display: flex; align-items: center; }
.lab { width: 160rpx; font-size: 28rpx; color: #888; }
.val { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.act { flex: 1; background: #fff; text-align: center; padding: 24rpx 0; border-radius: 12rpx; font-size: 28rpx; color: #1A1A1A; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.act-warn { color: #F56C6C; }
.row-tap { transition: background 0.2s; }
.row-tap:active { background: #F2F2F7; }
.val-row { display: flex; justify-content: space-between; align-items: center; }
.switch-hint { color: var(--color-primary, #5A8A4A); font-size: 26rpx; }

.picker-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: flex-end; }
.picker-panel { width: 100%; background: #fff; border-top-left-radius: 24rpx; border-top-right-radius: 24rpx; padding: 32rpx 24rpx; box-sizing: border-box; }
.picker-title { text-align: center; font-size: 32rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 24rpx; }
.picker-list { display: flex; flex-direction: column; gap: 8rpx; max-height: 600rpx; overflow-y: auto; }
.picker-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; background: #F7F7F7; border-radius: 12rpx; font-size: 30rpx; color: #1A1A1A; }
.picker-item-active { background: rgba(90,138,74,0.12); color: var(--color-primary, #5A8A4A); font-weight: 600; }
.picker-cur { font-size: 24rpx; color: var(--color-primary, #5A8A4A); }
.picker-cancel { margin-top: 16rpx; text-align: center; padding: 24rpx 0; background: #F2F2F7; border-radius: 12rpx; font-size: 30rpx; color: #888; }
