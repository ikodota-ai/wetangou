<view class="page" wx:if="{{state === 'loaded' && product && product.productId}}">
  <!-- 顶部大图 swiper -->
  <swiper class="hero" circular="{{product.images.length > 1}}"
          current="{{imgIdx}}" bindchange="onSwiperChange">
    <swiper-item wx:for="{{product.images.length ? product.images : [product.cover]}}" wx:key="*this">
      <image class="hero-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
    <view class="hero-page" wx:if="{{product.images.length > 1}}">{{imgIdx + 1}}/{{product.images.length}}</view>
  </swiper>

  <!-- 价格条 -->
  <view class="price-bar">
    <view class="price-l">
      <text class="now">¥{{product.price}}</text>
      <text class="old" wx:if="{{product.marketPrice && product.marketPrice > product.price}}">¥{{product.marketPrice}}</text>
    </view>
    <view class="price-tag" wx:if="{{product.discountText}}">{{product.discountText}}</view>
    <!-- 销量走商户级开关：新品还没卖过就明晃晃写着「已售 0」，对商家是负面信号 -->
    <view class="price-sold" wx:if="{{showSales}}">已售 {{product.sold || 0}}</view>
  </view>

  <!-- 标题 + 须知 -->
  <view class="info card">
    <text class="info-name">{{product.name}}</text>
    <!-- 副标题紧跟商品名：它就是商品名的补充说明（如「含 2 人份锅底」），
         原先在整个详情页上压根没渲染——商家认真填了却从没有顾客看到过 -->
    <text class="info-sub" wx:if="{{product.subtitle}}">{{product.subtitle}}</text>
    <view class="info-row"><text class="lab">类型</text><text class="val type-tag">{{product.typeName}}</text></view>
    <view class="info-row" wx:if="{{product.typeCode === 'VOUCHER' && product.faceValue}}"><text class="lab">面值</text><text class="val">¥{{product.faceValue}}</text></view>
    <view class="info-row" wx:if="{{product.typeCode === 'VOUCHER' && product.minConsume && product.minConsume !== '0.00'}}"><text class="lab">最低消费</text><text class="val">¥{{product.minConsume}}</text></view>
    <view class="info-row" wx:if="{{product.typeCode === 'TIMECARD' && product.totalTimes}}"><text class="lab">总次数</text><text class="val">{{product.totalTimes}} 次</text></view>
    <view class="info-row" wx:if="{{product.typeCode === 'PERIOD_CARD' && product.periodType}}"><text class="lab">周期</text><text class="val">{{product.periodType === 'MONTH' ? '月卡' : product.periodType === 'QUARTER' ? '季卡' : product.periodType === 'YEAR' ? '年卡' : product.periodType}} {{product.periodCount ? '× ' + product.periodCount : ''}}</text></view>
    <view class="info-row" wx:if="{{product.typeCode === 'COMBO' && product.totalValue}}"><text class="lab">总价值</text><text class="val">¥{{product.totalValue}}</text></view>
    <view class="info-row" wx:if="{{product.requireXiaoxin}}"><text class="lab">冷静期</text><text class="val">购买后 {{product.consumeStartDays || 1}} 天起 {{product.consumeValidDays || 360}} 天内有效</text></view>
    <!-- 原先这里还有一行「门店」（storeScopeText），已删：
         页面底部「适用门店」卡已经把可用门店完整列出来了，同一信息说两遍。 -->
    <!-- 服务设施：读门店 biz_store.services（后端已按字典翻译成中文）。
         原先这一行写的是「免预约 / 到店核销」——那是预约方式，不是服务设施，
         而真正的设施（可堂食 / 独立空间 / 免费停车）顾客在商品页上从来看不到。 -->
    <view class="info-row" wx:if="{{storeServices.length}}">
      <text class="lab">服务设施</text>
      <view class="val svc-wrap">
        <text class="svc-tag" wx:for="{{storeServices}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <!-- 预约方式单独一行（原先占用了「服务」这个 label） -->
    <view class="info-row" wx:if="{{product.bookingRequired == 1}}"><text class="lab">预约</text><text class="val">需提前预约</text></view>
    <view class="info-row" wx:elif="{{product.typeCode === 'VOUCHER'}}"><text class="lab">预约</text><text class="val">免预约</text></view>
    <view class="info-row" wx:elif="{{product.typeCode === 'GROUPON' || product.typeCode === 'COMBO'}}"><text class="lab">预约</text><text class="val">免预约 / 到店核销</text></view>
  </view>

  <!-- 类型说明：标题和正文全部读 biz_product_type（type_name / type_tips）。
       原先这里是 5 个 wx:if 并列的卡，标题写死成「团购套餐说明」这种、
       正文也写死在 WXML，且只覆盖 4 种类型（次卡/储值卡/周期卡… 一个都不命中，
       顾客看不到任何解释）。运营在后台改了类型名（GROUPON 已改成「到店自取」）
       顾客端半点不动——字典表形同虚设。 -->
  <view class="card type-intro" wx:if="{{product.typeTips}}">
    <text class="block-title">{{product.typeName}}说明</text>
    <text class="intro-text">{{product.typeTips}}</text>
  </view>
  <view class="card" wx:if="{{product.typeCode === 'VOUCHER' && product.minConsume && product.minConsume !== '0.00' && product.minConsume !== '0'}}">
    <text class="block-title">使用示例</text>
    <view class="nl-line">本券面值 ¥{{product.faceValue}}，最低消费 ¥{{product.minConsume}} 可用</view>
    <view class="nl-sub">买单出示核销码，自动抵扣</view>
  </view>

  <!-- 套餐详情 (GROUPON / COMBO 显示) -->
  <view class="card" wx:if="{{product.typeCode !== 'VOUCHER' && product.subitemGroups && product.subitemGroups.length}}">
    <text class="block-title">套餐详情</text>
    <view class="subitem-block" wx:for="{{product.subitemGroups}}" wx:key="groupId" wx:for-item="g">
      <view class="subitem-group-name">
        <text class="dot">·</text>{{ g.groupName }}
        <text class="subitem-rule" wx:if="{{g.pickText}}">{{ g.pickText }}</text>
      </view>
      <view class="subitem-row" wx:for="{{g.subitems}}" wx:key="subitemId" wx:for-item="s">
        <text class="subitem-name">{{ s.subitemName }}</text>
        <view class="pkg-right">
          <text class="pkg-qty" wx:if="{{s.quantity && s.quantity > 1}}">×{{ s.quantity }}</text>
          <text class="pkg-price">¥{{ s.price }}</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 组合券包（COMBO）的搭配明细：存 biz_product_ext.combo_items_json，
       不走子品表。原先这里读的是 product.packages —— 那个字段全库只有
       utils/mock.js 造过，后端零命中，所以真机上这张卡永远不可能出现：
       顾客买券包看不到里面到底包了哪几张券。 -->
  <view class="card" wx:elif="{{product.comboItems && product.comboItems.length}}">
    <text class="block-title">{{product.typeName}}明细</text>
    <view class="pkg-row" wx:for="{{product.comboItems}}" wx:key="name">
      <view class="pkg-left">
        <text class="pkg-name">{{item.name}}</text>
        <text class="pkg-type" wx:if="{{item.typeText}}">{{item.typeText}}</text>
      </view>
      <view class="pkg-right">
        <text class="pkg-qty" wx:if="{{item.quantity > 1}}">×{{item.quantity}}</text>
        <text class="pkg-price">¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="combo-total" wx:if="{{product.totalValue}}">总价值 ¥{{product.totalValue}}</view>
  </view>


    <!-- 购买须知（V2.6 P2：按商品创建字段结构化渲染，不再依赖 notice 富文本） -->
    <view class="card notice-card">
      <text class="block-title">购买须知</text>

      <!-- 有效期 -->
      <view class="nl-line" wx:if="{{product.validityDays}}">
        <text class="dot">·</text>有效期
      </view>
      <view class="nl-sub" wx:if="{{product.validityDays}}">
        购买后 {{product.validityDays}} 天内有效
      </view>

      <!-- 售卖期 -->
      <view class="nl-line" wx:if="{{product.saleStartDate || product.saleEndDate}}">
        <text class="dot">·</text>售卖期
      </view>
      <view class="nl-sub" wx:if="{{product.saleStartDate || product.saleEndDate}}">
        <text wx:if="{{product.saleStartDate}}">{{product.saleStartText}}</text>
        <text wx:if="{{product.saleStartDate && product.saleEndDate}}"> 至 </text>
        <text wx:if="{{product.saleEndDate}}">{{product.saleEndText}}</text>
      </view>

      <!-- 限购 -->
      <view class="nl-line" wx:if="{{product.limitPerUser || product.maxPerOrder}}">
        <text class="dot">·</text>限购
      </view>
      <view class="nl-sub" wx:if="{{product.limitPerUser || product.maxPerOrder}}">
        <text wx:if="{{product.limitPerUser}}">每人限购 {{product.limitPerUser}} 张</text>
        <text wx:if="{{product.limitPerUser && product.maxPerOrder}}">；</text>
        <text wx:if="{{product.maxPerOrder}}">每单最多 {{product.maxPerOrder}} 张</text>
      </view>

      <!-- 适用人数（GROUPON / BOOKING） -->
      <view class="nl-line" wx:if="{{product.maxPersons && product.maxPersons > 0}}">
        <text class="dot">·</text>适用人数
      </view>
      <view class="nl-sub" wx:if="{{product.maxPersons && product.maxPersons > 0}}">
        {{product.maxPersons}} 人使用
      </view>

      <!-- 库存。走商户级开关：有的商家不愿把余量透给顾客（剩得多会被读成“不好卖”） -->
      <view class="nl-line" wx:if="{{showStock && product.stock > 0}}">
        <text class="dot">·</text>库存
      </view>
      <view class="nl-sub" wx:if="{{showStock && product.stock > 0}}">
        剩余 {{product.stock}} 份
      </view>

      <!-- 退改政策 -->
      <view class="nl-line" wx:if="{{product.refundPolicy}}">
        <text class="dot">·</text>退改政策
      </view>
      <!-- 库里既有枚举码（ANYTIME）也有商家手写的中文。
           直接渲染会让顾客看到「ANYTIME」，normalize 里已把枚举翻成中文。 -->
      <view class="nl-sub" wx:if="{{product.refundPolicy}}">
        {{product.refundPolicyText}}
      </view>

      <!-- 附加费 -->
      <view class="nl-line" wx:if="{{product.extraFeeDesc}}">
        <text class="dot">·</text>附加费
      </view>
      <view class="nl-sub" wx:if="{{product.extraFeeDesc}}">
        {{product.extraFeeDesc}}
      </view>

      <!-- 预约规则（仅 BOOKING 才有） -->
      <view class="nl-line" wx:if="{{product.bookingRequired == 1}}">
        <text class="dot">·</text>预约规则
      </view>
      <view class="nl-sub" wx:if="{{product.bookingRequired == 1}}">
        需提前预约，到店出示预约凭证
      </view>

      <!-- 其他说明 -->
      <view class="nl-line" wx:if="{{product.otherNotice}}">
        <text class="dot">·</text>其他说明
      </view>
      <view class="nl-sub" wx:if="{{product.otherNotice}}">
        {{product.otherNotice}}
      </view>
    </view>

  <!-- 适用门店 -->
  <view class="card">
    <view class="store-head">
      <text class="block-title">适用门店 {{product.storeCountText}}</text>
      <text class="more" wx:if="{{product.storeCount > 1}}">{{product.storeCount}}店通用 ></text>
    </view>
    <view class="store-row">
      <image class="store-img" src="{{product.cover}}" mode="aspectFill"></image>
      <view class="store-info">
        <text class="store-name">{{product.storeNameMain || product.storeName || merchantName}}</text>
        <!-- 评分读 biz_store.rating（后台可维护）。原先五颗星永远是空的、
             旁边永远写着「暂无评分」，就算商家填了 4.8 也不显示。 -->
        <view class="store-rating">
          <text class="rating-score" wx:if="{{product.storeRating}}">{{product.storeRating}}</text>
          <text class="rating-t">{{product.storeRating ? '评分' : '暂无评分'}}</text>
        </view>
        <!-- 营业时间原先兑底写死成「周一至周日 09:00-22:30」，
             商家实际只开到 21:00 也照样显示 22:30，顾客跑空算谁的？没填就不展。 -->
        <text class="store-hours" wx:if="{{product.storeHours}}">营业时间：{{product.storeHours}}</text>
      </view>
      <view class="store-call">
        <view class="call-ic"></view>
        <text>联系商家</text>
      </view>
    </view>
  </view>

  <!-- 更多商品 -->
  <view class="card" wx:if="{{product.moreGoods && product.moreGoods.length}}">
    <view class="store-head">
      <text class="block-title">本店更多商品（3）</text>
      <text class="more">查看更多 ></text>
    </view>
    <scroll-view scroll-x class="more-scroll" enhanced show-scrollbar="{{false}}">
      <view class="more-cell" wx:for="{{product.moreGoods}}" wx:key="productId" data-id="{{item.productId}}" bindtap="goDetail">
        <image class="more-img" src="{{item.cover}}" mode="aspectFill"></image>
        <text class="more-name">{{item.name}}</text>
        <view class="more-prices"><text class="mp-now">¥{{item.price}}</text><text class="mp-old">¥{{item.price}}</text></view>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-pad"></view>

  <!-- 底部操作。预览态换成提示条：商家端跳进来是要看排版，
       「商家/分享/订单」这几个入口在预览里点了会跳出草稿，反而丢数据。 -->
  <view class="bottom-bar preview-bar" wx:if="{{isPreview}}">
    <text class="preview-tip">顾客看到的就是这个页面</text>
    <view class="buy-btn enabled" bindtap="onExitPreview">返回继续编辑</view>
  </view>
  <view class="bottom-bar" wx:else>
    <view class="bb-item" bindtap="goStore">
      <view class="bb-ic ic-shop"></view>
      <text>商家</text>
    </view>
    <view class="bb-item" bindtap="openShare">
      <view class="bb-ic" style="font-size:32rpx;display:flex;align-items:center;justify-content:center;">⇪</view>
      <text>分享</text>
    </view>
    <view class="bb-item" bindtap="goOrderList">
      <view class="bb-ic ic-order"></view>
      <text>订单</text>
    </view>
    <view class="buy-btn {{canBuyNow ? 'enabled' : 'disabled'}}" bindtap="onBuy">{{buyBtnLabel}}</view>
  </view>

  <!-- 分享卡弹窗 -->
  <view class="modal-mask" wx:if="{{showShare}}" catchtap="closeShare">
    <view class="share-box" catchtap="noop">
      <view class="share-close" bindtap="closeShare"></view>
      <view class="share-user">
        <view class="share-avatar"><image src="{{user.avatarUrl || '/assets/avatar/default.png'}}"></image></view>
        <view class="share-meta">
          <text class="share-name">{{user.nickName || '好吃嘴'}}</text>
          <text class="share-sub">给你分享了商品</text>
        </view>
      </view>
      <image class="share-cover" src="{{product.cover}}" mode="aspectFill"></image>
      <text class="share-name2">{{product.name}}</text>
      <view class="share-price">
        <text class="sp-now">¥{{product.price}}</text>
        <text class="sp-old" wx:if="{{showSharePriceOld}}">¥{{product.marketPrice}}</text>
      </view>
      <view class="qr">
        <image class="qr-img" wx:if="{{shareQr}}" src="{{shareQr}}" mode="aspectFit"></image>
        <view class="qr-ph" wx:else><text class="qr-ph-t">{{shareQrTip}}</text></view>
        <text class="qr-tip">扫码或长按小程序码</text>
      </view>
      <view class="share-ops">
        <button class="so" open-type="share" data-id="{{product.productId}}" hover-class="none">
          <view class="so-ic so-friend">💬</view><text class="so-t">发送给朋友</text>
        </button>
        <button class="so" open-type="favorite" hover-class="none" bindtap="onFavTap">
          <view class="so-ic so-fav">★</view><text class="so-t">收藏</text>
        </button>
        <view class="so" bindtap="onSavePoster">
          <view class="so-ic so-save">⤓</view><text class="so-t">保存图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 授权手机号弹窗 -->
  <view class="modal-mask" wx:if="{{showAuthPhone}}" catchtap="closeAuthPhone">
    <view class="auth-box" catchtap="noop">
      <view class="auth-title">授权手机号</view>
      <view class="auth-desc">购买该商品需要您的手机号，请点击下方按钮授权后继续下单。</view>
      <button class="btn-primary btn-full" open-type="getPhoneNumber" bindgetphonenumber="onGotPhone" hover-class="none">授权手机号</button>
      <view class="auth-cancel" bindtap="closeAuthPhone">暂不授权</view>
    </view>
  </view>
</view>

<view class="loading" wx:elif="{{state === 'loading'}}">
  <view class="loading-spin"></view>
  <text class="loading-text">商品加载中…</text>
</view>

<view class="empty error" wx:elif="{{state === 'error'}}">
  <text class="empty-icon">⚠️</text>
  <text class="empty-text">商品加载失败</text>
  <text class="empty-sub">{{errorMsg}}</text>
  <view class="empty-actions">
    <view class="err-btn" bindtap="onBack">返回首页</view>
    <view class="err-btn primary" bindtap="onRetry">重试</view>
  </view>
</view>

<view class="empty" wx:else>
  <text class="empty-icon">🛒</text>
  <text class="empty-text">商品不存在或已下架</text>
  <text class="empty-sub">该商品可能已下架或被删除</text>
  <view class="empty-actions">
    <view class="err-btn primary" bindtap="onBack">返回首页</view>
  </view>
</view>
