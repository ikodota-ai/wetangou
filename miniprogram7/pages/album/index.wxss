.page { min-height: 100vh; background: #FFFFFF; padding: 24rpx 32rpx 40rpx; }
.filter { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tab { padding: 12rpx 32rpx; border-radius: 8rpx; font-size: 26rpx; color: #1A1A1A; background: #FFFFFF; border: 2rpx solid var(--color-primary); }
.tab.on { background: var(--color-primary); color: #FFFFFF; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.cell { width: 100%; aspect-ratio: 1 / 1; }
.cell-img { width: 100%; height: 100%; border-radius: 16rpx; }
