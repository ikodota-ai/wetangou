<view class="page">
  <view class="head">
    <text class="title">会员资料</text>
  </view>
  <view class="list card">
    <view class="row">
      <text class="lab">头像</text>
      <button class="row-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
        <image class="avatar" src="{{user.avatarUrl || '/assets/avatar/default.png'}}"></image>
        <view class="arr"></view>
      </button>
    </view>
    <view class="row">
      <text class="lab">昵称</text>
      <button class="row-btn" hover-class="none">
        <text class="val">{{user.nickName || '请输入'}}</text>
        <view class="arr"></view>
      </button>
    </view>
    <view class="row">
      <text class="lab">手机号</text>
      <button class="row-btn" open-type="getPhoneNumber" bindgetphonenumber="onGotPhone" hover-class="none">
        <text class="val">{{user.phone || '授权手机号'}}</text>
        <view class="arr"></view>
      </button>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="save-btn" bindtap="onSave">保存</view>
  </view>
</view>
