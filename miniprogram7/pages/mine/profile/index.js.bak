const app = getApp();
Page({
  data: { user: { nickName: '', avatarUrl: '', phone: '' } },
  onLoad() { this.setData({ user: app.globalData.user }); },
  onUserUpdate(user) { this.setData({ user }); },
  onChooseAvatar(e) {
    app.globalData.user.avatarUrl = e.detail.avatarUrl;
    this.setData({ user: app.globalData.user });
  },
  onGotPhone(e) {
    if (e.detail.errMsg && e.detail.errMsg.indexOf('ok') !== -1) {
      app.globalData.user.phone = e.detail.phoneNumber || '';
      this.setData({ user: app.globalData.user });
      wx.showToast({ title: '已授权', icon: 'success' });
    }
  },
  onSave() {
    wx.showToast({ title: '已保存', icon: 'success' });
    setTimeout(() => wx.navigateBack(), 500);
  }
});
