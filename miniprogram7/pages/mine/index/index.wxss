.page { min-height: 100vh; background: var(--color-bg); }
.topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 10; }
.header { background: linear-gradient(180deg, #B6D4A6 0%, #DCE9D3 60%, transparent 100%); padding-bottom: 40rpx; }
.banner { width: 100%; height: 300rpx; padding: 24rpx 32rpx 0; box-sizing: border-box; background: linear-gradient(180deg, #3A6B35 0%, #7AAA5A 60%, #F2F2F7 100%); }

.hi-row { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 32rpx 24rpx; }
.hi-text { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.hi-prefix { font-size: 36rpx; font-weight: 700; color: #1A1A1A; line-height: 1.4; }
.hi-name { font-size: 40rpx; font-weight: 700; color: #1A1A1A; line-height: 1.4; }
.avatar { width: 128rpx; height: 128rpx; border-radius: 50%; background: #D9D9D9; overflow: hidden; }
.avatar-img { width: 100%; height: 100%; }

.content { padding: 0 32rpx 40rpx; margin-top: -80rpx; }
.orders { display: flex; padding: 32rpx 0; }
.order-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.o-ic { width: 72rpx; height: 72rpx; border-radius: 50%; background: #F2F2F7; display: flex; align-items: center; justify-content: center; }
.o-t { font-size: 26rpx; color: #1A1A1A; }

.ic { width: 36rpx; height: 36rpx; }
.ic-list { border: 4rpx solid #1A1A1A; border-radius: 6rpx; position: relative; }
.ic-list::before { content: ''; position: absolute; left: 4rpx; top: 8rpx; right: 4rpx; height: 4rpx; background: #1A1A1A; box-shadow: 0 8rpx 0 #1A1A1A, 0 16rpx 0 #1A1A1A; }
.ic-wallet { width: 40rpx; height: 32rpx; border: 4rpx solid #1A1A1A; border-radius: 6rpx; position: relative; }
.ic-wallet::before { content: ''; position: absolute; left: 6rpx; top: 8rpx; right: 6rpx; bottom: 8rpx; border-top: 4rpx solid #1A1A1A; }
.ic-clock { width: 40rpx; height: 40rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; position: relative; }
.ic-clock::before, .ic-clock::after { content: ''; position: absolute; left: 50%; top: 50%; background: #1A1A1A; }
.ic-clock::before { width: 4rpx; height: 14rpx; transform: translate(-50%, -100%); }
.ic-clock::after { width: 12rpx; height: 4rpx; transform: translate(-100%, -2rpx) rotate(45deg); }
.ic-yen { width: 36rpx; height: 36rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; position: relative; }
.ic-yen::before { content: '¥'; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-size: 28rpx; font-weight: 700; color: #1A1A1A; line-height: 1; }

.func { margin-top: 24rpx; padding: 0; }
.func-item { display: flex; align-items: center; gap: 20rpx; height: 100rpx; padding: 0 32rpx; border-bottom: 1rpx solid #F0F0F0; }
.func-item:last-child { border-bottom: none; }
.f-ic { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.f-t { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.arr { width: 16rpx; height: 16rpx; border-right: 3rpx solid #BBB; border-top: 3rpx solid #BBB; transform: rotate(45deg); margin-right: 8rpx; }

/* icon CSS */
.f-promoter { width: 40rpx; height: 40rpx; position: relative; }
.f-promoter::before { content: ''; position: absolute; left: 4rpx; top: 4rpx; width: 32rpx; height: 36rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 6rpx 6rpx; }
.f-p-y { position: absolute; left: 50%; top: 56%; transform: translate(-50%, -50%); font-size: 24rpx; font-weight: 700; color: var(--color-primary); z-index: 1; }

.f-user { width: 40rpx; height: 40rpx; position: relative; }
.f-user::before { content: ''; position: absolute; left: 50%; top: 6rpx; transform: translateX(-50%); width: 16rpx; height: 16rpx; border: 4rpx solid #1A1A1A; border-radius: 50%; }
.f-user::after { content: ''; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 36rpx; height: 18rpx; border: 4rpx solid #1A1A1A; border-bottom: none; border-radius: 18rpx 18rpx 0 0; }
.f-u-h, .f-u-b { display: none; }

.f-cal { width: 40rpx; height: 40rpx; position: relative; }
.f-cal::before { content: ''; position: absolute; left: 0; top: 0; width: 40rpx; height: 40rpx; border: 4rpx solid #1A1A1A; border-radius: 6rpx; }
.f-cal::after { content: ''; position: absolute; left: 8rpx; right: 8rpx; top: 12rpx; bottom: 8rpx; background: linear-gradient(transparent 0 4rpx, #1A1A1A 4rpx 5rpx, transparent 5rpx 10rpx, #1A1A1A 10rpx 11rpx, transparent 11rpx), linear-gradient(90deg, transparent 0 8rpx, #1A1A1A 8rpx 9rpx, transparent 9rpx 19rpx, #1A1A1A 19rpx 20rpx, transparent 20rpx); background-size: 100% 8rpx, 100% 100%; }

.f-doc { width: 36rpx; height: 40rpx; position: relative; }
.f-doc::before { content: ''; position: absolute; left: 0; top: 0; width: 36rpx; height: 40rpx; border: 4rpx solid #1A1A1A; border-radius: 4rpx; }
.f-doc::after { content: ''; position: absolute; left: 8rpx; right: 8rpx; top: 14rpx; bottom: 8rpx; background: linear-gradient(#1A1A1A 0 4rpx, transparent 4rpx 8rpx, #1A1A1A 8rpx 12rpx, transparent 12rpx 16rpx, #1A1A1A 16rpx 20rpx); }

.f-shield { width: 40rpx; height: 40rpx; position: relative; }
.f-shield::before { content: ''; position: absolute; left: 4rpx; top: 0; width: 32rpx; height: 36rpx; border: 4rpx solid #1A1A1A; border-radius: 16rpx 16rpx 6rpx 6rpx; background: #FFFFFF; }
.f-shield::after { content: '✓'; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); color: #1A1A1A; font-size: 24rpx; font-weight: 700; }

.f-cs { width: 40rpx; height: 40rpx; position: relative; }
.f-cs::before { content: ''; position: absolute; left: 4rpx; top: 8rpx; width: 32rpx; height: 28rpx; border: 4rpx solid #1A1A1A; border-radius: 16rpx 16rpx 4rpx 4rpx; }
.f-cs::after { content: ''; position: absolute; left: 18rpx; bottom: 0; width: 4rpx; height: 8rpx; background: #1A1A1A; }

.logout { margin-top: 60rpx; }

.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.tip-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx 0; }
.tip-title { text-align: center; font-size: 34rpx; font-weight: 600; color: #1A1A1A; }
.tip-desc { margin-top: 32rpx; text-align: center; font-size: 28rpx; color: #1A1A1A; line-height: 1.6; }
.tip-row { display: flex; margin-top: 48rpx; border-top: 1rpx solid #F0F0F0; }
.tip-cancel, .tip-confirm { flex: 1; height: 100rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.tip-cancel { color: #1A1A1A; border-right: 1rpx solid #F0F0F0; }
.tip-confirm { color: var(--color-link); }

.sv-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx 40rpx; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.sv-title { font-size: 28rpx; color: var(--color-text-4); }
.sv-phone { display: flex; align-items: center; gap: 16rpx; }
.sv-tel { font-size: 56rpx; font-weight: 700; color: var(--color-primary); }
.sv-ic { width: 48rpx; height: 48rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.sv-ic::after { content: ''; position: absolute; left: 10rpx; bottom: 6rpx; width: 12rpx; height: 12rpx; background: var(--color-primary); border-radius: 50%; }
.sv-qr { width: 100%; height: 320rpx; background: #F7F7F7; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.sv-qr-txt { font-size: 28rpx; color: #999; }
.sv-hours { font-size: 24rpx; color: #666; }
.sv-close { margin-top: 48rpx; width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.16); display: flex; align-items: center; justify-content: center; }
.sv-x { width: 36rpx; height: 36rpx; position: relative; }
.sv-x::before, .sv-x::after { content: ''; position: absolute; left: 50%; top: 50%; width: 40rpx; height: 4rpx; background: #FFFFFF; border-radius: 2rpx; }
.sv-x::before { transform: translate(-50%, -50%) rotate(45deg); }
.sv-x::after { transform: translate(-50%, -50%) rotate(-45deg); }

/* 完善资料弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tip-box {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}
.tip-title {
  padding: 40rpx 32rpx 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.tip-desc {
  display: block;
  padding: 0 40rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}
.tip-row {
  display: flex;
  border-top: 1rpx solid #F0F0F0;
}
.tip-cancel,
.tip-confirm {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.tip-cancel {
  color: #1A1A1A;
  border-right: 1rpx solid #F0F0F0;
}
.tip-confirm {
  color: var(--color-primary);
  font-weight: 600;
}

/* 顶部头像 */
.hi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}
.hi-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}
.hi-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #D9D9D9;
  flex-shrink: 0;
}
.hi-guest {
  color: var(--color-primary);
  font-weight: 600;
}

/* 未登录灰色文字 */
.disabled {
  color: #999;
}

/* 代金券入口图标与客服二维码 */
.f-voucher { background: #FDEDE9; display: flex; align-items: center; justify-content: center; }
.f-v-y { font-size: 28rpx; font-weight: 700; color: var(--color-danger); }
.sv-qr-img { width: 320rpx; height: 320rpx; }

/* 门店核销入口图标 */
.f-staff { width: 40rpx; height: 40rpx; position: relative; }
.f-staff::before { content: ''; position: absolute; left: 6rpx; top: 4rpx; width: 28rpx; height: 28rpx; border: 4rpx solid #1A1A1A; border-radius: 6rpx; }
.f-staff::after { content: ''; position: absolute; left: 16rpx; top: 14rpx; width: 8rpx; height: 8rpx; border: 3rpx solid #1A1A1A; border-radius: 50%; }

/* 员工 / 商家登录入口（弱化） */
.staff-entry {
  text-align: center;
  margin: 32rpx 0 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx dashed #DDD;
}
.staff-entry-text {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 2rpx;
}
.staff-entry:active {
  background: rgba(0,0,0,0.02);
}
/* 可切换商家版时强调显示（有身份可用 → 不再是弱化入口）*/
.staff-entry-primary .staff-entry-text {
  font-size: 28rpx;
  color: #FE2C55;
  font-weight: 600;
}
.staff-entry-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #BBB;
}
