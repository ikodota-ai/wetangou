.page { padding: 24rpx; }
.header { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0; }
.badge { background: #2563eb; color: #fff; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-top: 16rpx; }
.sub { color: #64748b; font-size: 26rpx; margin-top: 8rpx; }
.scope-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin: 24rpx 0; }
.scope-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.scope-tabs { display: flex; gap: 12rpx; }
.scope-tab { padding: 12rpx 24rpx; background: #f1f5f9; border-radius: 8rpx; font-size: 26rpx; }
.scope-tab.on { background: #2563eb; color: #fff; }
.scope-input { display: flex; gap: 12rpx; margin-top: 16rpx; }
.scope-input input { flex: 1; border: 1rpx solid #e2e8f0; border-radius: 8rpx; padding: 8rpx 16rpx; }
.stat-card { background: linear-gradient(135deg, #2563eb, #4f46e5); color: #fff; border-radius: 16rpx; padding: 32rpx; }
.stat-title { font-size: 44rpx; font-weight: 600; }
.stat-sub { font-size: 26rpx; opacity: 0.8; margin-top: 8rpx; }
.tip { color: #94a3b8; font-size: 24rpx; margin-top: 24rpx; line-height: 1.6; }
