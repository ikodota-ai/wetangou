.page { min-height: 100vh; background: #F2F2F7; padding: 32rpx; }
.box { padding: 64rpx 40rpx 48rpx; display: flex; flex-direction: column; align-items: center; gap: 40rpx; }
.title { font-size: 28rpx; color: #999; }
.phone { display: flex; align-items: center; gap: 16rpx; }
.tel { font-size: 56rpx; font-weight: 700; color: var(--color-primary); }
.tel-empty { display: block; padding: 24rpx 0; font-size: 28rpx; color: #999; }
.ic { width: 48rpx; height: 48rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.ic::after { content: ''; position: absolute; left: 10rpx; bottom: 6rpx; width: 12rpx; height: 12rpx; background: var(--color-primary); border-radius: 50%; }
.qr { width: 100%; height: 320rpx; background: #F7F7F7; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }
.qr-t { font-size: 28rpx; color: #999; }
.qr-img { width: 300rpx; height: 300rpx; }
.hours { font-size: 24rpx; color: #666; }
