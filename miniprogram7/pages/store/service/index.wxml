<view class="page">
  <view class="box card">
    <text class="title">客服电话</text>
    <view class="phone" wx:if="{{phone}}" bindtap="callService">
      <text class="tel">{{phone}}</text>
      <view class="ic"></view>
    </view>
    <text class="tel-empty" wx:else>商家暂未配置客服电话</text>
    <view class="qr">
      <image wx:if="{{qrcode}}" class="qr-img" src="{{qrcode}}" mode="aspectFit" bindtap="previewQr"></image>
      <text wx:else class="qr-t">暂未配置客服二维码</text>
    </view>
    <!-- 客服时间取门店 service_hours，没配才退到商家的；原先写死
         「周一至周日10：00-19：00」，后台改了也没用 -->
    <text class="hours" wx:if="{{hours}}">客服工作时间 {{hours}}</text>
    <text class="hours" wx:else>客服工作时间请咨询门店</text>
  </view>
</view>
