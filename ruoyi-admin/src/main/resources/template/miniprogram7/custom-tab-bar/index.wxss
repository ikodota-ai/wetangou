.tab-bar { position: fixed; left: 0; right: 0; bottom: 0; height: 200rpx; background: #FFFFFF; display: flex; padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04); z-index: 99; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.ic { width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.txt { font-size: 22rpx; color: #AAAAAA; }
.tab-item.on .txt { color: #5A8A4A; font-weight: 600; }

/* 图标：纯 CSS 画 */
.ic-home { width: 40rpx; height: 36rpx; border: 4rpx solid #AAAAAA; border-bottom: none; border-radius: 8rpx 8rpx 0 0; position: relative; }
.ic-home::after { content: ''; position: absolute; left: 50%; bottom: -4rpx; transform: translateX(-50%); width: 8rpx; height: 8rpx; background: #AAAAAA; border-radius: 50%; }
.ic-home-on { border-color: #5A8A4A; }
.ic-home-on::after { background: #5A8A4A; }

.ic-image { width: 40rpx; height: 36rpx; border: 4rpx solid #AAAAAA; border-radius: 6rpx; position: relative; }
.ic-image::before, .ic-image::after { content: ''; position: absolute; background: #AAAAAA; border-radius: 50%; }
.ic-image::before { width: 10rpx; height: 10rpx; left: 6rpx; top: 8rpx; }
.ic-image::after { width: 6rpx; height: 6rpx; right: 8rpx; bottom: 6rpx; }
.ic-image-on { border-color: #5A8A4A; }
.ic-image-on::before, .ic-image-on::after { background: #5A8A4A; }

.ic-cal { width: 40rpx; height: 40rpx; border: 4rpx solid #AAAAAA; border-radius: 6rpx; position: relative; padding: 6rpx 0; box-sizing: border-box; }
.ic-cal::before { content: ''; position: absolute; left: 0; right: 0; top: 12rpx; height: 4rpx; background: #AAAAAA; }
.ic-cal::after { content: ''; position: absolute; left: 6rpx; right: 6rpx; bottom: 6rpx; top: 18rpx; background: linear-gradient(transparent 0 4rpx, #AAAAAA 4rpx 5rpx, transparent 5rpx 10rpx, #AAAAAA 10rpx 11rpx, transparent 11rpx), linear-gradient(90deg, transparent 0 11rpx, #AAAAAA 11rpx 12rpx, transparent 12rpx 23rpx, #AAAAAA 23rpx 24rpx, transparent 24rpx); background-size: 100% 8rpx, 100% 100%; }
.ic-cal-on { border-color: #5A8A4A; }
.ic-cal-on::before { background: #5A8A4A; }
.ic-cal-on::after { background: linear-gradient(transparent 0 4rpx, #5A8A4A 4rpx 5rpx, transparent 5rpx 10rpx, #5A8A4A 10rpx 11rpx, transparent 11rpx), linear-gradient(90deg, transparent 0 11rpx, #5A8A4A 11rpx 12rpx, transparent 12rpx 23rpx, #5A8A4A 23rpx 24rpx, transparent 24rpx); background-size: 100% 8rpx, 100% 100%; }

.ic-user { width: 36rpx; height: 36rpx; border: 4rpx solid #AAAAAA; border-radius: 50%; position: relative; }
.ic-user::after { content: ''; position: absolute; left: 50%; bottom: -16rpx; transform: translateX(-50%); width: 30rpx; height: 20rpx; border: 4rpx solid #AAAAAA; border-bottom: none; border-radius: 30rpx 30rpx 0 0; background: #FFFFFF; }
.ic-user-on { border-color: #5A8A4A; }
.ic-user-on::after { border-color: #5A8A4A; }
