/* app.wxss 全局设计令牌与基础样式 */
page {
  --color-primary: #3A6B35;
  --color-primary-dark: #2D6A2D;
  --color-primary-light: #7AAA5A;
  --color-orange: #E8734A;
  --color-bg: #F2F2F7;
  --color-card: #FFFFFF;
  --color-text: #1A1A1A;
  --color-text-2: #666666;
  --color-text-3: #888888;
  --color-text-4: #999999;
  --color-line: #EEEEEE;
  --color-line-2: #F0F0F0;
  --color-danger: #FA5151;
  --color-link: #576B95;
  --color-tag-green-bg: #E8F0E8;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, image, button, input, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

/* 通用容器 */
.container { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }
.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 160rpx; }
.section { margin: 20rpx 16rpx 0; }
.card { background: var(--color-card); border-radius: var(--radius-lg); padding: 24rpx 32rpx; }

/* 通用按钮 */
.btn-primary { display: flex; align-items: center; justify-content: center; height: 88rpx; background: var(--color-primary); color: #FFFFFF; font-size: 30rpx; font-weight: 600; border-radius: 12rpx; }
.btn-primary:active { background: var(--color-primary-dark); }
.btn-ghost { display: flex; align-items: center; justify-content: center; height: 88rpx; background: #FFFFFF; color: var(--color-primary); font-size: 30rpx; font-weight: 600; border-radius: 12rpx; border: 2rpx solid var(--color-primary); }
.btn-ghost:active { background: #F5F8F5; }
.btn-full { width: 100%; }
.btn-disabled { background: #C8D5C8 !important; color: #FFFFFF !important; }

/* 文字 */
.t-h1 { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.t-h2 { font-size: 32rpx; font-weight: 600; color: var(--color-text); }
.t-body { font-size: 28rpx; color: var(--color-text); }
.t-2 { color: var(--color-text-2); font-size: 26rpx; }
.t-3 { color: var(--color-text-3); font-size: 24rpx; }
.t-4 { color: var(--color-text-4); font-size: 22rpx; }
.t-primary { color: var(--color-primary); }
.t-orange { color: var(--color-orange); }
.t-link { color: var(--color-link); }

/* 分割 */
.divider { height: 1rpx; background: var(--color-line); }
.divider-2 { height: 1rpx; background: var(--color-line-2); }

/* 隐藏滚动条 */
::-webkit-scrollbar { width: 0; height: 0; color: transparent; }

/* 通用空态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 200rpx 32rpx; gap: 24rpx; }
.empty-text { color: var(--color-text-4); font-size: 28rpx; }

/* 渐变背景 */
.bg-gradient-green { background: linear-gradient(180deg, #3A6B35 0%, #7AAA5A 100%); }
.bg-gradient-mine { background: linear-gradient(180deg, #B6D4A6 0%, #F2F2F7 100%); }
.bg-gradient-promoter { background: linear-gradient(180deg, #E8F2E8 0%, #F2F2F7 60%); }

/* 安全区 */
.safe-bottom { padding-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
