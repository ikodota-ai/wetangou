.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.head .store-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.store-label {
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}
.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
}
.staff-name {
  font-size: 24rpx;
  color: var(--color-primary, #5A8A4A);
  background: rgba(90, 138, 74, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}
.ipt-row {
  display: flex;
  align-items: center;
  background: #F5F6F5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 88rpx;
}
.ipt-code {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  height: 60rpx;
  letter-spacing: 2rpx;
}
.btn-scan {
  background: var(--color-primary, #5A8A4A);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}
.btn-primary {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  background: var(--color-primary, #5A8A4A);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.btn-primary[disabled] { opacity: 0.5; }
.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.recent-item:last-child { border-bottom: none; }
.ri-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ri-no {
  font-size: 26rpx;
  color: #888;
}
.ri-product {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
}
.ri-time {
  font-size: 22rpx;
  color: #AAA;
}
.ri-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.ri-amount {
  font-size: 30rpx;
  color: #F56C6C;
  font-weight: 600;
}
.ri-tag {
  font-size: 22rpx;
  color: #fff;
  background: #5A8A4A;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.act {
  flex: 1;
  background: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 员工身份徽章 */
.identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.identity-badge {
  display: inline-block;
  background: var(--color-primary, #5A8A4A);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.identity-staff {
  font-size: 24rpx;
  color: #888;
}
