<view class="page">
  <view class="head card">
    <text class="title">今日订单流水</text>
    <text class="sub">共 {{list.length}} 条</text>
  </view>
  <view class="empty" wx:if="{{!list.length && loaded}}">
    <text>今日还没有订单</text>
  </view>
  <view class="list" wx:else>
    <view class="item card" wx:for="{{list}}" wx:key="orderId">
      <view class="row1">
        <text class="no">{{item.orderNo}}</text>
        <text class="amount">¥{{item.payAmount}}</text>
      </view>
      <view class="row2">
        <text class="name">{{item.productName || '团购'}}</text>
        <text class="status s-{{item.status}}">{{statusText(item.status)}}</text>
      </view>
      <view class="row3">
        <text class="code" wx:if="{{item.verifyCode}}">核销码 {{item.verifyCode}}</text>
        <text class="time">{{item.createTimeStr}}</text>
      </view>
      <view class="row4" wx:if="{{item.status === '1'}}">
        <view class="btn-verify" data-code="{{item.verifyCode}}" data-no="{{item.orderNo}}" data-store="{{storeId}}" bindtap="onVerify">核销</view>
      </view>
    </view>
  </view>
</view>
