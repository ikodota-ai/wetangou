<view class="page">
  <view class="head card">
    <view class="store-name">{{storeName || '门店核销'}}</view>
    <view class="head-stat">
      <view class="stat">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-lab">累计核销</text>
      </view>
      <view class="stat">
        <text class="stat-num">¥{{totalAmount}}</text>
        <text class="stat-lab">核销金额</text>
      </view>
      <view class="stat" bindtap="onClear">
        <text class="stat-act">清空记录</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">
    <text>暂无核销记录</text>
  </view>
  <view class="list" wx:else>
    <view class="item card" wx:for="{{list}}" wx:key="orderId">
      <view class="row1">
        <text class="no">{{item.orderNo}}</text>
        <text class="amount">¥{{item.payAmount}}</text>
      </view>
      <view class="row2">
        <text class="name">{{item.productName || '团购券'}}</text>
        <text class="time">{{item.verifyTimeStr}}</text>
      </view>
      <view class="row3">
        <text class="code">核销码 {{item.verifyCode || '-'}}</text>
        <text class="tag">已核销</text>
      </view>
    </view>
  </view>
</view>
