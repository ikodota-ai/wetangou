.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 48rpx; }
.tabs { display: flex; background: #FFFFFF; padding: 0 24rpx; position: sticky; top: 0; z-index: 5; }
.tab { position: relative; padding: 24rpx 32rpx; margin-right: 16rpx; }
.tab text { font-size: 28rpx; color: #1A1A1A; }
.tab.on text { font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 4rpx; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }

.sub-tabs { display: flex; gap: 16rpx; padding: 24rpx 32rpx 0; }
.sub-tab { padding: 12rpx 28rpx; background: #FFFFFF; border-radius: 999rpx; }
.sub-tab text { font-size: 26rpx; color: #666; }
.sub-tab.on { background: var(--color-primary); }
.sub-tab.on text { color: #FFFFFF; }

.v-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.v-card { display: flex; align-items: center; background: #FFFFFF; border-radius: 20rpx; padding: 32rpx 24rpx; }
.v-card.used { opacity: 0.55; }
.v-left { width: 200rpx; display: flex; align-items: baseline; justify-content: center; color: var(--color-danger); }
.v-cur { font-size: 26rpx; font-weight: 600; }
.v-val { font-size: 56rpx; font-weight: 700; }
.v-mid { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; border-left: 1rpx dashed #E5E5E5; padding-left: 24rpx; }
.v-name { font-size: 28rpx; font-weight: 600; color: #1A1A1A; }
.v-rule { font-size: 22rpx; color: #999; }
.v-right { padding-left: 16rpx; }
.v-btn { padding: 14rpx 28rpx; background: var(--color-primary); color: #FFFFFF; border-radius: 999rpx; font-size: 26rpx; }
.v-btn.off { background: #DDDDDD; color: #FFFFFF; }
.v-done { font-size: 26rpx; color: #999; }

.empty { padding: 180rpx 0; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.go-btn { padding: 16rpx 64rpx; border: 2rpx solid var(--color-primary); border-radius: 999rpx; color: var(--color-primary); font-size: 28rpx; }
