<!-- pages/promoter/poster/index.wxml 推客邀请海报 -->
<view class="page">
  <view class="poster">
    <view class="poster-top">
      <text class="brand">{{user.nickName || '我'}} 邀请你</text>
      <text class="tagline">扫码加入，一起省钱 / 赚钱</text>
    </view>

    <view class="qrbox">
      <block wx:if="{{qrcode}}">
        <image class="qr" src="{{qrcode}}" mode="aspectFit" bindtap="onPreview"></image>
      </block>
      <block wx:else>
        <view class="qr-placeholder">海报生成中…</view>
      </block>
    </view>

    <view class="hint">
      <text>长按或点击二维码可预览大图</text>
      <text class="scene" wx:if="{{scene}}">scene: {{scene}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" bindtap="onSave" loading="{{saving}}">保存到相册</button>
    <button class="btn-secondary" open-type="share">分享给好友</button>
  </view>
</view>
