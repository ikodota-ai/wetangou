.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx; }
.card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; }
.block-title { display: block; font-size: 32rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 32rpx; }
.data-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 32rpx 16rpx; }
.d-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.d-num { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.d-lab { font-size: 24rpx; color: #1A1A1A; }
.tabs { display: flex; background: #FFFFFF; padding: 0 24rpx; border-radius: 0 0 20rpx 20rpx; margin-bottom: 24rpx; }
.tab { position: relative; padding: 24rpx 16rpx; margin-right: 8rpx; }
.tab text { font-size: 28rpx; color: #1A1A1A; }
.tab.on text { font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 4rpx; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }
.empty { padding: 200rpx 0; text-align: center; }
.empty-text { color: var(--color-text-4); font-size: 28rpx; }

/* 提现记录明细卡片 */
.rec-list { padding: 0 32rpx; }
.rec-item { margin-bottom: 24rpx; }
.r-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.r-amount { font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.r-status { font-size: 26rpx; font-weight: 600; color: var(--color-primary); }
.r-status.s-2 { color: var(--color-danger); }
.r-status.s-0 { color: #E6A23C; }
.r-row { display: flex; justify-content: space-between; padding: 6rpx 0; }
.r-lab { font-size: 24rpx; color: #999; }
.r-val { font-size: 24rpx; color: #1A1A1A; max-width: 62%; text-align: right; }
.r-val.warn { color: var(--color-danger); }
