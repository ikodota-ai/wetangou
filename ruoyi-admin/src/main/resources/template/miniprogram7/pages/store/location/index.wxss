.page { min-height: 100vh; background: #F2F2F7; position: relative; }
.map { width: 100%; height: 70vh; }
.info { position: fixed; left: 0; right: 0; bottom: 0; border-radius: 24rpx 24rpx 0 0; padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.i-name { display: block; font-size: 36rpx; font-weight: 700; color: #1A1A1A; }
.i-addr { display: block; font-size: 26rpx; color: #1A1A1A; margin-top: 12rpx; }
.i-row { display: flex; align-items: center; gap: 24rpx; margin-top: 16rpx; }
.i-dist { font-size: 26rpx; color: #1A1A1A; }
.i-drive { display: flex; align-items: center; gap: 8rpx; padding: 4rpx 12rpx; background: #F2F2F7; border-radius: 6rpx; }
.drive-ic { width: 24rpx; height: 24rpx; background: #1A1A1A; clip-path: polygon(20% 0%, 80% 0%, 80% 30%, 100% 50%, 80% 70%, 80% 100%, 20% 100%, 20% 70%, 0 50%, 20% 30%); }
.i-time { font-size: 24rpx; color: #1A1A1A; }
.i-more { font-size: 26rpx; color: var(--color-link); margin-left: auto; }
.ops { display: flex; gap: 16rpx; margin-top: 24rpx; }
.op { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 20rpx 0; background: #F7F7F7; border-radius: 12rpx; }
.op-ic { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.op text { font-size: 24rpx; color: #1A1A1A; }
.ic-nav { width: 32rpx; height: 32rpx; background: var(--color-primary); clip-path: polygon(50% 0%, 100% 100%, 70% 100%, 70% 75%, 30% 75%, 30% 100%, 0 100%); }
.ic-taxi { width: 36rpx; height: 20rpx; background: var(--color-primary); border-radius: 4rpx 12rpx 4rpx 4rpx; position: relative; }
.ic-taxi::before, .ic-taxi::after { content: ''; position: absolute; bottom: -6rpx; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--color-primary); }
.ic-taxi::before { left: 4rpx; }
.ic-taxi::after { right: 4rpx; }
.ic-fav { width: 30rpx; height: 30rpx; background: var(--color-primary); clip-path: polygon(50% 100%, 0 50%, 25% 25%, 50% 50%, 75% 25%, 100% 50%); }
.ic-more { width: 32rpx; height: 8rpx; background: var(--color-primary); border-radius: 4rpx; box-shadow: 0 -10rpx 0 var(--color-primary), 0 10rpx 0 var(--color-primary); }
