.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 140rpx; }
.hero { position: relative; width: 100%; height: 750rpx; }
.hero-img { width: 100%; height: 100%; }
.hero-page { position: absolute; right: 24rpx; bottom: 32rpx; padding: 8rpx 20rpx; background: rgba(0,0,0,0.4); color: #FFFFFF; border-radius: 20rpx; font-size: 24rpx; }

.price-bar { display: flex; align-items: center; gap: 16rpx; padding: 32rpx 32rpx; background: linear-gradient(90deg, #3A6B35 0%, #5A8A4A 100%); color: #FFFFFF; }
.price-l { display: flex; align-items: baseline; gap: 12rpx; }
.now { font-size: 48rpx; font-weight: 700; color: #FFFFFF; }
.old { font-size: 24rpx; color: rgba(255,255,255,0.7); text-decoration: line-through; }
.price-tag { margin-left: 16rpx; padding: 4rpx 12rpx; background: #FFFFFF; color: #3A6B35; font-size: 22rpx; border-radius: 6rpx; max-width: 130rpx; line-height: 1.3; }
.price-sold { margin-left: auto; font-size: 26rpx; color: rgba(255,255,255,0.9); }

.info { margin: 0 32rpx; }
.info-name { font-size: 32rpx; font-weight: 600; color: #1A1A1A; line-height: 1.4; display: block; margin-bottom: 24rpx; }
.info-row { display: flex; gap: 24rpx; padding: 8rpx 0; }
.lab { font-size: 26rpx; color: #999; width: 80rpx; }
.val { font-size: 26rpx; color: #1A1A1A; flex: 1; }

.card { background: #FFFFFF; border-radius: 20rpx; padding: 32rpx; margin: 24rpx 32rpx; }
.block-title { font-size: 32rpx; font-weight: 600; color: #1A1A1A; display: block; margin-bottom: 16rpx; }
.pkg-line { display: flex; gap: 8rpx; font-size: 28rpx; color: #1A1A1A; margin-bottom: 16rpx; }
.pkg-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.pkg-name { font-size: 28rpx; color: #1A1A1A; }
.pkg-right { display: flex; align-items: center; gap: 32rpx; }
.pkg-qty { font-size: 26rpx; color: #999; }
.pkg-price { font-size: 28rpx; color: #1A1A1A; }

.nl-line { font-size: 28rpx; color: #1A1A1A; padding: 12rpx 0 4rpx; }
.nl-sub { font-size: 26rpx; color: #999; padding-left: 24rpx; padding-bottom: 8rpx; }
.dot { display: inline-block; width: 16rpx; color: #1A1A1A; }

.store-head { display: flex; justify-content: space-between; align-items: center; }
.more { font-size: 24rpx; color: #999; }
.store-row { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.store-img { width: 128rpx; height: 128rpx; border-radius: 16rpx; flex-shrink: 0; }
.store-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.store-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.store-rating { display: flex; align-items: center; gap: 4rpx; }
.star { width: 24rpx; height: 24rpx; background: #E8E8E8; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.rating-t { font-size: 22rpx; color: var(--color-primary); margin-left: 4rpx; }
.store-hours { font-size: 24rpx; color: #999; }
.store-call { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.call-ic { width: 40rpx; height: 40rpx; border: 4rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.call-ic::after { content: ''; position: absolute; left: 8rpx; bottom: 4rpx; width: 8rpx; height: 8rpx; background: var(--color-primary); border-radius: 50%; }
.store-call text { font-size: 22rpx; color: #999; }

.more-scroll { white-space: nowrap; margin-top: 16rpx; }
.more-cell { display: inline-block; width: 220rpx; margin-right: 16rpx; vertical-align: top; }
.more-img { width: 220rpx; height: 220rpx; border-radius: 16rpx; }
.more-name { display: block; font-size: 26rpx; color: #1A1A1A; line-height: 1.3; margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.more-prices { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.mp-now { font-size: 28rpx; font-weight: 700; color: var(--color-primary); }
.mp-old { font-size: 22rpx; color: #999; text-decoration: line-through; }

.bottom-pad { height: 40rpx; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #FFFFFF; border-top: 1rpx solid #F0F0F0; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 50; }
.bb-item { display: flex; flex-direction: column; align-items: center; gap: 2rpx; width: 100rpx; }
.bb-ic { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.bb-item text { font-size: 22rpx; color: #666; }
.ic-shop { width: 36rpx; height: 32rpx; border: 4rpx solid #1A1A1A; border-radius: 4rpx 4rpx 12rpx 12rpx; position: relative; }
.ic-shop::before { content: ''; position: absolute; left: 6rpx; top: 6rpx; right: 6rpx; height: 6rpx; border-bottom: 4rpx solid #1A1A1A; }
.ic-share { width: 36rpx; height: 36rpx; position: relative; }
.ic-share::before { content: ''; position: absolute; left: 16rpx; top: 0; width: 4rpx; height: 14rpx; background: #1A1A1A; transform: rotate(45deg); }
.ic-share::after { content: ''; position: absolute; left: 16rpx; top: 0; width: 4rpx; height: 14rpx; background: #1A1A1A; transform: rotate(-45deg); }
.ic-order { width: 36rpx; height: 30rpx; border: 4rpx solid #1A1A1A; border-radius: 4rpx; position: relative; }
.ic-order::before { content: ''; position: absolute; left: 4rpx; top: 8rpx; right: 4rpx; height: 4rpx; background: #1A1A1A; box-shadow: 0 8rpx 0 #1A1A1A; }
.buy-btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; background: var(--color-primary); color: #FFFFFF; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; }

/* 分享卡 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: center; justify-content: center; }
.share-box { position: relative; width: 580rpx; background: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx; }
.share-close { position: absolute; right: 24rpx; top: 24rpx; width: 40rpx; height: 40rpx; }
.share-close::before, .share-close::after { content: ''; position: absolute; left: 50%; top: 50%; width: 32rpx; height: 4rpx; background: #999; border-radius: 2rpx; }
.share-close::before { transform: translate(-50%, -50%) rotate(45deg); }
.share-close::after { transform: translate(-50%, -50%) rotate(-45deg); }
.share-user { display: flex; align-items: center; gap: 16rpx; }
.share-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #F2F2F7; overflow: hidden; }
.share-avatar image { width: 100%; height: 100%; }
.share-meta { display: flex; flex-direction: column; gap: 4rpx; }
.share-name { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.share-sub { font-size: 24rpx; color: #999; }
.share-cover { width: 100%; height: 480rpx; border-radius: 16rpx; margin-top: 24rpx; }
.share-name2 { display: block; margin-top: 24rpx; font-size: 28rpx; font-weight: 600; color: #1A1A1A; line-height: 1.4; }
.share-price { display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx; }
.sp-now { font-size: 36rpx; font-weight: 700; color: var(--color-orange); }
.sp-old { font-size: 24rpx; color: #999; text-decoration: line-through; }
.qr { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-top: 24rpx; }
.qr-circle { width: 200rpx; height: 200rpx; border-radius: 50%; background: radial-gradient(#000 0 30%, transparent 30% 60%, #000 60% 80%, transparent 80%), conic-gradient(#000 0 30deg, transparent 30deg 60deg, #000 60deg 90deg, transparent 90deg 120deg, #000 120deg 150deg, transparent 150deg 180deg, #000 180deg 210deg, transparent 210deg 240deg, #000 240deg 270deg, transparent 270deg 300deg, #000 300deg 330deg, transparent 330deg 360deg); position: relative; }
.qr-circle::after { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--color-primary); }
.qr-tip { font-size: 24rpx; color: #999; }
.share-ops { display: flex; justify-content: space-around; margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid #F0F0F0; }
.so { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.so-ic { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--color-primary); }
.so-friend { background: #2D6A2D; }
.so-fav { background: #9B59B6; }
.so-save { background: #3498DB; }
.so text { font-size: 22rpx; color: #666; }

/* 授权 */
.auth-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 56rpx 40rpx 40rpx; }
.auth-title { text-align: center; font-size: 36rpx; font-weight: 600; color: #1A1A1A; }
.auth-desc { text-align: center; font-size: 28rpx; color: #1A1A1A; line-height: 1.6; margin: 32rpx 0 40rpx; }
.auth-cancel { text-align: center; font-size: 28rpx; color: #999; margin-top: 32rpx; }

/* 错误 */
.err-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 56rpx 40rpx 0; }
.err-title { text-align: center; font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.err-desc { text-align: center; font-size: 28rpx; color: #1A1A1A; margin: 32rpx 0 40rpx; }
.err-row { display: flex; border-top: 1rpx solid #F0F0F0; }
.err-btn { flex: 1; height: 100rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.err-btn.primary { color: var(--color-link); border-left: 1rpx solid #F0F0F0; }

/* 加载中 */
.loading { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 80rpx 32rpx; gap: 24rpx; background: var(--color-bg); }
.loading-spin { width: 64rpx; height: 64rpx; border: 6rpx solid #E8E8E8; border-top-color: var(--color-primary); border-radius: 50%; animation: spin 0.9s linear infinite; }
.loading-text { font-size: 28rpx; color: #999; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 错误/空态 */
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 80rpx 48rpx; gap: 16rpx; background: var(--color-bg); }
.empty.error { background: #FFF8E1; }
.empty-icon { font-size: 96rpx; line-height: 1; margin-bottom: 8rpx; }
.empty-text { font-size: 32rpx; color: #1A1A1A; font-weight: 600; margin-top: 8rpx; }
.empty-sub { font-size: 26rpx; color: #999; line-height: 1.5; text-align: center; max-width: 520rpx; word-break: break-all; }
.empty-actions { display: flex; gap: 24rpx; margin-top: 32rpx; }
.empty-actions .err-btn { width: 200rpx; height: 80rpx; background: #FFFFFF; border: 2rpx solid #E0E0E0; border-radius: 12rpx; font-size: 28rpx; color: #1A1A1A; }
.empty-actions .err-btn.primary { background: var(--color-primary); border-color: var(--color-primary); color: #FFFFFF; }
