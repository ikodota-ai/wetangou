.page { min-height: 100vh; background: #F2F2F7; padding-bottom: 200rpx; }
.head { padding: 32rpx; background: linear-gradient(180deg, #B6D4A6 0%, #F2F2F7 100%); }
.title { display: block; text-align: center; font-size: 34rpx; font-weight: 600; color: #1A1A1A; }
.list { background: #FFFFFF; border-radius: 0; margin-top: 24rpx; padding: 0 32rpx; }
.row { display: flex; align-items: center; padding: 32rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.row:last-child { border-bottom: none; }
.lab { width: 160rpx; font-size: 30rpx; color: #1A1A1A; }
.row-btn { flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding: 0; background: transparent; }
.row-btn::after { border: none; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 16rpx; background: #F2F2F7; }
.val { font-size: 30rpx; color: #1A1A1A; }
.val.placeholder { color: #999; }
.arr { width: 16rpx; height: 16rpx; border-right: 3rpx solid #BBB; border-top: 3rpx solid #BBB; transform: rotate(45deg); margin-left: 4rpx; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx; background: #FFFFFF; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.save-btn { width: 100%; height: 96rpx; line-height: 96rpx; text-align: center; background: var(--color-primary); color: #FFFFFF; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; }
