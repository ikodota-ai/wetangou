<view class="page">
  <view class="topbar" style="height: {{statusBarHeight + 44}}px; padding-top: {{statusBarHeight}}px;"></view>
  <view class="header" style="padding-top: {{statusBarHeight + 44}}px;">
    <view class="hi-row">
      <view class="hi-text">
        <text class="hi-prefix">Hi,</text>
        <text class="hi-name" wx:if="{{logged}}" bindtap="goProfile">{{user.nickName || '好吃嘴'}}</text>
        <text class="hi-name" wx:else bindtap="goLogin">点击注册/登录 ></text>
      </view>
      <view class="avatar" bindtap="{{logged ? 'goProfile' : 'goLogin'}}">
        <image class="avatar-img" src="{{user.avatarUrl || '/assets/avatar/default.png'}}"></image>
      </view>
    </view>
  </view>
  <view class="content">
    <!-- 订单四宫格 -->
    <view class="orders card">
      <view class="order-item" bindtap="goOrder" data-t="all">
        <view class="o-ic"><view class="ic ic-list"></view></view>
        <text class="o-t">全部订单</text>
      </view>
      <view class="order-item" bindtap="goOrder" data-t="pending">
        <view class="o-ic"><view class="ic ic-wallet"></view></view>
        <text class="o-t">待支付</text>
      </view>
      <view class="order-item" bindtap="goOrder" data-t="unused">
        <view class="o-ic"><view class="ic ic-clock"></view></view>
        <text class="o-t">待使用</text>
      </view>
      <view class="order-item" bindtap="goOrder" data-t="refund">
        <view class="o-ic"><view class="ic ic-yen"></view></view>
        <text class="o-t">退款/售后</text>
      </view>
    </view>

    <view class="func card">
      <view class="func-item" wx:if="{{logged}}" bindtap="goPromoter">
        <view class="f-ic f-promoter">
          <view class="f-p-1"></view>
          <text class="f-p-y">¥</text>
        </view>
        <text class="f-t">推客中心</text>
        <view class="arr"></view>
      </view>
      <view class="func-item" wx:if="{{logged}}" bindtap="goProfile">
        <view class="f-ic f-user">
          <view class="f-u-h"></view>
          <view class="f-u-b"></view>
        </view>
        <text class="f-t">会员资料</text>
        <view class="arr"></view>
      </view>
      <view class="func-item" bindtap="goBookingList">
        <view class="f-ic f-cal">
          <view class="f-c-t"></view>
          <view class="f-c-b"></view>
        </view>
        <text class="f-t">我的预约</text>
        <view class="arr"></view>
      </view>
      <view class="func-item" bindtap="goAgreement" data-t="user">
        <view class="f-ic f-doc">
          <view class="f-d-l"></view>
          <view class="f-d-r"></view>
        </view>
        <text class="f-t">用户协议</text>
        <view class="arr"></view>
      </view>
      <view class="func-item" bindtap="goAgreement" data-t="privacy">
        <view class="f-ic f-shield">
          <view class="f-s-c"></view>
        </view>
        <text class="f-t">隐私协议</text>
        <view class="arr"></view>
      </view>
      <view class="func-item" bindtap="callService">
        <view class="f-ic f-cs">
          <view class="f-h-l"></view>
          <view class="f-h-r"></view>
          <view class="f-h-m"></view>
        </view>
        <text class="f-t">联系客服</text>
        <view class="arr"></view>
      </view>
    </view>

    <view class="logout btn-ghost" wx:if="{{logged}}" bindtap="onLogout">退出登录</view>
  </view>

  <!-- 完善会员资料弹窗 -->
  <view class="modal-mask" wx:if="{{showProfileTip}}" catchtap="closeProfileTip">
    <view class="tip-box" catchtap="noop">
      <view class="tip-title">完善会员资料</view>
      <view class="tip-desc">授权微信头像和昵称后，个人中心会展示更完整的会员资料。</view>
      <view class="tip-row">
        <view class="tip-cancel" bindtap="closeProfileTip">暂不授权</view>
        <view class="tip-confirm" bindtap="goProfile">去授权</view>
      </view>
    </view>
  </view>

  <!-- 客服弹窗 -->
  <view class="modal-mask" wx:if="{{showService}}" catchtap="closeService">
    <view class="sv-box" catchtap="noop">
      <text class="sv-title">客服电话</text>
      <view class="sv-phone" catchtap="callPhone">
        <text class="sv-tel">13434123069</text>
        <view class="sv-ic"></view>
      </view>
      <view class="sv-qr">
        <text class="sv-qr-txt">暂未配置客服二维码</text>
      </view>
      <text class="sv-hours">客服工作时间周一至周日10：00-19：00</text>
    </view>
    <view class="sv-close" catchtap="closeService">
      <view class="sv-x"></view>
    </view>
  </view>
</view>
