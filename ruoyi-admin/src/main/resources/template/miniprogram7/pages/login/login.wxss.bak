.page { min-height: 100vh; background: linear-gradient(180deg, #3A6B35 0%, #7AAA5A 35%, #B6D4A6 55%, #F2F2F7 100%); padding-bottom: 40rpx; }
.top { height: 60rpx; }
.title { font-size: 56rpx; font-weight: 700; color: #1A1A1A; padding: 20rpx 56rpx 56rpx; }
.card { margin: 0 32rpx 40rpx; background: #FFFFFF; border-radius: 24rpx; padding: 40rpx 32rpx 32rpx; }
.brand { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
.divider { height: 1rpx; background: #F0F0F0; margin: 32rpx 0; }
.perm-title { font-size: 28rpx; color: #1A1A1A; margin-bottom: 16rpx; }
.perm-main { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }

.btns { padding: 0 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.agree { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; padding: 60rpx 32rpx 0; gap: 8rpx; }
.checkbox { width: 28rpx; height: 28rpx; border: 2rpx solid #C8D5C8; border-radius: 4rpx; background: #FFFFFF; }
.checkbox.on { background: var(--color-primary); border-color: var(--color-primary); }
.checkbox.on::after { content: ''; display: block; width: 14rpx; height: 8rpx; border-left: 3rpx solid #FFFFFF; border-bottom: 3rpx solid #FFFFFF; transform: rotate(-45deg) translate(2rpx, -2rpx); }
.agree-text { font-size: 24rpx; color: #666; }
.link { font-size: 24rpx; color: #576B95; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-box { width: 620rpx; background: #FFFFFF; border-radius: 24rpx; padding: 48rpx 40rpx 40rpx; }
.m-title { text-align: center; font-size: 32rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 32rpx; }
.avatar-btn { background: transparent; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin: 0 auto 32rpx; }
.avatar-btn::after { border: none; }
.avatar { width: 160rpx; height: 160rpx; border-radius: 50%; background: #F2F2F7; }
.avatar-tip { font-size: 24rpx; color: #999; }
.m-input { margin-bottom: 32rpx; }
.nick-input { width: 100%; height: 88rpx; background: #F5F5F5; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; }
.m-cancel { text-align: center; font-size: 28rpx; color: #999; margin-top: 24rpx; }
