const app = getApp();
Page({
  data: {
    agreed: false,
    showAvatar: false,
    avatarUrl: '',
    nickName: ''
  },
  onLoad() { this.syncFromGlobal(); },
  onShow() { this.syncFromGlobal(); },
  syncFromGlobal() {
    this.setData({
      avatarUrl: app.globalData.user.avatarUrl || '',
      nickName: app.globalData.user.nickName || ''
    });
  },
  toggleAgree() { this.setData({ agreed: !this.data.agreed }); },
  goAgreement(e) {
    const t = e.currentTarget.dataset.type;
    const url = t === 'user' ? '/pages/agreement/user/index' : '/pages/agreement/privacy/index';
    wx.navigateTo({ url });
  },
  onLogin() {
    if (!this.data.agreed) {
      wx.showToast({ title: '请先阅读并勾选协议', icon: 'none' });
      return;
    }
    this.setData({ showAvatar: true });
  },
  onSkip() {
    wx.switchTab({ url: '/pages/home/index' });
  },
  closeAvatar() { this.setData({ showAvatar: false }); },
  noop() {},
  onChooseAvatar(e) {
    this.setData({ avatarUrl: e.detail.avatarUrl });
  },
  onNickInput(e) { this.setData({ nickName: e.detail.value }); },
  onNickBlur(e) { this.setData({ nickName: e.detail.value }); },
  confirmProfile() {
    if (!this.data.avatarUrl) {
      wx.showToast({ title: '请先选择头像', icon: 'none' });
      return;
    }
    if (!this.data.nickName) {
      wx.showToast({ title: '请输入昵称', icon: 'none' });
      return;
    }
    app.wxLogin({ nickName: this.data.nickName, avatarUrl: this.data.avatarUrl }, (err) => {
      if (!err) {
        wx.showToast({ title: '登录成功', icon: 'success' });
        setTimeout(() => {
          wx.switchTab({ url: '/pages/home/index' });
        }, 600);
      }
    });
    this.setData({ showAvatar: false });
  }
});
