<view class="page">
  <view class="tabs">
    <view class="tab {{tab==='all'?'on':''}}" data-t="all" bindtap="switchTab"><text>全部</text><view class="tab-bar"></view></view>
    <view class="tab {{tab==='wait'?'on':''}}" data-t="wait" bindtap="switchTab"><text>待确认</text><view class="tab-bar"></view></view>
    <view class="tab {{tab==='done'?'on':''}}" data-t="done" bindtap="switchTab"><text>已完成</text><view class="tab-bar"></view></view>
    <view class="tab {{tab==='cancel'?'on':''}}" data-t="cancel" bindtap="switchTab"><text>已取消</text><view class="tab-bar"></view></view>
  </view>

  <view class="content" wx:if="{{shown.length}}">
    <view class="card item" wx:for="{{shown}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image class="i-img" src="/assets/img/BookTypeImg.jpg" mode="aspectFill"></image>
      <view class="i-info">
        <view class="i-top">
          <text class="i-ttl">{{item.title}}</text>
          <text class="i-status">{{item.statusText}}</text>
        </view>
        <text class="i-time">预约时间 {{item.time}}</text>
        <text class="i-time">{{item.storeName}} · {{item.people}}人</text>
        <view class="i-bot">
          <text class="i-addr">{{item.address}}</text>
          <view class="i-ops">
            <view class="op-ic" data-id="{{item.id}}" catchtap="goLocation"><view class="ic-loc"></view></view>
            <view class="op-ic" data-id="{{item.id}}" catchtap="callService"><view class="ic-tel"></view></view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty" wx:elif="{{loading}}">
    <text class="empty-tip">加载中…</text>
  </view>
  <view class="empty" wx:else>
    <text class="empty-tip">{{list.length ? '该分类下暂无预约' : '还没有预约记录'}}</text>
    <view class="go-create" bindtap="goCreate">去预约 ></view>
  </view>
</view>
