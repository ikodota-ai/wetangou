.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 200rpx; }
.tabs { display: flex; background: #FFFFFF; padding: 0 24rpx; position: sticky; top: 0; z-index: 5; }
.tab { position: relative; padding: 24rpx 32rpx; margin-right: 16rpx; }
.tab text { font-size: 28rpx; color: #1A1A1A; }
.tab.on text { font-weight: 600; }
.tab-bar { position: absolute; left: 50%; bottom: 4rpx; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: transparent; }
.tab.on .tab-bar { background: var(--color-primary); }

.content { padding: 24rpx 32rpx; }
.item { display: flex; gap: 24rpx; padding: 24rpx; margin-bottom: 24rpx; }
.i-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; flex-shrink: 0; }
.i-info { flex: 1; display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.i-top { display: flex; justify-content: space-between; align-items: center; }
.i-ttl { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.i-status { font-size: 26rpx; color: var(--color-primary); font-weight: 600; }
.i-time { font-size: 24rpx; color: #999; }
.i-bot { display: flex; justify-content: space-between; align-items: center; }
.i-addr { font-size: 24rpx; color: #999; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.i-ops { display: flex; gap: 12rpx; }
.op-ic { width: 56rpx; height: 56rpx; border-radius: 50%; background: #F2F2F7; display: flex; align-items: center; justify-content: center; }
.ic-loc { width: 24rpx; height: 24rpx; background: var(--color-primary); clip-path: polygon(50% 0%, 100% 100%, 70% 100%, 70% 75%, 30% 75%, 30% 100%, 0 100%); }
.ic-tel { width: 24rpx; height: 24rpx; border: 3rpx solid var(--color-primary); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); position: relative; }
.ic-tel::after { content: ''; position: absolute; left: 4rpx; bottom: 2rpx; width: 6rpx; height: 6rpx; background: var(--color-primary); border-radius: 50%; }

.empty { padding: 200rpx 0 0; display: flex; justify-content: center; }
.go-create { padding: 20rpx 80rpx; border: 2rpx solid var(--color-primary); border-radius: 999rpx; color: var(--color-primary); font-size: 30rpx; }

/* 空态与操作按钮内嵌图标 */
.empty { padding: 200rpx 0 0; display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.empty-tip { font-size: 28rpx; color: #999; }
